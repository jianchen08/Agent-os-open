# API 端点配置示例
# 复制此文件为 api.yaml 并填入实际配置

# API 端点配置
endpoints:
  # 本地开发
  local:
    base_url: http://localhost:8000
    version: v1
    timeout: 30
    
  # 生产环境
  production:
    base_url: https://api.example.com
    version: v1
    timeout: 60
    
  # 外部服务
  external:
    base_url: https://external-api.example.com
    version: v1
    timeout: 30
    auth:
      type: bearer
      token: ${EXTERNAL_API_TOKEN}

# 默认端点
defaults:
  endpoint: local

# 限流配置
rate_limits:
  # 格式: 次数/时间单位 (second, minute, hour)
  global: 60/minute
  auth: 10/minute
  tasks: 30/minute
  websocket: 5/minute

# CORS 配置
cors:
  allowed_origins:
    - http://localhost:3000
    - http://localhost:5173
    - https://app.example.com
  allow_credentials: true
  allowed_methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allowed_headers:
    - "*"
