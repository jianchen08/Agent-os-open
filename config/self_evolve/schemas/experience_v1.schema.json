{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agentos.experience.v1",
  "title": "AgentOS 经验轨迹 episode",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "source",
    "task",
    "outcome",
    "review",
    "steps",
    "returns",
    "provenance"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "agentos.experience.v1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "task_id", "pipeline_id", "suite_id", "split"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "task_run" },
        "task_id": { "type": "string", "minLength": 1 },
        "pipeline_id": { "type": "string", "minLength": 1 },
        "agent_config_id": { "type": "string" },
        "model": { "type": "string" },
        "suite_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": ["string", "null"] },
        "split": { "enum": ["train", "heldout", "ood"] }
      }
    },
    "task": {
      "type": "object",
      "required": ["goal", "acceptance_criteria"],
      "additionalProperties": true,
      "properties": {
        "goal": { "type": "string", "maxLength": 2000 },
        "acceptance_criteria": { "type": "object" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["success", "terminal_reward"],
      "additionalProperties": true,
      "properties": {
        "success": { "type": "boolean" },
        "score": { "type": ["number", "null"] },
        "task_status": { "type": "string" },
        "eval_ids": { "type": "array", "items": { "type": "string" } },
        "terminal_reward": { "type": "number" }
      }
    },
    "review": {
      "type": "object",
      "required": ["review_id", "status", "credit_policy", "lessons_count"],
      "additionalProperties": true,
      "properties": {
        "review_id": { "type": ["string", "null"] },
        "report_ref": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "overall_status": { "type": ["string", "null"] },
        "credit_policy": { "type": "string" },
        "lessons_count": { "type": "integer", "minimum": 0 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "state", "action", "observation", "credit"],
        "additionalProperties": true,
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "trace_seq": { "type": ["integer", "null"] },
          "call_index": { "type": "integer", "minimum": 0 },
          "iteration": { "type": ["integer", "null"] },
          "state": {
            "type": "object",
            "required": ["repr", "digest", "tokens"],
            "additionalProperties": true,
            "properties": {
              "repr": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "minLength": 1 },
              "tokens": { "type": "integer", "minimum": 0 }
            }
          },
          "action": {
            "type": "object",
            "required": ["raw", "normalized", "tool", "args"],
            "additionalProperties": true,
            "properties": {
              "raw": { "type": "string" },
              "normalized": { "type": "string", "minLength": 1 },
              "tool": { "type": "string", "minLength": 1 },
              "args": { "type": "object" }
            }
          },
          "observation": {
            "type": "object",
            "required": ["digest", "error", "tool_result_ref"],
            "additionalProperties": true,
            "properties": {
              "digest": { "type": "string" },
              "error": { "type": ["string", "null"] },
              "tool_result_ref": { "type": ["string", "null"] }
            }
          },
          "credit": {
            "type": "object",
            "required": ["review_score", "source", "discounted_return"],
            "additionalProperties": true,
            "properties": {
              "review_score": {
                "type": ["integer", "null"],
                "minimum": -10,
                "maximum": 3
              },
              "source": { "const": "review" },
              "review_id": { "type": ["string", "null"] },
              "dimension": { "type": ["string", "null"] },
              "confidence": { "type": ["string", "null"] },
              "evidence_ref": { "type": ["string", "null"] },
              "root_cause": { "type": ["string", "null"] },
              "discounted_return": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "returns": {
      "type": "object",
      "required": ["gamma", "G"],
      "additionalProperties": true,
      "properties": {
        "gamma": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "G": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["trace_seqs", "created_at", "code_version", "suite_version", "license"],
      "additionalProperties": true,
      "properties": {
        "trace_seqs": { "type": "array" },
        "created_at": { "type": "string" },
        "code_version": { "type": "string" },
        "suite_version": { "type": "string" },
        "license": { "type": "string" }
      }
    }
  }
}
