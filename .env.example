# 开发环境配置
#
# 已弃用键说明（不出现在本示例中，但插件 SDK 的 Settings 仍会读入这些
# 环境变量、字段保留以兼容——0.2 无任何消费者，设置与否都不影响行为）：
#   APP_DATABASE_URL / APP_JWT_ALGORITHM / APP_ACCESS_TOKEN_EXPIRE_MINUTES /
#   APP_REFRESH_TOKEN_EXPIRE_DAYS / APP_LOG_FORMAT / APP_ZHIPU_API_KEY /
#   EVENT_BUS_TYPE / ZHIPU_API_KEY_2 / LLM_MAX_CONCURRENT /
#   LLM_RATE_LIMIT_PER_MINUTE / LLM_ZHIPU_MAX_CONCURRENT /
#   LLM_OPENAI_MAX_CONCURRENT / LLM_ANTHROPIC_MAX_CONCURRENT /
#   LLM_DEFAULT_MAX_CONCURRENT
# 说明：LLM 并发与限流自 0.2 起由 config/models/llm.yaml 的 concurrency 段
# 配置；智谱密钥用 ZHIPU_API_KEY（llm.yaml 经 ${ZHIPU_API_KEY} 插值引用）。
APP_DEBUG=true
APP_ENVIRONMENT=development

# Redis 配置
# 用于 TokenManager 的 token 撤销存储（access/refresh 共用，跨进程生效）。
# docker-compose 中 redis 映射端口可能不同，按实际部署调整。
REDIS_URL=redis://localhost:6480/0

# JWT 配置（生产环境务必更换为高强度随机值）
APP_JWT_SECRET_KEY=change-me-to-a-random-secret

# 日志配置
LOG_LEVEL=DEBUG

# 注入 LLM 的当前时间所用时区（IANA 时区名）
# 取值如 Asia/Shanghai、UTC、Asia/Tokyo、America/New_York。默认 Asia/Shanghai。
# 传给 LLM 的时间会带上时区标注，格式如：2026-07-02 11:24:00 (UTC+8, Asia/Shanghai)
APP_TIMEZONE=Asia/Shanghai

# ══════════════════════════════════════════════════════════════════
# 大模型提供者 API Key（llm.yaml providers 通过 ${VAR} 引用）
# 只需为实际使用的提供者填写；也可在 前端 设置→模型→提供商与密钥 页
# 填写（自动写入 .env，无需重启）。
# ══════════════════════════════════════════════════════════════════

# ── 国内 ──
# 智谱 AI (GLM)：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-primary-api-key
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
# MiniMax：https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key
# 阿里通义千问（百炼 DashScope）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key
# 月之暗面 Kimi：https://platform.moonshot.cn
MOONSHOT_API_KEY=your-moonshot-api-key
# 豆包（火山方舟 Ark）：https://console.volcengine.com/ark
ARK_API_KEY=your-ark-api-key
# 腾讯混元：https://console.cloud.tencent.com/hunyuan
HUNYUAN_API_KEY=your-hunyuan-api-key
# 百度千帆：https://console.bce.baidu.com/iam/#/iam/apikey
QIANFAN_API_KEY=your-qianfan-api-key
# 阶跃星辰：https://platform.stepfun.com
STEPFUN_API_KEY=your-stepfun-api-key
# 讯飞星火：https://xinghuo.xfyun.cn
SPARK_API_KEY=your-spark-api-key
# 魔搭 ModelScope：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=your-modelscope-api-key
# 华为云 ModelArts MaaS：https://console.huaweicloud.com/modelarts/
MODELARTS_API_KEY=your-modelarts-api-key
# 硅基流动 SiliconFlow（记忆库 embedding 用，BAAI/bge-m3 免费）：https://siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key

# ── 订阅 ──
# OpenCode Zen/Go 订阅：https://opencode.ai/auth 或 https://opencode.ai/go
OPENCODE_ZEN_API_KEY=your-opencode-api-key

# ── 国际 ──
# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Anthropic：https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# Google Gemini：https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# xAI Grok：https://console.x.ai
XAI_API_KEY=your-xai-api-key
# Mistral：https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key
# Groq：https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# OpenRouter（聚合）：https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Perplexity：https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key
# Cohere：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key
# Together AI：https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=your-together-api-key
# Fireworks AI：https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=your-fireworks-api-key
# DeepInfra：https://deepinfra.com/dashborad/keys
DEEPINFRA_API_KEY=your-deepinfra-api-key
# Cerebras：https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key

# 默认管理员密码
# 系统启动时，会为内置 admin 账号设置此密码（bcrypt 哈希后存入内存）。
# 若不配置，将回退到一个不可用的字面默认值（含 $(date +%s)，Python 不会展开它），
# 导致 admin 无法登录、POST /api/v1/auth/login 一律 401。
# 仅在进程启动时读取一次，修改后必须重启后端才生效。
# 生产环境务必改为高强度随机密码。
DEFAULT_ADMIN_PASSWORD=your-admin-password

# ══════════════════════════════════════════════════════════════════
# 外部 MCP 搜索源密钥
# plugins/shared/tools/external_mcp/ 下各插件的 plugin.json 经 ${VAR}
# 引用（HTTP MCP 源用于注入 auth 头，stdio 源用于子进程环境变量）。

# ── 必填（HTTP MCP 搜索源；缺失时对应插件 connect 硬失败，validate-all 报 error） ──
# smithery_search 插件（https://smithery.ai）
SMITHERY_API_KEY=your-smithery-api-key
# mcp_registry_search 插件（https://registry.modelcontextprotocol.io）
MCP_REGISTRY_API_KEY=your-mcp-registry-api-key
# langchain_hub_search 插件（LangSmith 平台，https://smith.langchain.com；
# manifest 已声明 auth.required:false，但内核尚未尊重该声明，缺 key 仍会失败）
LANGSMITH_API_KEY=your-langsmith-api-key
# external_resource_search 插件（MCP Registry + Smithery 聚合搜索）
RESOURCE_SEARCH_API_KEY=your-resource-search-api-key

# ── 可选（omnisearch 插件，28+ 源聚合搜索；缺失仅降级——对应源被跳过，不影响其余源和插件） ──
# GitHub 搜索 token（https://github.com/settings/tokens）
OMNISEARCH_GITHUB_TOKEN=your-github-token
# Stack Exchange API key（https://stackexchange.com/users/manage/apps）
OMNISEARCH_STACKEXCHANGE_KEY=your-stackexchange-key
# Semantic Scholar API key（https://www.semanticscholar.org/product/api）
OMNISEARCH_SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# Unpaywall 联系邮箱（Unpaywall API 要求以邮箱标识调用方）
OMNISEARCH_UNPAYWALL_EMAIL=your-email@example.com
# SearXNG 实例地址（自建聚合搜索，如 http://localhost:8888）
OMNISEARCH_SEARXNG_BASE_URL=your-searxng-base-url
