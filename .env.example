# =============================================================================
# Agent OS 环境变量配置模板
# 复制此文件为 .env 并修改配置值
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 基础配置
# -----------------------------------------------------------------------------
# 运行环境: development / production / test
APP_ENV=production

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 项目根目录（容器内路径，一般不需要修改）
PROJECT_ROOT=/app

# -----------------------------------------------------------------------------
# API 服务配置
# -----------------------------------------------------------------------------
# API 服务端口
API_PORT=8000

# API 服务主机
API_HOST=0.0.0.0

# UVicorn workers 数量（生产环境建议按 CPU 核心数设置）
UVICORN_WORKERS=1

# UVicorn 日志级别
UVICORN_LOG_LEVEL=info

# API 认证密钥（生产环境必须修改）
API_SECRET_KEY=change-me-in-production

# API Token 过期时间（小时）
API_TOKEN_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Redis 连接 URL（优先级高于单独配置）
# REDIS_URL=redis://:password@redis:6379/0

# -----------------------------------------------------------------------------
# LLM 配置
# -----------------------------------------------------------------------------
# LLM 提供商: openai / azure / minimax / litellm
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# MiniMax 配置
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_MODEL=

# Azure OpenAI 配置
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# LiteLLM 配置（通用代理）
LITELLM_MODEL=

# -----------------------------------------------------------------------------
# 通道配置 (Channels)
# -----------------------------------------------------------------------------
# CLI 通道
CLI_ENABLED=true

# API 通道
API_ENABLED=true

# WebSocket 通道
WS_ENABLED=true

# -----------------------------------------------------------------------------
# 插件与工具配置
# -----------------------------------------------------------------------------
# 插件自动重载
PLUGIN_AUTO_RELOAD=false

# 工具超时时间（秒）
TOOL_TIMEOUT=30

# MCP 服务器配置路径
MCP_CONFIG_PATH=

# -----------------------------------------------------------------------------
# 记忆与存储配置
# -----------------------------------------------------------------------------
# 记忆后端: memory / redis / file
MEMORY_BACKEND=memory

# 数据存储目录
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# 隔离与安全配置
# -----------------------------------------------------------------------------
# 工作空间隔离模式: docker / process / none
ISOLATION_MODE=none

# Docker 隔离配置
DOCKER_SOCKET=/var/run/docker.sock

# -----------------------------------------------------------------------------
# 前端配置（可选）
# -----------------------------------------------------------------------------
# 前端服务地址
FRONTEND_URL=http://localhost:5188

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5188,http://localhost:5189

# -----------------------------------------------------------------------------
# 多实例端口配置（可选）
# -----------------------------------------------------------------------------
# 默认情况下，后端使用 8888，前端使用 5188
# 如果需要同时运行多个项目实例，为每个实例设置不同的端口：
#
#   实例 A（根目录项目，使用默认端口）:
#     start_web.bat
#
#   实例 B（容器/工作空间项目，使用不同端口）:
#     set BACKEND_PORT=8889
#     set FRONTEND_PORT=5189
#     start_web.bat
#
# 后端端口（start_server.py 和 start_web.bat 使用）
BACKEND_PORT=8888
# 前端端口（vite.config.ts 和 start_web.bat 使用）
FRONTEND_PORT=5188
