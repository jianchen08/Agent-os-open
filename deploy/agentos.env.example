# AgentOS 内核 EnvironmentFile 模板（server 部署）。
#
# 安装（systemd unit 引用 /etc/agentos/agentos.env，含明文口令必须 0600）：
#   sudo install -d -m 0755 /etc/agentos
#   sudo install -m 0600 本文件 /etc/agentos/agentos.env
# 裸起（deploy/start_server.sh）：本仓库脚本不读本文件，按同名变量以环境变量
# 方式注入——变量口径一致，逐项对齐即可。
# 语法：systemd EnvironmentFile——KEY=value，行内不展开 shell 变量，值含空格用双引号。

# ========== 监听 ==========
# 默认 127.0.0.1 仅回环；远程前端经反代/直连必须显式 0.0.0.0 开启外网可达。
AGENTOS_BIND=0.0.0.0
# 监听端口，缺省 9100。改动须与前端反代目标（nginx upstream）同步。
AGENTOS_KERNEL_PORT=9100

# ========== 路径（必设）==========
# 内置插件根。二进制内嵌的是编译期绝对路径，裸跑必失效，必须显式指向
# 仓库内 plugins/shared。
AGENTOS_PLUGINS_DIR=/opt/agentos/plugins/shared
# 工厂配置根。同上，编译期默认路径不可用，必须显式指向仓库内 config。
AGENTOS_CONFIG_ROOT=/opt/agentos/config
# 用户空间根（库/密钥 .env/用户配置/插件镜像）。必须显式设置：systemd 环境
# 常缺 HOME/XDG 目录变量，OS 标准目录解析为 None 时 user_root=None 全链降级。
# 必须在本地文件系统：网络盘上 SQLite 锁坏死（实测 disk I/O error）。
AGENTOS_USER_ROOT=/opt/agentos/user_root
# Python sidecar 缺 .venv 时 boot 后台自动 uv sync 自愈（需 uv 在 PATH）。
AGENTOS_PLUGIN_VENV_AUTOPROVISION=1

# ========== 密钥（必设）==========
# 内置 admin 口令。不设则首启生成随机口令并仅打印一次到控制台——headless
# 下无人在场即永久丢失，必须显式固定。
# 注意：本变量常驻 env 时，每次启动口令不符即强制重置——UI 改密会被冲回；
# 改密后应撤掉本变量（遗忘口令时再临时加回重启重置）。
AGENTOS_ADMIN_PASSWORD=change-me-strong-password
# token 签名密钥。不设则每进程随机生成，内核重启后全部已签发 token 失效
# （全端掉线、人人重新登录）。生成：openssl rand -hex 32。
AGENTOS_TOKEN_SECRET=change-me-openssl-rand-hex-32

# ========== 跨域 ==========
# 逗号分隔的完整 origin 白名单。前端 origin 非 localhost 时必设；不设仅放行
# 本地源（localhost/127.0.0.1 任意端口免配置）。
# AGENTOS_CORS_ORIGINS=https://app.example.com

# ========== LLM keys ==========
# 读序：进程环境变量 > <AGENTOS_USER_ROOT>/.env——两处落点任选其一：
# 进程级密钥以 KEY=value 逐行列进本文件（如 OPENAI_API_KEY=...）；
# 或不写进本文件，经内核设置页写入用户空间 .env（AGENTOS_USER_ROOT/.env）。
# 同名键进程环境优先，.env 只补进程未有的变量。

# ========== 可选 ==========
# 插件 sidecar 空闲软卸载阈值（秒），缺省 300。空闲即卸的 sidecar 会从 LLM
# 工具面脱落（下次调用才冷启动重启），常驻部署建议拉长到一天，避免工具间歇
# 性不可见。优先级：插件 manifest lifecycle.idle_timeout_secs > 本变量 > 300。
AGENTOS_PLUGIN_IDLE_TIMEOUT_SECS=86400
# 浏览器隔离桥令牌：fail-closed——不设则浏览器 browser_* 工具链路不可用
# （令牌经隔离容器注入与宿主侧校验，须与浏览器扩展侧一致）。
# AGENTOS_BRIDGE_TOKEN=
# 每 user 连接数上限，缺省 4，超限 LRU 踢最旧；多端（>4）并发时调大。
# AGENTOS_MAX_CONNS_PER_USER=8
# SQLite 库位置。缺省落 AGENTOS_USER_ROOT 下；一般无需设置。
# 必须在本地文件系统：网络盘上 SQLite 锁坏死（实测 disk I/O error）。
# AGENTOS_DB_PATH=/opt/agentos/data/agentos_kernel.db
