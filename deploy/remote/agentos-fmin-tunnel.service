# =============================================================================
# F-min 反向隧道（本机侧 systemd unit 模板，autossh）
#
# 作用：本机主动外连云机（入向零暴露），把两个本机端口映射到云机 127.0.0.1：
#   9201 → 本机 F-min MCP server（云内核 mcp:external 的 endpoint.url 指它）
#   2222 → 本机 sshd（云侧 sshfs 只读挂载走它；不用只读挂载面可删此行）
#
# 部署（本机为 Linux/WSL 时）：
#   1. ssh-keygen 专用密钥 + ssh-copy-id 到云机；
#   2. 替换下方 <cloud-user>@<cloud-host> 与端口占位；
#   3. cp 到 /etc/systemd/system/ && systemctl daemon-reload &&
#      systemctl enable --now agentos-fmin-tunnel
#
# 说明：
#   - -M 0：不用 autossh 额外监控端口，靠 ServerAliveInterval 探活；
#   - -R 只绑云机 127.0.0.1（云机 sshd GatewayPorts 缺省即如此）——MCP 面
#     不经云机公网暴露，nginx/443 与本通道无关；
#   - 本机为 Windows 时：可在 WSL 内以 systemd 跑本 unit，或用任务计划程序
#     跑等价 `ssh -N -R ...` 常驻命令（Windows 原生 autossh 替代不在本批范围）。
# =============================================================================

[Unit]
Description=AgentOS F-min reverse tunnel (local MCP/sshd -> cloud loopback)
After=network-online.target
Wants=network-online.target

[Service]
User=<local-user>
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N -T \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=10 \
  -R 127.0.0.1:9201:127.0.0.1:9201 \
  -R 127.0.0.1:2222:127.0.0.1:22 \
  <cloud-user>@<cloud-host>
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
