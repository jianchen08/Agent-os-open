# ============================================================
# .gitignore — 灵汐 AgentOS
# 防散落核心规则:
#   - 根目录下划线开头的脚本(_*.py / _*.ps1 / _*.sh)一律不入库
#   - working/ 与 .project/ 是本地工作区(过程文档/私密资料),不入库
#   - 可再生产物(reports/
# 例外:traceability 门禁的审查号清单源数据(非可再生产物)
!reports/audit_round3/
!reports/audit_round3/T5_tests.mddump/构建标记)不入库
# ============================================================

# ─── Python ───
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.mypy_cache/
.tox/
.py_deps_installed

# ─── Node / 前端 ───
node_modules/
dist/
dist-electron/
build/
coverage/
.coverage
htmlcov/
# 阶段 2/5.3 CI 产出的覆盖率报告（供 sync_coverage_to_matrix.py 消费，不入库）
coverage.xml
coverage.lcov
coverage-summary.json
*.lcov
docs/coverage_report.md

# ─── 本地工作区(过程文档/私密资料/草稿,不入库)───
# 锚定到根目录,避免误伤 docs/working/ 等同名子目录
/working/
.ai_workspaces/
.claude/
.workbuddy/
.dbg/

# ─── 测试 / 报告产物(可随时再生,不入库)───
reports/
# 例外:traceability 门禁的审查号清单源数据(非可再生产物)
!reports/audit_round3/
!reports/audit_round3/T5_tests.md
test-results/
e2e_screenshots/
verify_screenshots/
frontend/test-results/
*_debug.log
_paste_debug.log
*.ndjson
*.json.gz
*.heapsnapshot

# ─── 调试 / 临时脚本(根目录下划线开头一律不入库)───
# 防散落硬规则:任何 _*.py / _*.ps1 / _*.sh 都不会被提交,
# 调试脚本请用下划线开头写在根目录,天然隔离不入库。
# 仅匹配根目录下划线脚本，避免误伤插件正规模块（如 plugins/.../_config_models.py）。
/_*.py
/_*.ps1
/_*.sh
*.tmp
.tmp_*
debug-*.md
debug-*.log
# 一次性调试探针脚本/探针配置/探针输出,不入库
frontend/scripts/debug_*.mjs
frontend/scripts/probe_*.mjs
frontend/scripts/analyze_trace.py
frontend/scripts/analyze_trace2.py
frontend/vite.probe.config.ts
frontend/probe-out/

# ─── 运行时 dump / 工具抓取产物 ───
docker_watchdog_dumps/
.playwright-cli/
src/logs/
# 根目录 logs/ 是运行时日志/截图/诊断产物，不入库
/logs/
# llm_core payload 诊断落盘（默认关闭；开启时改写系统 tempfile，但历史/误开仍可能在此产生）
plugins/shared/pipeline/core/llm_core/logs/
**/logs/payload_diag/

# ─── 备份文件(含后缀变体 .bak_xxx)───
*.bak
*.bak_*

# ─── 机密 ───
.env
*.log
.ports

# ─── 本地运行/调试产物(防 auto-save 提交混入,不入库)───
# 启动脚本运行日志及其调试包装脚本
_run_log.txt
start_web_cn.log
start_web_cn_log.bat
# 一次性评估/语义检查报告(过程产物,见 docs/working/)
eval_report_*.md
# 崩溃转储(根目录已由 *.stackdump 覆盖,此处补 frontend/ 等子目录)
*.stackdump
# 纯数字误建文件(如 `python3.11` 命令重定向错误产生的 3.11)
/3.11

# ─── IDE / Agent 本地工作区(规划过程、会话产物,不入库)───
# 整体忽略 .zcode/,防止未来新增子目录(如 cache/、tmp/)再次泄露
.zcode/

# ─── 数据库 / 运行时数据 ───
data/
database.db
*.db
*.sqlite3

# ─── 前端构建注入标记(本地构建生成,不入库)───
.frontend_built_at
.frontend_src_hash

# ─── 本地临时工作目录 ───
tmp*/
/artifacts/
/deliverables/
/review/
/findings/
/e2e/
/agent_os_hot_reload/
/pytest-of-*/

# ─── Windows shell 重定向产生的坏文件名 ───
NUL
nul
nul)
$null
/frontend/$null

# ─── 离线依赖包(二进制不入库,仅保留 .gitkeep 占位)───
packages/wheels/*
!packages/wheels/.gitkeep
packages/npm-tarballs/*
!packages/npm-tarballs/.gitkeep

# ─── 崩溃转储（不入库）───
*.stackdump

# ─── Rust 编译中间产物（仅保留 release 二进制）───
# Cargo 构建缓存目录：体积大、可随时 cargo build 再生，绝不入库。
# 锚定到任意层级的 target/（workspace 根 + 各插件 crate 子目录都适用）。
target/
**/target/
# Cargo.lock：库才忽略，二进制应用应提交。AgentOS kernel 是二进制服务，
# 故 Cargo.lock 入库（不在此忽略）。各插件 cdylib 也是二进制产物，同理。
# Cargo 单元测试 / 基准产物
*.rs.bk
# RustProfiler 输出
*.profraw
*.profdata


# SQLite 运行时文件（内核运行生成，勿入库）
agentos_kernel.db
agentos_kernel.db-wal
agentos_kernel.db-shm

# Godot 编辑器缓存（hosts/godot-demo 首次打开生成）
hosts/godot-demo/.godot/
.zcode_tmp_*
kernel/schema_tmp.json

# 取消跟踪的仓库垃圾（worktree 加速）
.zcode_e2e/
*.dll
*.so

# uv（python 包装载插件 python_packager）sidecar venv 不入库
.venv/
# hindsight_memory 第二 venv（API 服务器栈，mcp 1.x 与 SDK 的 mcp 2.x 互斥故独立）
.venv-hindsight/

# e2e 产物 token 文件（已过期凭据物证，不入库）
.e2e_token_*
