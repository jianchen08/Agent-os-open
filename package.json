{
  "name": "agent-os",
  "version": "0.1.0",
  "description": "灵汐 AgentOS - 高度可配置化、自进化的 AI Agent 平台",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jianchen08/Agent-os-open.git"
  },
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev --prefix frontend\" \"wait-on http://localhost:5188 && electron .\"",
    "electron:build": "npm run build --prefix frontend && tsc -p electron/tsconfig.json && electron-builder",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:compile:watch": "tsc -p electron/tsconfig.json --watch",
    "test": "python scripts/run_gates.py --mode fast",
    "test:coverage": "python scripts/run_gates.py --mode all"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.agentos.assistant",
    "productName": "灵汐助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "frontend/dist/**/*",
      "frontend/public/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "plugins/shared",
        "to": "plugins/shared",
        "filter": [
          "**/*",
          "!**/.venv{,/**}",
          "!**/.venv-*{,/**}",
          "!**/node_modules{,/**}",
          "!**/__pycache__{,/**}",
          "!**/*.pyc",
          "!**/.mypy_cache{,/**}",
          "!**/.pytest_cache{,/**}",
          "!**/.ruff_cache{,/**}",
          "!**/target{,/**}"
        ]
      },
      {
        "from": "plugins/shared/_host/.venv",
        "to": "plugins/shared/_host/.venv",
        "filter": [
          "**/*",
          "!**/__pycache__{,/**}",
          "!**/*.pyc",
          "!**/.mypy_cache{,/**}",
          "!**/.pytest_cache{,/**}",
          "!**/.ruff_cache{,/**}"
        ]
      },
      {
        "from": "plugins/sdk",
        "to": "plugins/sdk",
        "filter": [
          "pyproject.toml",
          "src/**/*",
          "!**/__pycache__{,/**}",
          "!**/*.pyc",
          "!**/*.egg-info{,/**}"
        ]
      },
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/favicon.ico",
      "extraResources": [
        {
          "from": "kernel/target/release/agentos-kernel.exe",
          "to": "kernel/agentos-kernel.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/nsis/bug12-uninstaller.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "frontend/public/icon.png",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "kernel/target/release/agentos-kernel",
          "to": "kernel/agentos-kernel"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "frontend/public/icon.png",
      "extraResources": [
        {
          "from": "kernel/target/release/agentos-kernel",
          "to": "kernel/agentos-kernel"
        }
      ]
    }
  },
  "overrides": {
    "shell-quote": "1.9.0"
  }
}
