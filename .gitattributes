# 换行符规则（防止 git 在 Windows 上自动转 CRLF 破坏 Linux 脚本）
# Linux 脚本：强制 LF
*.sh         text eol=lf
install.sh   text eol=lf
install_wsl_docker.sh text eol=lf
docker-entrypoint.sh  text eol=lf

# Windows 脚本：强制 CRLF
*.bat        text eol=crlf
*.ps1        text eol=crlf

# 默认：交给 git autocrlf 处理
* text=auto

# tiktoken 预置词表：内容寻址缓存件，字节级 sha256 校验，禁任何 EOL 转换
plugins/shared/llm/tiktoken_cache/** -text

# 技能同文双副本（P-17/E0-10）：行尾钉 LF，防两副本行尾分叉致 bytes 级同文闸假红
skills/**/SKILL.md text eol=lf
plugins/shared/mode_coding/skills/**/SKILL.md text eol=lf
