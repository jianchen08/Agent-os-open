{
  "id": "cost_control",
  "name": "Cost Control Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "cost_control.check_budget",
        "description": "Check if budget allows the estimated token usage",
        "input_schema": {
          "properties": {
            "estimated_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "预估 Token 数"
            },
            "user_id": {
              "type": "string",
              "description": "用户 ID（可选）"
            },
            "task_id": {
              "type": "string",
              "description": "任务 ID（可选）"
            },
            "session_id": {
              "type": "string",
              "description": "会话 ID（可选）"
            }
          },
          "required": [
            "estimated_tokens"
          ],
          "type": "object"
        }
      },
      {
        "name": "cost_control.record_usage",
        "description": "Record token usage and check for budget alerts",
        "input_schema": {
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "使用的 Token 数"
            },
            "model": {
              "type": "string",
              "description": "模型名称"
            },
            "user_id": {
              "type": "string",
              "description": "用户 ID（可选）"
            },
            "task_id": {
              "type": "string",
              "description": "任务 ID（可选）"
            },
            "session_id": {
              "type": "string",
              "description": "会话 ID（可选）"
            }
          },
          "required": [
            "tokens",
            "model"
          ],
          "type": "object"
        }
      },
      {
        "name": "cost_control.get_status",
        "description": "Get current budget status for a scope",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "用户 ID（可选）"
            },
            "task_id": {
              "type": "string",
              "description": "任务 ID（可选）"
            },
            "session_id": {
              "type": "string",
              "description": "会话 ID（可选）"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "cost_control.get_statistics",
        "description": "Get global usage statistics",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "cost_control.reset_task_budget",
        "description": "Reset budget tracking for a specific task",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "任务 ID"
            }
          },
          "required": [
            "task_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "cost_control.reset_session_budget",
        "description": "Reset budget tracking for a specific session",
        "input_schema": {
          "properties": {
            "session_id": {
              "type": "string",
              "description": "会话 ID"
            }
          },
          "required": [
            "session_id"
          ],
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "config_files": [
    {
      "id": "cost",
      "path": "config/system/cost_control.yaml",
      "label": "成本控制配置",
      "fields": [
        {
          "name": "enabled",
          "type": "toggle",
          "label": "启用成本控制",
          "default": true
        },
        {
          "name": "global_config.daily_token_limit",
          "type": "number",
          "label": "日 token 上限",
          "min": 0,
          "default": 1000000
        },
        {
          "name": "global_config.monthly_token_limit",
          "type": "number",
          "label": "月 token 上限",
          "min": 0,
          "default": 30000000
        },
        {
          "name": "global_config.per_task_token_limit",
          "type": "number",
          "label": "单任务 token 上限",
          "min": 0,
          "default": 200000
        },
        {
          "name": "global_config.per_session_token_limit",
          "type": "number",
          "label": "单会话 token 上限",
          "min": 0,
          "default": 500000
        },
        {
          "name": "alerts.warning_threshold",
          "type": "slider",
          "label": "预警阈值（%）",
          "min": 0,
          "max": 100,
          "default": 70
        },
        {
          "name": "alerts.critical_threshold",
          "type": "slider",
          "label": "严重阈值（%）",
          "min": 0,
          "max": 100,
          "default": 90
        },
        {
          "name": "alerts.exhausted_threshold",
          "type": "slider",
          "label": "耗尽阈值（%）",
          "min": 0,
          "max": 100,
          "default": 100
        },
        {
          "name": "protection.auto_save_at_warning",
          "type": "toggle",
          "label": "预警时自动保存",
          "default": true
        },
        {
          "name": "protection.auto_pause_at_critical",
          "type": "toggle",
          "label": "严重时自动暂停",
          "default": true
        },
        {
          "name": "protection.auto_stop_at_exhausted",
          "type": "toggle",
          "label": "耗尽时自动停止",
          "default": true
        }
      ]
    }
  ],
  "http_endpoints": [
    {
      "route_id": "cost_budget_status",
      "method": "GET",
      "path": "/ext/cost_control/budget/status",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get current budget status (frontend CostDashboardWidget / StatusBar)"
    },
    {
      "route_id": "cost_usage_statistics",
      "method": "GET",
      "path": "/ext/cost_control/usage/statistics",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get global usage statistics"
    },
    {
      "route_id": "cost_config",
      "method": "GET",
      "path": "/ext/cost_control/config",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get cost control config (flattened)"
    },
    {
      "route_id": "cost_report",
      "method": "GET",
      "path": "/ext/cost_control/report",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get cost report by period (?period=daily|weekly|monthly)"
    },
    {
      "route_id": "cost_budget_reset",
      "method": "POST",
      "path": "/ext/cost_control/budget/reset",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Reset global budget tracking"
    },
    {
      "route_id": "cost_config_file_get",
      "method": "GET",
      "path": "/ext/cost_control/config/cost-control",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "读取成本控制 YAML 配置全文（config/system/cost_control.yaml，嵌套 CostControlConfigResponse 形态，前端 config.ts 消费——channel_api 批次1 迁入，原 GET /ext/channel_api/config/cost-control）"
    },
    {
      "route_id": "cost_config_file_put",
      "method": "PUT",
      "path": "/ext/cost_control/config/cost-control",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "写入成本控制 YAML 配置全文（body=完整嵌套配置；channel_api 批次1 迁入，原 PUT /ext/channel_api/config/cost-control）"
    }
  ],
  "ui_schema": {
    "widgets": [
      {
        "id": "budget_card",
        "type": "status_card",
        "space": "cost",
        "order": 10,
        "props": {
          "title": "全局预算",
          "label": "预算用量",
          "datasourceUri": "/ext/cost_control/budget/status",
          "valueKey": "usage_percent",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          }
        }
      },
      {
        "id": "usage_daily_card",
        "type": "status_card",
        "space": "cost",
        "order": 20,
        "props": {
          "title": "今日用量",
          "label": "今日使用率",
          "datasourceUri": "/ext/cost_control/usage/statistics",
          "valueKey": "global_stats.daily_usage_percent",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          }
        }
      },
      {
        "id": "usage_monthly_card",
        "type": "status_card",
        "space": "cost",
        "order": 30,
        "props": {
          "title": "本月用量",
          "label": "本月使用率",
          "datasourceUri": "/ext/cost_control/usage/statistics",
          "valueKey": "global_stats.monthly_usage_percent",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          }
        }
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "cost_dashboard",
        "title": "成本",
        "icon": "💰",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 40,
        "path": "/cost",
        "widget": "widget_stage",
        "props": {
          "space": "cost"
        },
        "description": "成本看板（widget 化：预算/用量卡声明组合，替代硬编码 CostDashboardWidget）"
      }
    ]
  }
}
