{
  "id": "task_service",
  "name": "Task Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "task.create",
        "description": "Create a new task",
        "input_schema": {
          "properties": {
            "title": {
              "type": "string",
              "description": "Task title"
            },
            "description": {
              "type": "string",
              "default": "",
              "description": "Task description"
            },
            "priority": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 10,
              "description": "Task priority (1=highest, 10=lowest)"
            },
            "parent_task_id": {
              "type": "string",
              "description": "Parent task ID for subtask hierarchy"
            }
          },
          "required": [
            "title"
          ],
          "type": "object"
        }
      },
      {
        "name": "task.get",
        "description": "Get task details by ID",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Task ID"
            }
          },
          "required": [
            "task_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "task.transition",
        "description": "Perform a state transition on a task (start, pause, resume, fail, complete_evaluation)",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Task ID"
            },
            "action": {
              "type": "string",
              "enum": [
                "start",
                "pause",
                "resume",
                "fail",
                "complete_evaluation"
              ],
              "description": "Transition action to perform"
            },
            "reason": {
              "type": "string",
              "description": "Reason for fail action"
            },
            "passed": {
              "type": "boolean",
              "description": "Evaluation result (for complete_evaluation action)"
            },
            "result": {
              "type": "object",
              "description": "Evaluation result data"
            }
          },
          "required": [
            "task_id",
            "action"
          ],
          "type": "object"
        }
      },
      {
        "name": "task.list",
        "description": "List tasks by status or parent",
        "input_schema": {
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "evaluating",
                "stopped",
                "completed",
                "failed",
                "timeout"
              ],
              "description": "Filter by status. Omit to list all tasks."
            },
            "parent_task_id": {
              "type": "string",
              "description": "Filter by parent task ID (list subtasks)"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "task.cancel",
        "description": "Cancel a task and optionally cascade to subtasks",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Root task ID to cancel"
            },
            "reason": {
              "type": "string",
              "description": "Cancellation reason"
            },
            "cascade": {
              "type": "boolean",
              "default": true,
              "description": "Cascade cancel all subtasks"
            }
          },
          "required": [
            "task_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "task.delete",
        "description": "Delete a task (soft delete for containers, hard delete otherwise)",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Task ID to delete"
            }
          },
          "required": [
            "task_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "task.get_transitions",
        "description": "Get valid state transitions for a task",
        "input_schema": {
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Task ID"
            }
          },
          "required": [
            "task_id"
          ],
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "pipeline-executor"
  ],
  "http_endpoints": [
    {
      "route_id": "tasks_list",
      "method": "GET",
      "path": "/ext/task_service/tasks",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：任务列表（query: status/priority/session_id/limit/offset/skip）——channel_api 拆迁落户"
    },
    {
      "route_id": "tasks_create",
      "method": "POST",
      "path": "/ext/task_service/tasks",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：创建任务（agent_id 必填，GAP-1 经 chat 建执行管道）"
    },
    {
      "route_id": "tasks_debug_all",
      "method": "GET",
      "path": "/ext/task_service/tasks/debug/all",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：调试用全量任务"
    },
    {
      "route_id": "tasks_create_root",
      "method": "POST",
      "path": "/ext/task_service/tasks/root",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：手动创建根任务（container/non_container）"
    },
    {
      "route_id": "tasks_containers",
      "method": "GET",
      "path": "/ext/task_service/tasks/containers",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：列出容器任务（query: session_id）"
    },
    {
      "route_id": "task_get",
      "method": "GET",
      "path": "/ext/task_service/tasks/{task_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：任务详情"
    },
    {
      "route_id": "task_update",
      "method": "PATCH",
      "path": "/ext/task_service/tasks/{task_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：更新任务（读 state 聚合行，update 语义已退役）"
    },
    {
      "route_id": "task_delete",
      "method": "DELETE",
      "path": "/ext/task_service/tasks/{task_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：删除任务（容器软删/非容器硬删）"
    },
    {
      "route_id": "task_submit",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/submit",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：提交任务执行（注入模式重跑任务管道）"
    },
    {
      "route_id": "task_evaluate",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/evaluate",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：评估任务（已退役，恒 410；评估走 task_evaluate 工具）"
    },
    {
      "route_id": "task_pause",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/pause",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：暂停任务（suspend_pipeline）"
    },
    {
      "route_id": "task_resume",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/resume",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：恢复任务（resume_pipeline）"
    },
    {
      "route_id": "task_cancel",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/cancel",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：取消任务（挂起管道 + lineage 级联）"
    },
    {
      "route_id": "task_phase_status",
      "method": "GET",
      "path": "/ext/task_service/tasks/{task_id}/phase",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：任务当前阶段"
    },
    {
      "route_id": "task_phase_complete_prepare",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/phase/prepare/complete",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：完成准备阶段"
    },
    {
      "route_id": "task_phase_complete_execute",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/phase/execute/complete",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "tasks 域：完成执行阶段"
    },
    {
      "route_id": "task_phase_output",
      "method": "GET",
      "path": "/ext/task_service/tasks/{task_id}/phase/{phase}/output",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：获取阶段输出（占位）"
    },
    {
      "route_id": "task_ac_list",
      "method": "GET",
      "path": "/ext/task_service/tasks/{task_id}/ac",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：获取任务验收标准（占位）"
    },
    {
      "route_id": "task_ac_evaluate_all",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/ac/evaluate-all",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：评估所有验收标准（占位）"
    },
    {
      "route_id": "task_ac_evaluate",
      "method": "POST",
      "path": "/ext/task_service/tasks/{task_id}/ac/{ac_id}/evaluate",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 2,
      "description": "tasks 域：评估单个验收标准（占位）"
    },
    {
      "route_id": "task_ac_result",
      "method": "GET",
      "path": "/ext/task_service/tasks/{task_id}/ac/{ac_id}/result",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "tasks 域：获取验收标准评估结果（占位）"
    },
    {
      "route_id": "projects_list",
      "method": "GET",
      "path": "/ext/task_service/projects",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "projects 域：长期任务列表（= 容器任务，query: limit/offset/page/status/session_id）——接真"
    },
    {
      "route_id": "projects_create",
      "method": "POST",
      "path": "/ext/task_service/projects",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "projects 域：创建长期任务（= 创建容器任务 + workspace 关联）"
    },
    {
      "route_id": "project_get",
      "method": "GET",
      "path": "/ext/task_service/projects/{project_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "projects 域：长期任务详情（含子任务摘要）"
    },
    {
      "route_id": "project_toggle_auto_execute",
      "method": "POST",
      "path": "/ext/task_service/projects/{project_id}/auto-execute",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "projects 域：切换自动执行（持久化 metadata.auto_execute）"
    },
    {
      "route_id": "project_pause",
      "method": "POST",
      "path": "/ext/task_service/projects/{project_id}/pause",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "projects 域：暂停长期任务（挂起管道尽力 + 状态机 STOPPED）"
    },
    {
      "route_id": "project_resume",
      "method": "POST",
      "path": "/ext/task_service/projects/{project_id}/resume",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "projects 域：恢复长期任务（状态机 running + 恢复管道尽力）"
    },
    {
      "route_id": "project_delete",
      "method": "DELETE",
      "path": "/ext/task_service/projects/{project_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "projects 域：删除长期任务（容器任务软删除）"
    }
  ],
  "config_files": [
    {
      "id": "long_term_task",
      "path": "config/system/long_term_task.yaml",
      "label": "长期任务配置"
    }
  ]
}
