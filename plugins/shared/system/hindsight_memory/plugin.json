{
  "id": "hindsight_memory_service",
  "name": "Hindsight Memory Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "hindsight.retain",
        "description": "Store a memory into a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "content": {
              "type": "string",
              "description": "Memory content text"
            },
            "memory_type": {
              "type": "string",
              "default": "semantic",
              "description": "Memory type tag (goes into metadata for recall filter)"
            },
            "metadata": {
              "type": "object",
              "default": {},
              "description": "Optional extra metadata"
            }
          },
          "required": [
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "hindsight.recall",
        "description": "Recall relevant memories from a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "query": {
              "type": "string",
              "description": "Recall query"
            },
            "top_k": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 100
            },
            "memory_type": {
              "type": "string",
              "description": "Optional client-side filter by memory_type"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      },
      {
        "name": "hindsight.reflect",
        "description": "Trigger hindsight reflection/consolidation on a bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.summarize",
        "description": "Summarize relevant memories via recall + reflection (SUMMARY injection)",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "query": {
              "type": "string",
              "description": "摘要聚焦的查询（缺省总结最近记忆）"
            },
            "top_k": {
              "type": "integer",
              "default": 20,
              "description": "recall 检索条数"
            },
            "memory_type": {
              "type": "string",
              "description": "按记忆类型过滤检索"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.delete",
        "description": "Delete memories from a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "memory_id": {
              "type": "string",
              "description": "Optional specific memory id to delete; if omitted deletes the whole bank"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.import_document",
        "description": "Chunk and import a text document into a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "text": {
              "type": "string",
              "description": "Document text to import (mutually exclusive with file_path)"
            },
            "file_path": {
              "type": "string",
              "description": "Path to a .txt/.md file to import"
            },
            "knowledge_name": {
              "type": "string",
              "description": "Optional knowledge label for the imported doc"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.get_documents",
        "description": "Get raw documents (original_text + metadata) from a hindsight bank (read-only; cold-read exact recovery, not extracted facts)",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "document_id": {
              "type": "string",
              "description": "Exact document id for single-document fetch (when given, tags/q are ignored)"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Server-side tag filter (e.g. ['review_id:<id>'])"
            },
            "tags_match": {
              "type": "string",
              "default": "any_strict",
              "description": "Tag match mode: any/all/any_strict/all_strict/exact"
            },
            "q": {
              "type": "string",
              "description": "Case-insensitive substring filter on document id"
            },
            "limit": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          "type": "object"
        }
      },
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/hindsight_memory_service/** (recall/stats + memory 域 + knowledge-base 域)",
        "input_schema": {
          "properties": {
            "path": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "plugin_id": {
              "type": "string"
            },
            "raw_body": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            }
          },
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "config_files": [],
  "http_endpoints": [
    {
      "route_id": "hindsight_recall",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/recall",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "记忆回顾（前端记忆页接成熟 Hindsight 数据）"
    },
    {
      "route_id": "hindsight_stats",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/stats",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "记忆后端状态"
    },
    {
      "route_id": "memory_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆列表（query: memory_type/limit/offset）"
    },
    {
      "route_id": "memory_search_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：关键词搜索（query: query/top_k/method）"
    },
    {
      "route_id": "memory_search_post",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/memory/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：关键词搜索（POST）"
    },
    {
      "route_id": "memory_episodes_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/episodes",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：情景记忆列表（query: page/page_size）"
    },
    {
      "route_id": "memory_episode_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/episodes/{episode_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：单个情景记忆"
    },
    {
      "route_id": "memory_semantic_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/semantic",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：语义记忆列表"
    },
    {
      "route_id": "memory_consolidate",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/memory/consolidate",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 2,
      "description": "memory 域：记忆整合"
    },
    {
      "route_id": "memory_stats",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆统计"
    },
    {
      "route_id": "memory_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/{memory_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆详情"
    },
    {
      "route_id": "memory_delete",
      "method": "DELETE",
      "path": "/ext/hindsight_memory_service/memory/{memory_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "memory 域：删除记忆"
    }
  ],
  "granted_capabilities": [
    "tool-executor"
  ],
  "ui_schema": {
    "widgets": [
      {
        "id": "memory_table",
        "type": "table",
        "space": "memory",
        "order": 10,
        "props": {
          "title": "最近记忆（Hindsight）",
          "datasourceUri": "/ext/hindsight_memory_service/recall?query=&limit=10"
        }
      },
      {
        "id": "memory_stats",
        "type": "status_card",
        "space": "memory",
        "order": 20,
        "props": {
          "label": "记忆后端",
          "datasourceUri": "/ext/hindsight_memory_service/stats",
          "valueKey": "backend"
        }
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "memory",
        "title": "记忆",
        "icon": "🧠",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 30,
        "path": "/memory",
        "widget": "widget_stage",
        "props": {
          "space": "memory"
        },
        "description": "记忆回顾（widget 化：Hindsight 记忆表+后端状态卡）"
      }
    ]
  }
}
