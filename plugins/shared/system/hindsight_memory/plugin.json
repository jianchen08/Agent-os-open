{
  "id": "hindsight_memory_service",
  "requires_services": [
    "packaging"
  ],
  "name": "Hindsight Memory Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "hindsight.retain",
        "description": "Store a memory into a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "content": {
              "type": "string",
              "description": "Memory content text"
            },
            "memory_type": {
              "type": "string",
              "default": "semantic",
              "description": "Memory type tag (goes into metadata for recall filter)"
            },
            "metadata": {
              "type": "object",
              "default": {},
              "description": "Optional extra metadata. Writing to a session bank (thread-*) auto-appends the bank id as a thread tag so the memory is recallable by tag across banks."
            },
            "document_id": {
              "type": "string",
              "description": "Optional document id (returned as-is for targeted delete/update)"
            },
            "retain_async": {
              "type": "boolean",
              "default": false,
              "description": "Async background retain (slow; recall misses until extraction finishes)"
            },
            "update_mode": {
              "type": "string",
              "enum": [
                "replace",
                "append"
              ],
              "description": "Optional update semantics for same document_id (replace/append)"
            }
          },
          "required": [
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "hindsight.recall",
        "description": "Recall relevant memories from a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "query": {
              "type": "string",
              "description": "Recall query"
            },
            "top_k": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 100
            },
            "memory_type": {
              "type": "string",
              "description": "Optional client-side filter by memory_type"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional server-side tag filter. A thread tag (\"thread-X\" or \"session:thread-X\") triggers cross-bank recall: fan out over session banks (capped) with boolean tag groups, so session-X memories match wherever they landed."
            },
            "tags_match": {
              "type": "string",
              "default": "any",
              "description": "Tag match mode: any/all/any_strict/all_strict/exact"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      },
      {
        "name": "hindsight.reflect",
        "description": "Trigger hindsight reflection/consolidation on a bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.summarize",
        "description": "Summarize relevant memories via recall + reflection (SUMMARY injection)",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "query": {
              "type": "string",
              "description": "摘要聚焦的查询（缺省总结最近记忆）"
            },
            "top_k": {
              "type": "integer",
              "default": 20,
              "description": "recall 检索条数"
            },
            "memory_type": {
              "type": "string",
              "description": "按记忆类型过滤检索"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.delete",
        "description": "Delete memories from a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "memory_id": {
              "type": "string",
              "description": "Optional specific memory id to delete; if omitted deletes the whole bank"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.import_document",
        "description": "Chunk and import a text document into a hindsight bank",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "text": {
              "type": "string",
              "description": "Document text to import (mutually exclusive with file_path)"
            },
            "file_path": {
              "type": "string",
              "description": "Path to a .txt/.md file to import"
            },
            "knowledge_name": {
              "type": "string",
              "description": "Optional knowledge label for the imported doc"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.get_documents",
        "description": "Get raw documents (original_text + metadata) from a hindsight bank (read-only; cold-read exact recovery, not extracted facts)",
        "input_schema": {
          "properties": {
            "bank_id": {
              "type": "string",
              "description": "Memory bank id (tenant isolation key)"
            },
            "document_id": {
              "type": "string",
              "description": "Exact document id for single-document fetch (when given, tags/q are ignored)"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Server-side tag filter (e.g. ['review_id:<id>'])"
            },
            "tags_match": {
              "type": "string",
              "default": "any_strict",
              "description": "Tag match mode: any/all/any_strict/all_strict/exact"
            },
            "q": {
              "type": "string",
              "description": "Case-insensitive substring filter on document id"
            },
            "limit": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          "type": "object"
        }
      },
      {
        "name": "hindsight.list_banks",
        "description": "List all memory bank ids in the hindsight instance (bank discovery for cross-bank listing surfaces)",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/hindsight_memory_service/** (recall/stats + memory 域 + knowledge-base 域)",
        "input_schema": {
          "properties": {
            "path": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "plugin_id": {
              "type": "string"
            },
            "raw_body": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            }
          },
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "http_endpoints": [
    {
      "route_id": "hindsight_recall",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/recall",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "记忆回顾（前端记忆页接成熟 Hindsight 数据）"
    },
    {
      "route_id": "hindsight_stats",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "记忆后端状态"
    },
    {
      "route_id": "memory_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆列表（query: memory_type/limit/offset）"
    },
    {
      "route_id": "memory_search_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：关键词搜索（query: query/top_k/method）"
    },
    {
      "route_id": "memory_search_post",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/memory/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：关键词搜索（POST）"
    },
    {
      "route_id": "memory_episodes_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/episodes",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：情景记忆列表（query: page/page_size）"
    },
    {
      "route_id": "memory_episode_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/episodes/{episode_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：单个情景记忆"
    },
    {
      "route_id": "memory_semantic_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/semantic",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：语义记忆列表"
    },
    {
      "route_id": "memory_consolidate",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/memory/consolidate",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 2,
      "description": "memory 域：记忆整合"
    },
    {
      "route_id": "memory_stats",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆统计"
    },
    {
      "route_id": "memory_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/memory/{memory_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "memory 域：记忆详情"
    },
    {
      "route_id": "memory_delete",
      "method": "DELETE",
      "path": "/ext/hindsight_memory_service/memory/{memory_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "memory 域：删除记忆"
    },
    {
      "route_id": "kb_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：知识库列表"
    },
    {
      "route_id": "kb_upload",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/knowledge-base/upload",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 2,
      "description": "knowledge-base 域：上传文件（multipart file 字段；切块+向量化入库）"
    },
    {
      "route_id": "kb_stats",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：知识库统计"
    },
    {
      "route_id": "kb_check",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/check",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：检查知识库可用性"
    },
    {
      "route_id": "kb_categories_list",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/categories",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：分类列表"
    },
    {
      "route_id": "kb_category_create",
      "method": "POST",
      "path": "/ext/hindsight_memory_service/knowledge-base/categories",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "knowledge-base 域：创建分类"
    },
    {
      "route_id": "kb_category_delete",
      "method": "DELETE",
      "path": "/ext/hindsight_memory_service/knowledge-base/categories/{name}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "knowledge-base 域：删除分类"
    },
    {
      "route_id": "kb_tags",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/tags",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：标签列表"
    },
    {
      "route_id": "kb_search",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：知识库检索（query: query/top_k/category/tag，语义向量召回）"
    },
    {
      "route_id": "kb_item_get",
      "method": "GET",
      "path": "/ext/hindsight_memory_service/knowledge-base/{item_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "knowledge-base 域：知识库详情"
    },
    {
      "route_id": "kb_item_delete",
      "method": "DELETE",
      "path": "/ext/hindsight_memory_service/knowledge-base/{item_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "knowledge-base 域：删除知识库条目"
    }
  ],
  "granted_capabilities": [
    "tool-executor"
  ],
  "contributes": {
    "pages": [
      {
        "id": "memory",
        "title": "记忆",
        "icon": "🧠",
        "space": "workspace",
        "slot": "tab",
        "widget": "memory_panel",
        "description": "记忆单页（对话记忆 + 文档库两分区，/p/memory 全页可达）"
      }
    ]
  },
  "config_files": [
    {
      "id": "memory_models",
      "label": "记忆服务模型",
      "description": "记忆服务模型选型：模型 id 取自系统模型注册（config/plugins/llm/llm.yaml 的 models 键名），凭证自动随该模型的 provider 解析；留空跟随系统默认（对话/嵌入各自的 default）。保存后经 watcher respawn 生效。",
      "fields": [
        {
          "name": "llm_model",
          "label": "记忆抽取模型",
          "type": "string",
          "default": "",
          "description": "记忆事实抽取/反思用的 LLM，填 llm.yaml models 键名（如 minimax-m3）；留空跟随系统对话默认模型"
        },
        {
          "name": "embedding_model",
          "label": "记忆向量模型",
          "type": "string",
          "default": "",
          "description": "记忆向量检索用的嵌入模型，填 llm.yaml models 键名（如 bge-m3）；留空跟随系统嵌入默认模型"
        }
      ]
    }
  ],
  "mcp": {
    "transport": "stdio",
    "request_timeout_secs": 360
  }
}
