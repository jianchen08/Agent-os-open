{
  "id": "channel_dingtalk",
  "requires_services": [
    "packaging"
  ],
  "name": "DingTalk Channel",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [
      {
        "name": "dingtalk.send_message",
        "description": "Send a text message to a DingTalk user via Stream API",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "DingTalk user staff_id"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "msg_type": {
              "type": "string",
              "enum": [
                "text",
                "markdown"
              ],
              "default": "text"
            }
          },
          "required": [
            "user_id",
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "dingtalk.get_status",
        "description": "Get DingTalk channel adapter connection status",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload",
      "domain_event"
    ],
    "services": []
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "human-interaction"
  ],
  "config_files": [
    {
      "id": "settings",
      "label": "钉钉渠道连接配置",
      "fields": [
        {
          "name": "client_id",
          "label": "Client ID（AppKey）",
          "type": "string",
          "required": true,
          "description": "钉钉开放平台 Stream 模式应用 Client ID"
        },
        {
          "name": "client_secret",
          "label": "Client Secret（AppSecret）",
          "type": "string",
          "required": true,
          "description": "钉钉开放平台 Stream 模式应用 Client Secret"
        }
      ]
    }
  ]
}
