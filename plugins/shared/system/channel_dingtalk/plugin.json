{
  "id": "channel_dingtalk",
  "name": "DingTalk Channel",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [
      {
        "name": "dingtalk.send_message",
        "description": "Send a text message to a DingTalk user via Stream API",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "DingTalk user staff_id"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "msg_type": {
              "type": "string",
              "enum": [
                "text",
                "markdown"
              ],
              "default": "text"
            }
          },
          "required": [
            "user_id",
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "dingtalk.get_status",
        "description": "Get DingTalk channel adapter connection status",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": []
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5
}
