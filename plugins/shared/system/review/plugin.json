{
  "id": "review_service",
  "name": "Review Service",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "trigger_review",
        "description": "Trigger a review for a completed task",
        "ui": {
          "view_modes": [
            {
              "view_mode": "text_diff",
              "widget": "text_diff"
            },
            {
              "view_mode": "image_annotation",
              "widget": "image_annotation"
            },
            {
              "view_mode": "media_timeline",
              "widget": "media_timeline"
            }
          ]
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "metrics": {
              "type": "object",
              "default": {}
            }
          },
          "required": [
            "task_id",
            "summary"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "review_id",
            "status",
            "mode"
          ],
          "properties": {
            "review_id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "description": "running（派发）/completed（本地降级）"
            },
            "mode": {
              "type": "string",
              "description": "pipeline/local_degrade"
            },
            "pipeline_id": {
              "type": "string",
              "description": "派发分支"
            },
            "lessons_count": {
              "type": "integer",
              "description": "降级分支"
            }
          }
        }
      },
      {
        "name": "review.get_report",
        "description": "Get review report by ID",
        "input_schema": {
          "type": "object",
          "properties": {
            "review_id": {
              "type": "string"
            }
          },
          "required": [
            "review_id"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "review_id",
            "task_id",
            "summary",
            "status",
            "mode",
            "created_at"
          ],
          "properties": {
            "review_id": {
              "type": "string"
            },
            "task_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "description": "running/completed/failed"
            },
            "mode": {
              "type": "string",
              "description": "pipeline/local_degrade"
            },
            "created_at": {
              "type": "number",
              "description": "unix 秒"
            },
            "pipeline_id": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metrics": {
              "type": "object"
            },
            "lessons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "updated_at": {
              "type": "number"
            }
          }
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load"
    ]
  },
  "permissions": {},
  "priority": 50,
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "pipeline-executor"
  ],
  "http_endpoints": [
    {
      "route_id": "review_create",
      "method": "POST",
      "path": "/ext/review_service/reviews",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "reviews 域：创建审批请求（原 POST /ext/channel_api/reviews 语义——body: task_id/thread_id/session_id/tab_id/title/description/artifact_ids/priority/timeout_seconds/metadata）"
    },
    {
      "route_id": "review_list",
      "method": "GET",
      "path": "/ext/review_service/reviews",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "reviews 域：审批列表（query: task_id/limit——原 GET /ext/channel_api/reviews 语义）"
    },
    {
      "route_id": "review_media_review",
      "method": "POST",
      "path": "/ext/review_service/reviews/media-review",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 120000,
      "max_concurrency": 2,
      "description": "reviews 域：上传文件并执行媒体审阅（multipart: file + media_type；timeout 由源值 60s 放大至 120s——PyAV 解码/关键帧提取大文件可超 60s——原 POST /ext/channel_api/reviews/media-review 语义）"
    },
    {
      "route_id": "review_get",
      "method": "GET",
      "path": "/ext/review_service/reviews/{review_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "reviews 域：审批详情（原 GET /ext/channel_api/reviews/{review_id} 语义；不存在返回 {error:{code:NOT_FOUND}}）"
    },
    {
      "route_id": "review_feedback",
      "method": "POST",
      "path": "/ext/review_service/reviews/{review_id}/feedback",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "reviews 域：提交审批反馈（body: response_type/overall_comment/annotations/user_id——原 POST /ext/channel_api/reviews/{review_id}/feedback 语义）"
    },
    {
      "route_id": "review_viewed",
      "method": "POST",
      "path": "/ext/review_service/reviews/{review_id}/viewed",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "reviews 域：标记已查看（状态 pending → in_review——原 POST /ext/channel_api/reviews/{review_id}/viewed 语义）"
    },
    {
      "route_id": "review_cancel",
      "method": "POST",
      "path": "/ext/review_service/reviews/{review_id}/cancel",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "reviews 域：取消审批（body: reason——原 POST /ext/channel_api/reviews/{review_id}/cancel 语义）"
    },
    {
      "route_id": "review_media_metadata",
      "method": "GET",
      "path": "/ext/review_service/reviews/{review_id}/media-metadata",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "reviews 域：审批关联的媒体元数据（优先返回已存审阅结果，否则按 media_files 实时解析——原 GET /ext/channel_api/reviews/{review_id}/media-metadata 语义）"
    },
    {
      "route_id": "review_attachments",
      "method": "POST",
      "path": "/ext/review_service/reviews/{review_id}/attachments",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 30000,
      "max_concurrency": 2,
      "description": "reviews 域：为审批添加媒体附件（JSON body: files/auto_review，文件路径非上传；auto_review 触发媒体审阅——原 POST /ext/channel_api/reviews/{review_id}/attachments 语义）"
    }
  ]
}
