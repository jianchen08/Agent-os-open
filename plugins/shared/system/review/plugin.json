{
  "id": "review_service",
  "name": "Review Service",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "trigger_review",
        "description": "Trigger a review for a completed task",
        "ui": {
          "view_modes": [
            {
              "view_mode": "text_diff",
              "widget": "text_diff"
            },
            {
              "view_mode": "image_annotation",
              "widget": "image_annotation"
            },
            {
              "view_mode": "media_timeline",
              "widget": "media_timeline"
            }
          ]
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "metrics": {
              "type": "object",
              "default": {}
            }
          },
          "required": [
            "task_id",
            "summary"
          ]
        }
      },
      {
        "name": "review.get_report",
        "description": "Get review report by ID",
        "input_schema": {
          "type": "object",
          "properties": {
            "review_id": {
              "type": "string"
            }
          },
          "required": [
            "review_id"
          ]
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load"
    ]
  },
  "permissions": {},
  "priority": 50,
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "pipeline-executor"
  ]
}
