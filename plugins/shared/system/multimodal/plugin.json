{
  "id": "multimodal_service",
  "name": "Multimodal Service",
  "description": "多模态内容适配与语音识别服务（模型能力查询/格式转换/ASR转写）",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "multimodal.convert",
        "description": "将文本和附件转换为模型特定格式",
        "input_schema": {
          "properties": {
            "content": {
              "type": "string",
              "description": "文本内容"
            },
            "provider": {
              "type": "string",
              "default": "default",
              "description": "模型提供商（openai/anthropic/zhipu/deepseek等）"
            },
            "attachments": {
              "type": "array",
              "description": "附件列表",
              "items": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string"
                  },
                  "mime_type": {
                    "type": "string"
                  },
                  "media_type": {
                    "type": "string",
                    "enum": [
                      "image",
                      "audio",
                      "video",
                      "document"
                    ]
                  },
                  "base64_data": {
                    "type": "string",
                    "description": "Base64编码的文件内容"
                  },
                  "url": {
                    "type": "string",
                    "description": "文件URL（与base64_data二选一）"
                  }
                },
                "required": [
                  "filename",
                  "mime_type",
                  "media_type"
                ]
              }
            }
          },
          "required": [
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "multimodal.capability",
        "description": "查询模型的多模态能力",
        "input_schema": {
          "properties": {
            "model_name": {
              "type": "string",
              "description": "模型名称"
            }
          },
          "required": [
            "model_name"
          ],
          "type": "object"
        }
      },
      {
        "name": "multimodal.supported",
        "description": "检查模型是否支持多模态",
        "input_schema": {
          "properties": {
            "model_name": {
              "type": "string",
              "description": "模型名称"
            }
          },
          "required": [
            "model_name"
          ],
          "type": "object"
        }
      },
      {
        "name": "multimodal.transcribe",
        "description": "语音识别（ASR）：音频转文本",
        "input_schema": {
          "properties": {
            "audio_base64": {
              "type": "string",
              "description": "Base64编码的音频数据"
            },
            "mime_type": {
              "type": "string",
              "default": "audio/webm",
              "description": "音频MIME类型（如 audio/webm）"
            },
            "language": {
              "type": "string",
              "default": "zh-CN",
              "description": "识别语言代码（如 zh-CN）"
            }
          },
          "required": [
            "audio_base64"
          ],
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 40,
  "requires_content": 3,
  "config_files": [
    {
      "id": "media_providers",
      "path": "config/models/media_providers.yaml",
      "label": "媒体提供商配置"
    }
  ],
  "http_endpoints": [
    {
      "route_id": "mm_asr_transcriptions",
      "method": "POST",
      "path": "/ext/multimodal_service/audio/transcriptions",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 30000,
      "max_concurrency": 2,
      "description": "语音识别（ASR）：音频转文本（multipart file+language，config/models/asr.yaml 驱动；503 未配置/400 空文件/502 转写失败——原 POST /ext/channel_api/audio/transcriptions）"
    },
    {
      "route_id": "mm_files_capabilities",
      "method": "GET",
      "path": "/ext/multimodal_service/files/capabilities",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取模型文件能力（ModelCapabilityRegistry 真实能力，前端 services/api/files.ts 消费——原 GET /ext/channel_api/files/capabilities）"
    },
    {
      "route_id": "mm_files_supported_types",
      "method": "GET",
      "path": "/ext/multimodal_service/files/supported-types",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取支持的文件类型（静态宽类型声明——原 GET /ext/channel_api/files/supported-types）"
    }
  ]
}
