{
  "id": "channel_gateway",
  "name": "Multi-Channel Gateway",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "gateway.handle_message",
        "description": "Handle incoming message from any registered channel, normalize and route to pipeline",
        "input_schema": {
          "properties": {
            "channel_type": {
              "type": "string",
              "description": "Source channel type (e.g. feishu, dingtalk, wecom, qq)"
            },
            "raw_message": {
              "type": "object",
              "description": "Channel raw message dict"
            }
          },
          "required": [
            "channel_type",
            "raw_message"
          ],
          "type": "object"
        }
      },
      {
        "name": "gateway.send_response",
        "description": "Send a unified response to a specific channel via its adapter",
        "input_schema": {
          "properties": {
            "channel_type": {
              "type": "string",
              "description": "Target channel type"
            },
            "content": {
              "type": "string",
              "description": "Response content text"
            },
            "message_id": {
              "type": "string",
              "description": "Associated message ID"
            },
            "content_type": {
              "type": "string",
              "enum": [
                "text",
                "card"
              ],
              "default": "text"
            }
          },
          "required": [
            "channel_type",
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "gateway.get_adapters",
        "description": "List all registered channel adapters",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      }
    ]
  },
  "dependencies": [],
  "permissions": {},
  "priority": 50,
  "requires_content": 5
}
