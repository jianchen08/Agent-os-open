{
    "id": "memory_service",
    "name": "Memory Service",
    "version": "1.0.0",
    "plugin_type": "system",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python server.py",
    "capabilities": {
        "tools": [
            {
                "name": "memory.search",
                "description": "Search memories by query"
            },
            {
                "name": "memory.store",
                "description": "Store a new memory"
            },
            {
                "name": "memory.summarize",
                "description": "Summarize memories for context"
            }
        ],
        "resources": [
            {
                "uri": "memory://episode/*",
                "name": "Episode Memory"
            },
            {
                "uri": "memory://semantic/*",
                "name": "Semantic Memory"
            }
        ],
        "route_signals": [],
        "lifecycle_hooks": [
            "on_load",
            "on_unload"
        ]
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50,
    "requires_content": 5,
    "config_files": [
        {
            "id": "memory_storage",
            "path": "config/system/memory_storage.yaml",
            "label": "记忆存储配置"
        }
    ]
}
