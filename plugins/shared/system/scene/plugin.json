{
  "id": "scene_service",
  "name": "Scene Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "scene.create",
        "description": "Create a new scene",
        "input_schema": {
          "properties": {
            "name": {
              "type": "string",
              "description": "场景名称"
            },
            "description": {
              "type": "string",
              "default": ""
            },
            "template_id": {
              "type": "string",
              "description": "模板 ID（可选）"
            },
            "layout": {
              "type": "object",
              "description": "布局配置（可选，覆盖模板）"
            },
            "widgets": {
              "type": "array",
              "description": "组件列表（可选，覆盖模板）",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      },
      {
        "name": "scene.switch",
        "description": "Switch active scene",
        "input_schema": {
          "properties": {
            "scene_id": {
              "type": "string",
              "description": "目标场景 ID"
            }
          },
          "required": [
            "scene_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "scene.delete",
        "description": "Delete a scene",
        "input_schema": {
          "properties": {
            "scene_id": {
              "type": "string",
              "description": "要删除的场景 ID"
            }
          },
          "required": [
            "scene_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "scene.list",
        "description": "List all scenes",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "scene.get",
        "description": "Get scene details",
        "input_schema": {
          "properties": {
            "scene_id": {
              "type": "string",
              "description": "场景 ID"
            }
          },
          "required": [
            "scene_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "scene.update",
        "description": "Update scene properties",
        "input_schema": {
          "properties": {
            "scene_id": {
              "type": "string",
              "description": "场景 ID"
            },
            "name": {
              "type": "string",
              "description": "新名称（可选）"
            },
            "description": {
              "type": "string",
              "description": "新描述（可选）"
            }
          },
          "required": [
            "scene_id"
          ],
          "type": "object"
        }
      },
      {
        "name": "scene.get_active",
        "description": "Get the current active scene",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "scene.list_templates",
        "description": "List preset scene templates",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/scene_service/** (scenes domain, channel_api 拆迁批次 1)",
        "input_schema": {
          "properties": {
            "path": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "plugin_id": {
              "type": "string"
            },
            "raw_body": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            }
          },
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "http_endpoints": [
    {
      "route_id": "scenes_create",
      "method": "POST",
      "path": "/ext/scene_service/scenes",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "创建场景，可基于模板（body: name/description/template_id/layout/widgets——原 POST /ext/channel_api/scenes 语义）"
    },
    {
      "route_id": "scenes_list",
      "method": "GET",
      "path": "/ext/scene_service/scenes",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "列出所有场景（原 GET /ext/channel_api/scenes 语义）"
    },
    {
      "route_id": "scenes_templates",
      "method": "GET",
      "path": "/ext/scene_service/scenes/templates",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取场景模板列表（原 GET /ext/channel_api/scenes/templates 语义）"
    },
    {
      "route_id": "scene_get",
      "method": "GET",
      "path": "/ext/scene_service/scenes/{scene_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取场景详情（原 GET /ext/channel_api/scenes/{scene_id} 语义）"
    },
    {
      "route_id": "scene_update",
      "method": "PUT",
      "path": "/ext/scene_service/scenes/{scene_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新场景属性（body: name/description——原 PUT /ext/channel_api/scenes/{scene_id} 语义）"
    },
    {
      "route_id": "scene_delete",
      "method": "DELETE",
      "path": "/ext/scene_service/scenes/{scene_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "删除场景（原 DELETE /ext/channel_api/scenes/{scene_id} 语义）"
    },
    {
      "route_id": "scene_switch",
      "method": "POST",
      "path": "/ext/scene_service/scenes/{scene_id}/switch",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "切换活跃场景（原 POST /ext/channel_api/scenes/{scene_id}/switch 语义）"
    }
  ]
}
