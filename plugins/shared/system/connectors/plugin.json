{
  "id": "connectors_service",
  "name": "Connectors Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "connector.register",
        "description": "Register a connector instance",
        "input_schema": {
          "properties": {
            "connector_type": {
              "type": "string",
              "description": "连接器类型标识，如 vscode"
            }
          },
          "required": [
            "connector_type"
          ],
          "type": "object"
        }
      },
      {
        "name": "connector.unregister",
        "description": "Unregister a connector by type",
        "input_schema": {
          "properties": {
            "connector_type": {
              "type": "string",
              "description": "要注销的连接器类型"
            }
          },
          "required": [
            "connector_type"
          ],
          "type": "object"
        }
      },
      {
        "name": "connector.list",
        "description": "List all registered connectors",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "connector.get_active",
        "description": "Get the active connector (highest priority)",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "connector.get_status",
        "description": "Get connector status summary",
        "input_schema": {
          "properties": {
            "connector_type": {
              "type": "string",
              "description": "连接器类型（可选，不传则返回全部状态）"
            }
          },
          "type": "object"
        }
      },
      {
        "name": "connector.get_adapter_status",
        "description": "Get adapter configuration status summary",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "connector.degrade",
        "description": "Execute action with fallback degradation",
        "input_schema": {
          "properties": {
            "action_type": {
              "type": "string",
              "description": "操作类型: open_file/get_selection/show_diff/insert_content/jump_to"
            },
            "params": {
              "type": "object",
              "description": "操作参数",
              "default": {}
            }
          },
          "required": [
            "action_type"
          ],
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "config_files": [
    {
      "id": "godot",
      "path": "config/external_tools/godot.yaml",
      "label": "Godot 工具配置"
    },
    {
      "id": "vscode",
      "path": "config/external_tools/vscode.yaml",
      "label": "VS Code 工具配置"
    },
    {
      "id": "capability_adapters",
      "path": "config/capability_adapters.yaml",
      "label": "能力适配器配置"
    }
  ]
}
