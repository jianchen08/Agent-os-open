{
  "id": "approval_service",
  "name": "Approval Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "requires_services": [
    "human-interaction",
    "pipeline-executor",
    "event-bus"
  ],
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [],
    "route_signals": [
      "wait"
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "approval.create_choice",
        "description": "创建选择审批（委托 human-interaction 弹窗 + 挂起管道）",
        "input_schema": {
          "properties": {
            "title": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "run_id": {
              "type": "string",
              "description": "管道运行 ID（用于挂起管道）"
            },
            "timeout": {
              "type": "number",
              "default": 86400.0,
              "description": "审批等待超时（秒）；超时 = 拒绝（不恢复管道）。默认 24h，可经 APPROVAL_DEFAULT_TIMEOUT_SECONDS 覆盖"
            }
          },
          "required": [
            "title",
            "options"
          ],
          "type": "object"
        }
      },
      {
        "name": "approval.submit",
        "description": "提交审批结果并恢复挂起的管道",
        "input_schema": {
          "properties": {
            "request_id": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "result"
          ],
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 60,
  "ui_schema": {
    "widgets": [
      {
        "id": "approval_panel",
        "type": "review_document",
        "space": "fullscreen",
        "trigger": "on_event:approval.created",
        "props": {
          "diff_view": true,
          "annotation": true
        }
      }
    ]
  },
  "granted_capabilities": [
    "tool-executor"
  ],
  "http_endpoints": [
    {
      "route_id": "interaction_response",
      "method": "POST",
      "path": "/ext/approval_service/interaction/response",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 4,
      "description": "提交交互响应（body.request_id 必填；经 tool-executor 代理 human_interaction_tool interaction.respond——原 POST /ext/channel_api/interaction/response）"
    },
    {
      "route_id": "interaction_pending",
      "method": "GET",
      "path": "/ext/approval_service/interaction/pending",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取待处理交互请求列表（interaction.get_pending 工具代理——原 GET /ext/channel_api/interaction/pending）"
    },
    {
      "route_id": "interaction_get",
      "method": "GET",
      "path": "/ext/approval_service/interaction/{request_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取交互请求详情（不存在 404——原 GET /ext/channel_api/interaction/{request_id}）"
    },
    {
      "route_id": "interaction_approve",
      "method": "POST",
      "path": "/ext/approval_service/interaction/{request_id}/approve",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 4,
      "description": "批准交互请求（submit_response approved/approve——原 POST /ext/channel_api/interaction/{request_id}/approve）"
    },
    {
      "route_id": "interaction_deny",
      "method": "POST",
      "path": "/ext/approval_service/interaction/{request_id}/deny",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 4,
      "description": "拒绝交互请求（submit_response denied/reject——原 POST /ext/channel_api/interaction/{request_id}/deny）"
    },
    {
      "route_id": "interaction_cancel",
      "method": "POST",
      "path": "/ext/approval_service/interaction/{request_id}/cancel",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 4,
      "description": "取消交互请求（interaction.cancel 工具代理——原 POST /ext/channel_api/interaction/{request_id}/cancel）"
    },
    {
      "route_id": "interaction_viewed",
      "method": "POST",
      "path": "/ext/approval_service/interaction/{request_id}/viewed",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "标记交互请求已查看（human sidecar 无 viewed 工具，确认应答不落库——原 POST /ext/channel_api/interaction/{request_id}/viewed）"
    }
  ]
}
