{
  "id": "debug_center",
  "name": "Debug Center",
  "description": "调试中心页面插件（纯声明）：侧边栏贡献单一「调试」入口（contributes.pages，仅管理员可见 when: user.role == 'admin'），打开后为工作区面板（widget: debug_center_hub），内部切换 8 个调试页面——数据库管理/执行记录/会话/任务/用户/评估指标/LLM 请求/插件契约。页面数据经各数据源插件 HTTP 面获取（/ext/db_admin|monitoring|user_admin|evaluation_service/*），本插件无运行时能力，仅声明页面。",
  "version": "0.2.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": []
  },
  "contributes": {
    "pages": [
      {
        "id": "debug_center_hub",
        "title": "调试",
        "icon": "🛠️",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 10,
        "widget": "debug_center_hub",
        "when": "user.role == 'admin'",
        "description": "调试中心（仅管理员）：子页由 space=debug_center 声明组台（数据库/执行记录/会话/任务/用户/评估指标/LLM 请求/插件契约）"
      },
      {
        "id": "db_admin",
        "title": "数据库管理",
        "icon": "🗄️",
        "space": "debug_center",
        "slot": "tab",
        "order": 10,
        "widget": "debug_db_admin"
      },
      {
        "id": "execution_records",
        "title": "执行 Trace",
        "icon": "📋",
        "space": "debug_center",
        "slot": "tab",
        "order": 20,
        "widget": "debug_execution_records"
      },
      {
        "id": "pipeline_state",
        "title": "管道 State",
        "icon": "🧬",
        "space": "debug_center",
        "slot": "tab",
        "order": 30,
        "widget": "debug_pipeline_state"
      },
      {
        "id": "sessions",
        "title": "会话",
        "icon": "💬",
        "space": "debug_center",
        "slot": "tab",
        "order": 40,
        "widget": "debug_sessions"
      },
      {
        "id": "tasks",
        "title": "任务",
        "icon": "⚙️",
        "space": "debug_center",
        "slot": "tab",
        "order": 50,
        "widget": "debug_tasks"
      },
      {
        "id": "users",
        "title": "用户",
        "icon": "👤",
        "space": "debug_center",
        "slot": "tab",
        "order": 60,
        "widget": "debug_users"
      },
      {
        "id": "evaluation",
        "title": "评估指标",
        "icon": "📊",
        "space": "debug_center",
        "slot": "tab",
        "order": 70,
        "widget": "debug_evaluation"
      },
      {
        "id": "llm_payload",
        "title": "LLM 请求",
        "icon": "🧠",
        "space": "debug_center",
        "slot": "tab",
        "order": 80,
        "widget": "debug_llm_payload"
      },
      {
        "id": "contract_status",
        "title": "插件契约",
        "icon": "🛡️",
        "space": "debug_center",
        "slot": "tab",
        "order": 90,
        "widget": "debug_contract_status"
      }
    ]
  },
  "host_group": "light"
}
