{
  "id": "task_form",
  "name": "Task Form Service",
  "description": "任务表单声明与取数端点——新建任务表单字段（config/task_form.yaml）+ 执行 Agent/容器任务动态选项（自持服务，channel_api 零追加）",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load"
    ],
    "services": [
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for task form (declaration + agents/projects options)",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "plugin_id": {
              "type": "string"
            },
            "raw_body": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            }
          }
        }
      }
    ]
  },
  "permissions": {},
  "config_files": [
    {
      "id": "task_form",
      "path": "config/task_form.yaml",
      "label": "新建任务表单声明"
    }
  ],
  "http_endpoints": [
    {
      "route_id": "task_form_get",
      "method": "GET",
      "path": "/ext/task_form/form",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "任务表单字段声明（前端新建任务 modal 的 fieldsUri）"
    },
    {
      "route_id": "task_form_agents",
      "method": "GET",
      "path": "/ext/task_form/options/agents",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "执行 Agent 选项 {value:config_id,label:name}（读 config/agents/**/*.yaml）"
    },
    {
      "route_id": "task_form_projects",
      "method": "GET",
      "path": "/ext/task_form/options/projects",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "项目选项 {value:id,label:title}（共享 project_registry 登记行）"
    }
  ]
}
