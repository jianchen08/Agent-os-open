{
    "id": "isolation_service",
    "name": "Isolation Service",
    "version": "1.0.0",
    "plugin_type": "system",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python3 server.py",
    "capabilities": {
        "tools": [
            {"name": "isolation.create_env", "description": "创建或获取隔离环境"},
            {"name": "isolation.execute", "description": "在隔离环境中执行操作"},
            {"name": "isolation.destroy_env", "description": "销毁隔离环境"},
            {"name": "isolation.list_envs", "description": "列出隔离环境"},
            {"name": "isolation.check_policy", "description": "检查文件操作权限"},
            {"name": "isolation.checkpoint", "description": "检查点管理（创建/恢复/清理/列出）"},
            {"name": "isolation.stats", "description": "获取隔离系统统计信息"}
        ],
        "resources": [],
        "route_signals": [],
        "lifecycle_hooks": ["on_load", "on_unload"]
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50,
    "requires_content": 5
}
