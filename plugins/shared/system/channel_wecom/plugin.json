{
  "id": "channel_wecom",
  "requires_services": [
    "packaging"
  ],
  "name": "WeCom Channel",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [
      {
        "name": "wecom.send_message",
        "description": "Send a text message to a WeCom user via HTTP API",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "WeCom user UserID"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "msg_type": {
              "type": "string",
              "enum": [
                "text",
                "markdown"
              ],
              "default": "text"
            }
          },
          "required": [
            "user_id",
            "content"
          ],
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      },
      {
        "name": "wecom.handle_callback",
        "description": "Handle WeCom callback request (URL verification or message decryption)",
        "input_schema": {
          "properties": {
            "timestamp": {
              "type": "string",
              "description": "Callback timestamp"
            },
            "nonce": {
              "type": "string",
              "description": "Callback nonce"
            },
            "msg_signature": {
              "type": "string",
              "description": "Callback message signature"
            },
            "body": {
              "type": "string",
              "description": "Callback request body (encrypted XML)"
            }
          },
          "required": [
            "timestamp",
            "nonce",
            "msg_signature",
            "body"
          ],
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      },
      {
        "name": "wecom.get_status",
        "description": "Get WeCom channel adapter connection status",
        "input_schema": {
          "properties": {},
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "healthy": {
              "type": "boolean"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload",
      "domain_event"
    ],
    "services": []
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "http_endpoints": [
    {
      "route_id": "wecom_callback",
      "method": "POST",
      "path": "/ext/channel_wecom/callback",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 30000,
      "max_concurrency": 16,
      "description": "企微事件回调入口（加密 XML raw body，插件验签+解密+encrypt_response 回包）"
    },
    {
      "route_id": "wecom_verify",
      "method": "GET",
      "path": "/ext/channel_wecom/callback",
      "auth": "none",
      "handler_capability": "http.handle",
      "description": "企微 URL 验证（query 透传，插件解密 echostr 回明文）"
    }
  ],
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "human-interaction"
  ],
  "config_files": [
    {
      "id": "settings",
      "label": "企业微信渠道连接配置",
      "fields": [
        {
          "name": "corp_id",
          "label": "企业 ID（CorpID）",
          "type": "string",
          "required": true,
          "description": "企业微信管理后台「我的企业」页的企业 ID"
        },
        {
          "name": "agent_id",
          "label": "应用 AgentId",
          "type": "number",
          "default": 0,
          "description": "自建应用的 AgentId"
        },
        {
          "name": "secret",
          "label": "应用 Secret",
          "type": "string",
          "required": true,
          "description": "自建应用的 Secret"
        },
        {
          "name": "token",
          "label": "回调 Token",
          "type": "string",
          "default": "",
          "description": "接收消息回调配置的 Token（回调模式必填）"
        },
        {
          "name": "encoding_aes_key",
          "label": "回调 EncodingAESKey",
          "type": "string",
          "default": "",
          "description": "接收消息回调配置的 EncodingAESKey（回调模式必填）"
        }
      ]
    }
  ]
}
