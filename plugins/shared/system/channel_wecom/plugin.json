{
  "id": "channel_wecom",
  "name": "WeCom Channel",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "wecom.send_message",
        "description": "Send a text message to a WeCom user via HTTP API",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "WeCom user UserID"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "msg_type": {
              "type": "string",
              "enum": [
                "text",
                "markdown"
              ],
              "default": "text"
            }
          },
          "required": [
            "user_id",
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "wecom.handle_callback",
        "description": "Handle WeCom callback request (URL verification or message decryption)",
        "input_schema": {
          "properties": {
            "timestamp": {
              "type": "string",
              "description": "Callback timestamp"
            },
            "nonce": {
              "type": "string",
              "description": "Callback nonce"
            },
            "msg_signature": {
              "type": "string",
              "description": "Callback message signature"
            },
            "body": {
              "type": "string",
              "description": "Callback request body (encrypted XML)"
            }
          },
          "required": [
            "timestamp",
            "nonce",
            "msg_signature",
            "body"
          ],
          "type": "object"
        }
      },
      {
        "name": "wecom.get_status",
        "description": "Get WeCom channel adapter connection status",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "http_endpoints": [
    {
      "route_id": "wecom_callback",
      "method": "POST",
      "path": "/ext/channel_wecom/callback",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 30000,
      "max_concurrency": 16,
      "description": "企微事件回调入口（加密 XML raw body，插件验签+解密+encrypt_response 回包）"
    },
    {
      "route_id": "wecom_verify",
      "method": "GET",
      "path": "/ext/channel_wecom/callback",
      "auth": "none",
      "handler_capability": "http.handle",
      "description": "企微 URL 验证（query 透传，插件解密 echostr 回明文）"
    }
  ]
}
