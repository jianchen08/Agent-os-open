{
  "id": "channel_feishu",
  "requires_services": [
    "packaging"
  ],
  "name": "Feishu Channel",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [
      {
        "name": "feishu.send_message",
        "description": "Send a text message to a Feishu user via API",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "Feishu user open_id"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "msg_type": {
              "type": "string",
              "enum": [
                "text",
                "interactive"
              ],
              "default": "text"
            }
          },
          "required": [
            "user_id",
            "content"
          ],
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      },
      {
        "name": "feishu.send_card",
        "description": "Send an interactive card message to a Feishu user",
        "input_schema": {
          "properties": {
            "user_id": {
              "type": "string",
              "description": "Feishu user open_id"
            },
            "card_config": {
              "type": "object",
              "description": "Feishu interactive card configuration dict"
            }
          },
          "required": [
            "user_id",
            "card_config"
          ],
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      },
      {
        "name": "feishu.get_status",
        "description": "Get Feishu channel adapter connection status",
        "input_schema": {
          "properties": {},
          "type": "object"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "healthy": {
              "type": "boolean"
            }
          }
        },
        "render": {
          "card": "generic"
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload",
      "domain_event"
    ],
    "services": []
  },
  "permissions": {},
  "priority": 50,
  "requires_content": 5,
  "granted_capabilities": [
    "chat",
    "pipeline-state",
    "human-interaction"
  ],
  "config_files": [
    {
      "id": "settings",
      "label": "飞书渠道连接配置",
      "fields": [
        {
          "name": "app_id",
          "label": "App ID",
          "type": "string",
          "required": true,
          "description": "飞书开放平台自建应用 App ID（应用凭证页）"
        },
        {
          "name": "app_secret",
          "label": "App Secret",
          "type": "string",
          "required": true,
          "description": "飞书开放平台自建应用 App Secret"
        }
      ]
    }
  ]
}
