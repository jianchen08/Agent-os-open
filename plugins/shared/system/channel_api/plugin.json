{
    "id": "channel_api",
    "name": "HTTP API Channel",
    "version": "1.0.0",
    "plugin_type": "system",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python server.py",
    "capabilities": {
        "tools": [
            {"name": "api.get_status", "description": "Get HTTP API channel server status"},
            {"name": "api.list_routes", "description": "List available HTTP API routes"},
            {"name": "http.handle", "description": "HTTP endpoint handler for /ext/channel_api/** (4c migration; pilot: config domain)"}
        ],
        "resources": [],
        "route_signals": [],
        "lifecycle_hooks": ["on_load", "on_unload"]
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50,
    "requires_content": 5,
    "http_endpoints": [
        {"route_id": "config_llm_get", "method": "GET", "path": "/ext/channel_api/config/llm", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取完整 LLM 配置"},
        {"route_id": "config_llm_providers_get", "method": "GET", "path": "/ext/channel_api/config/llm/providers", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取 providers"},
        {"route_id": "config_llm_providers_create", "method": "POST", "path": "/ext/channel_api/config/llm/providers", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：新增 provider"},
        {"route_id": "config_llm_providers_update", "method": "PUT", "path": "/ext/channel_api/config/llm/providers/{provider_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新 provider"},
        {"route_id": "config_llm_providers_delete", "method": "DELETE", "path": "/ext/channel_api/config/llm/providers/{provider_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：删除 provider"},
        {"route_id": "config_llm_models_get", "method": "GET", "path": "/ext/channel_api/config/llm/models", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取 models"},
        {"route_id": "config_llm_models_create", "method": "POST", "path": "/ext/channel_api/config/llm/models", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：新增 model"},
        {"route_id": "config_llm_models_update", "method": "PUT", "path": "/ext/channel_api/config/llm/models/{model_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新 model"},
        {"route_id": "config_llm_models_delete", "method": "DELETE", "path": "/ext/channel_api/config/llm/models/{model_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：删除 model"},
        {"route_id": "config_llm_defaults_get", "method": "GET", "path": "/ext/channel_api/config/llm/defaults", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取默认模型/tier"},
        {"route_id": "config_llm_defaults_update", "method": "PUT", "path": "/ext/channel_api/config/llm/defaults", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新默认模型/tier"},
        {"route_id": "config_context_window_get", "method": "GET", "path": "/ext/channel_api/config/context-window", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取上下文窗口配置"},
        {"route_id": "config_context_window_update", "method": "PUT", "path": "/ext/channel_api/config/context-window", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新上下文窗口配置"},
        {"route_id": "config_context_window_reset", "method": "POST", "path": "/ext/channel_api/config/context-window/reset", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：重置上下文窗口配置"},
        {"route_id": "config_api_get", "method": "GET", "path": "/ext/channel_api/config/api", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取 API 运行配置"},
        {"route_id": "config_api_update", "method": "PUT", "path": "/ext/channel_api/config/api", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新 API 运行配置"},
        {"route_id": "config_concurrency_get", "method": "GET", "path": "/ext/channel_api/config/concurrency", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取并发配置"},
        {"route_id": "config_concurrency_update", "method": "PUT", "path": "/ext/channel_api/config/concurrency", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新并发配置"},
        {"route_id": "config_cost_control_get", "method": "GET", "path": "/ext/channel_api/config/cost-control", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：获取成本控制配置（注意：与 cost_control 插件不同）"},
        {"route_id": "config_cost_control_update", "method": "PUT", "path": "/ext/channel_api/config/cost-control", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：更新成本控制配置"},
        {"route_id": "config_generic_get", "method": "GET", "path": "/ext/channel_api/config/generic/{config_path:path}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "config 域：按白名单路径读通用 YAML 配置"},
        {"route_id": "config_generic_update", "method": "PUT", "path": "/ext/channel_api/config/generic/{config_path:path}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "config 域：按白名单路径写通用 YAML 配置"},
        {"route_id": "thinking_mode_health", "method": "GET", "path": "/ext/channel_api/thinking-mode/health", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "thinking-mode 域：健康检查"},
        {"route_id": "thinking_mode_models_list", "method": "GET", "path": "/ext/channel_api/thinking-mode/models", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "thinking-mode 域：列出支持思考模式的模型"},
        {"route_id": "thinking_mode_model_info", "method": "GET", "path": "/ext/channel_api/thinking-mode/models/{model_name}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "thinking-mode 域：模型思考模式详情"},
        {"route_id": "thinking_mode_check", "method": "GET", "path": "/ext/channel_api/thinking-mode/check/{model_name}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "thinking-mode 域：检查模型是否支持思考模式"},
        {"route_id": "thinking_mode_switch", "method": "POST", "path": "/ext/channel_api/thinking-mode/switch", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "thinking-mode 域：切换思考模式"},
        {"route_id": "thinking_mode_recommendations", "method": "POST", "path": "/ext/channel_api/thinking-mode/recommendations", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "thinking-mode 域：获取思考模式推荐"},
        {"route_id": "users_list", "method": "GET", "path": "/ext/channel_api/users", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "users 域：用户列表（stub）"},
        {"route_id": "users_stats", "method": "GET", "path": "/ext/channel_api/users/stats", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "users 域：用户统计（stub）"},
        {"route_id": "users_create", "method": "POST", "path": "/ext/channel_api/users", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：创建用户（stub，Query 参数）"},
        {"route_id": "users_role_put", "method": "PUT", "path": "/ext/channel_api/users/{user_id}/role", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：更新用户角色（stub）"},
        {"route_id": "users_role_patch", "method": "PATCH", "path": "/ext/channel_api/users/{user_id}/role", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：更新用户角色（PATCH，stub）"},
        {"route_id": "users_active_put", "method": "PUT", "path": "/ext/channel_api/users/{user_id}/active", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：更新用户激活状态（stub）"},
        {"route_id": "users_active_patch", "method": "PATCH", "path": "/ext/channel_api/users/{user_id}/active", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：更新用户激活状态（PATCH，stub）"},
        {"route_id": "users_delete", "method": "DELETE", "path": "/ext/channel_api/users/{user_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：删除用户（stub）"},
        {"route_id": "users_settings_get", "method": "GET", "path": "/ext/channel_api/users/settings", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "users 域：用户设置（stub）"},
        {"route_id": "users_settings_update", "method": "PUT", "path": "/ext/channel_api/users/settings", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "users 域：更新用户设置（stub）"},
        {"route_id": "sessions_total_token_usage", "method": "GET", "path": "/ext/channel_api/sessions/{session_id}/total-token-usage", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "sessions 域：会话总Token用量（stub）"},
        {"route_id": "sessions_context_token_usage", "method": "GET", "path": "/ext/channel_api/sessions/{session_id}/context-token-usage", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "sessions 域：上下文Token用量（stub）"},
        {"route_id": "client_register", "method": "POST", "path": "/ext/channel_api/client/register", "auth": "none", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "client 域：注册客户端能力声明（前端启动时调用，无认证）"},
        {"route_id": "execution_records_list", "method": "GET", "path": "/ext/channel_api/execution/records", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 8, "description": "execution 域：执行记录列表（query: session_id/parent_record_id/limit/offset）"},
        {"route_id": "execution_records_sessions", "method": "GET", "path": "/ext/channel_api/execution/records/sessions", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 8, "description": "execution 域：有记录的会话列表"},
        {"route_id": "execution_records_group_summary", "method": "GET", "path": "/ext/channel_api/execution/records/group-summary", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 8, "description": "execution 域：记录分组概要"},
        {"route_id": "execution_records_tree", "method": "GET", "path": "/ext/channel_api/execution/records/tree/{session_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 8, "description": "execution 域：执行记录树"},
        {"route_id": "execution_record_children", "method": "GET", "path": "/ext/channel_api/execution/records/{record_id}/children", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "execution 域：子执行记录（无层级，返回 []）"},
        {"route_id": "execution_record_get", "method": "GET", "path": "/ext/channel_api/execution/records/{record_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "execution 域：获取单条执行记录"},
        {"route_id": "execution_record_delete", "method": "DELETE", "path": "/ext/channel_api/execution/records/{record_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "execution 域：删除执行记录（stub）"},
        {"route_id": "execution_records_delete_by_session", "method": "DELETE", "path": "/ext/channel_api/execution/records/session/{session_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 4, "description": "execution 域：按会话删除执行记录（stub）"},
        {"route_id": "execution_records_clear_all", "method": "POST", "path": "/ext/channel_api/execution/records/clear-all", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 2, "description": "execution 域：清理所有执行记录（stub）"},
        {"route_id": "modules_ui_list", "method": "GET", "path": "/ext/channel_api/modules/ui", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "modules/ui 域：所有模块 UI Schema 列表（query: client_type 过滤）"},
        {"route_id": "modules_ui_get", "method": "GET", "path": "/ext/channel_api/modules/ui/{module_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "modules/ui 域：指定模块 UI Schema"},
        {"route_id": "memory_list", "method": "GET", "path": "/ext/channel_api/memory", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：记忆列表（query: memory_type/limit/offset）"},
        {"route_id": "memory_search_get", "method": "GET", "path": "/ext/channel_api/memory/search", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：关键词搜索（query: query/top_k/method）"},
        {"route_id": "memory_search_post", "method": "POST", "path": "/ext/channel_api/memory/search", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：关键词搜索（POST）"},
        {"route_id": "memory_episodes_list", "method": "GET", "path": "/ext/channel_api/memory/episodes", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：情景记忆列表（query: page/page_size）"},
        {"route_id": "memory_episode_get", "method": "GET", "path": "/ext/channel_api/memory/episodes/{episode_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：单个情景记忆"},
        {"route_id": "memory_semantic_list", "method": "GET", "path": "/ext/channel_api/memory/semantic", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：语义记忆列表"},
        {"route_id": "memory_consolidate", "method": "POST", "path": "/ext/channel_api/memory/consolidate", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 10000, "max_concurrency": 2, "description": "memory 域：记忆整合"},
        {"route_id": "memory_stats", "method": "GET", "path": "/ext/channel_api/memory/stats", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：记忆统计"},
        {"route_id": "memory_get", "method": "GET", "path": "/ext/channel_api/memory/{memory_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 8, "description": "memory 域：记忆详情"},
        {"route_id": "memory_delete", "method": "DELETE", "path": "/ext/channel_api/memory/{memory_id}", "auth": "user", "handler_capability": "http.handle", "timeout_ms": 5000, "max_concurrency": 4, "description": "memory 域：删除记忆"}
    ]
}
