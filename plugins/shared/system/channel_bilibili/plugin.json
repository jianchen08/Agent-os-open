{
  "id": "channel_bilibili",
  "name": "Bilibili Live Channel",
  "description": "B 站直播通道：开播/下播/改标题[AI]/人气轮询 + blivedm 弹幕面（可选依赖优雅降级）",
  "version": "0.1.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "services": [
      {
        "name": "bili.start_live",
        "description": "开播：返回 RTMP 推流地址与推流码（cookie 未配置显式报错）",
        "input_schema": {"type": "object", "properties": {}},
        "output_schema": {
          "type": "object",
          "properties": {
            "addr": {"type": "string"},
            "code": {"type": "string"}
          },
          "required": ["addr", "code"]
        }
      },
      {
        "name": "bili.stop_live",
        "description": "下播",
        "input_schema": {"type": "object", "properties": {}},
        "output_schema": {
          "type": "object",
          "properties": {"ok": {"type": "boolean"}},
          "required": ["ok"]
        }
      },
      {
        "name": "bili.update_title",
        "description": "改标题（[AI] 前缀纪律：缺失自动补）",
        "input_schema": {
          "type": "object",
          "properties": {"title": {"type": "string"}},
          "required": ["title"]
        },
        "output_schema": {
          "type": "object",
          "properties": {"ok": {"type": "boolean"}, "title": {"type": "string"}},
          "required": ["ok"]
        }
      },
      {
        "name": "bili.get_popularity",
        "description": "房间人气值轮询（director 无人收敛判据输入）",
        "input_schema": {"type": "object", "properties": {}},
        "output_schema": {
          "type": "object",
          "properties": {"popularity": {"type": "integer"}},
          "required": ["popularity"]
        }
      },
      {
        "name": "bili.danmaku_status",
        "description": "弹幕面可用性（blivedm/cookie 缺失优雅降级）",
        "input_schema": {"type": "object", "properties": {}},
        "output_schema": {
          "type": "object",
          "properties": {
            "available": {"type": "boolean"},
            "reason": {"type": "string"}
          },
          "required": ["available"]
        }
      }
    ],
    "lifecycle_hooks": ["on_load", "on_unload"]
  },
  "permissions": {},
  "priority": 50
}
