{
  "id": "monitoring",
  "name": "Monitoring Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "monitoring.get_metrics",
        "description": "Get current system performance metrics (CPU, memory, disk, network, LLM, tools, tasks)",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "monitoring.get_health",
        "description": "Get system health status with bottleneck detection",
        "input_schema": {
          "properties": {},
          "type": "object"
        }
      },
      {
        "name": "monitoring.record_llm_request",
        "description": "Record an LLM API call for usage tracking",
        "input_schema": {
          "properties": {
            "response_time": {
              "type": "number",
              "description": "Response time in seconds"
            },
            "error": {
              "type": "boolean",
              "default": false,
              "description": "Whether the request errored"
            }
          },
          "required": [
            "response_time"
          ],
          "type": "object"
        }
      },
      {
        "name": "monitoring.record_tool_execution",
        "description": "Record a tool execution for performance tracking",
        "input_schema": {
          "properties": {
            "execution_time": {
              "type": "number",
              "description": "Execution time in seconds"
            },
            "cache_hit": {
              "type": "boolean",
              "default": false
            },
            "error": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "execution_time"
          ],
          "type": "object"
        }
      },
      {
        "name": "monitoring.update_task_status",
        "description": "Update task execution metrics (pending, running, completed counts)",
        "input_schema": {
          "properties": {
            "pending": {
              "type": "integer",
              "description": "Number of pending tasks"
            },
            "running": {
              "type": "integer",
              "description": "Number of running tasks"
            },
            "completed": {
              "type": "integer",
              "description": "Number of completed tasks"
            },
            "task_time": {
              "type": "number",
              "default": 0,
              "description": "Task execution time in seconds"
            }
          },
          "required": [
            "pending",
            "running",
            "completed"
          ],
          "type": "object"
        }
      }
    ]
  },
  "dependencies": [],
  "permissions": {},
  "priority": 40,
  "requires_content": 3,
  "http_endpoints": [
    {
      "route_id": "mon_system_metrics",
      "method": "GET",
      "path": "/ext/monitoring/system/metrics",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get system performance metrics (CPU/memory/disk, psutil real data)"
    },
    {
      "route_id": "mon_task_statistics",
      "method": "GET",
      "path": "/ext/monitoring/tasks/statistics",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get task execution statistics"
    },
    {
      "route_id": "mon_tasks",
      "method": "GET",
      "path": "/ext/monitoring/tasks",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get task list (supports ?page=&page_size=&status=)"
    },
    {
      "route_id": "mon_token_usage",
      "method": "GET",
      "path": "/ext/monitoring/token-usage",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get token usage statistics"
    },
    {
      "route_id": "mon_cache_stats",
      "method": "GET",
      "path": "/ext/monitoring/cache-stats",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get cache hit/miss statistics"
    },
    {
      "route_id": "mon_payload_diag_list",
      "method": "GET",
      "path": "/ext/monitoring/payload-diag",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "List LLM payload diagnostic snapshots (from logs/payload_diag/)"
    },
    {
      "route_id": "mon_payload_diag_get",
      "method": "GET",
      "path": "/ext/monitoring/payload-diag/file",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Get one payload snapshot file content (?name=filename.json)"
    },
    {
      "route_id": "mon_tool_calls",
      "method": "GET",
      "path": "/ext/monitoring/tool-calls",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 8000,
      "max_concurrency": 4,
      "description": "Query tool call records from traces table (?tool_name=&status=&min_duration=&limit=)"
    },
    {
      "route_id": "mon_payload_diag_page",
      "method": "GET",
      "path": "/ext/monitoring/page/payload-diag",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Webview HTML page: LLM payload diagnostic viewer"
    },
    {
      "route_id": "mon_tool_calls_page",
      "method": "GET",
      "path": "/ext/monitoring/page/tool-calls",
      "auth": "none",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Webview HTML page: tool call records viewer"
    }
  ],
  "ui_schema": {
    "widgets": [
      { "id": "resource_cpu", "type": "status_card", "space": "monitoring", "order": 10,
        "props": { "title": "系统资源", "label": "CPU",
          "datasourceUri": "/ext/monitoring/system/metrics", "valueKey": "metrics.cpu_usage",
          "refresh": { "type": "poll", "intervalSeconds": 10 } } },
      { "id": "resource_mem", "type": "status_card", "space": "monitoring", "order": 20,
        "props": { "label": "内存", "datasourceUri": "/ext/monitoring/system/metrics",
          "valueKey": "metrics.memory.usage_percent", "refresh": { "type": "poll", "intervalSeconds": 10 } } },
      { "id": "resource_disk", "type": "status_card", "space": "monitoring", "order": 30,
        "props": { "label": "磁盘", "datasourceUri": "/ext/monitoring/system/metrics",
          "valueKey": "metrics.disk.usage_percent", "refresh": { "type": "poll", "intervalSeconds": 10 } } },
      { "id": "token_card", "type": "status_card", "space": "monitoring", "order": 40,
        "props": { "title": "LLM 请求", "label": "请求数", "datasourceUri": "/ext/monitoring/token-usage",
          "valueKey": "token_usage.request_count", "refresh": { "type": "poll", "intervalSeconds": 30 } } },
      { "id": "tasks_table", "type": "table", "space": "monitoring", "order": 50,
        "props": { "title": "最近任务", "datasourceUri": "/ext/monitoring/tasks", "pageSize": 10,
          "refresh": { "type": "poll", "intervalSeconds": 30 } } }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "monitoring",
        "title": "监控",
        "icon": "📊",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 20,
        "path": "/monitoring",
        "widget": "widget_stage",
        "props": {
          "space": "monitoring"
        },
        "description": "系统监控（widget 化：资源卡+任务表声明组合，替代硬编码 MonitoringPage）"
      },
      {
        "id": "payload_diag",
        "title": "Payload 诊断",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/payload_diag",
        "icon": "description",
        "order": 61,
        "widget": "webview",
        "props": {
          "pluginId": "monitoring",
          "htmlPath": "/page/payload-diag",
          "widgetId": "payload_diag"
        }
      },
      {
        "id": "tool_call_records",
        "title": "工具调用记录",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/tool_call_records",
        "icon": "history",
        "order": 62,
        "widget": "webview",
        "props": {
          "pluginId": "monitoring",
          "htmlPath": "/page/tool-calls",
          "widgetId": "tool_call_records"
        }
      }
    ]
  }
}
