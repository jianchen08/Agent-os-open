{
  "id": "llm_service",
  "name": "LLM Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "mcp": {
    "transport": "stdio",
    "request_timeout_secs": 3600
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "llm.complete_stream",
        "description": "Send a streaming completion request to LLM with messages and optional tools (stream events via event-bus)",
        "input_schema": {
          "properties": {
            "model": {
              "type": "string",
              "description": "LiteLLM model identifier (e.g. 'zai/glm-4-plus')"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Chat messages array"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Optional tool schemas for function calling"
            },
            "temperature": {
              "type": "number",
              "default": 0.7
            },
            "max_tokens": {
              "type": "integer",
              "default": 4096
            }
          },
          "required": [
            "model",
            "messages"
          ],
          "type": "object"
        }
      },
      {
        "name": "llm.health_check",
        "description": "Check if a specific model is healthy and available",
        "input_schema": {
          "properties": {
            "model": {
              "type": "string",
              "description": "Model identifier to check"
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        }
      },
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/llm_service/** (thinking-mode + config/llm domains, channel_api 拆迁批次 1)",
        "input_schema": {
          "properties": {
            "path": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "plugin_id": {
              "type": "string"
            },
            "raw_body": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            }
          },
          "type": "object"
        }
      }
    ]
  },
  "permissions": {},
  "priority": 30,
  "requires_content": 3,
  "granted_capabilities": [
    "event-bus",
    "pipeline-executor"
  ],
  "config_files": [
    {
      "id": "llm",
      "path": "config/models/llm.yaml",
      "label": "LLM 模型配置",
      "settings": false
    },
    {
      "id": "embedding",
      "path": "config/models/embedding.yaml",
      "label": "向量模型配置",
      "settings": false
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "llm_settings",
        "title": "模型设置",
        "icon": "🤖",
        "space": "settings",
        "slot": "nav",
        "widget": "llm_settings",
        "order": 10,
        "description": "配置大语言模型提供商、密钥与模型（预置提供者填入 API Key 即可用）"
      }
    ]
  },
  "http_endpoints": [
    {
      "route_id": "thinking_mode_health",
      "method": "GET",
      "path": "/ext/llm_service/thinking-mode/healthz",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "思考模式服务健康检查（原 GET /ext/channel_api/thinking-mode/healthz 语义）"
    },
    {
      "route_id": "thinking_mode_models_list",
      "method": "GET",
      "path": "/ext/llm_service/thinking-mode/models",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取支持思考模式的模型列表（原 GET /ext/channel_api/thinking-mode/models 语义）"
    },
    {
      "route_id": "thinking_mode_model_info",
      "method": "GET",
      "path": "/ext/llm_service/thinking-mode/models/{model_name}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取模型思考模式信息（原 GET /ext/channel_api/thinking-mode/models/{model_name} 语义）"
    },
    {
      "route_id": "thinking_mode_check",
      "method": "GET",
      "path": "/ext/llm_service/thinking-mode/check/{model_name}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "检查模型是否支持思考模式（原 GET /ext/channel_api/thinking-mode/check/{model_name} 语义）"
    },
    {
      "route_id": "thinking_mode_switch",
      "method": "POST",
      "path": "/ext/llm_service/thinking-mode/switch",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "切换思考模式，返回目标参数（body: current_model/enable_thinking——原 POST /ext/channel_api/thinking-mode/switch 语义）"
    },
    {
      "route_id": "thinking_mode_recommendations",
      "method": "POST",
      "path": "/ext/llm_service/thinking-mode/recommendations",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取思考模式推荐（原 POST /ext/channel_api/thinking-mode/recommendations 语义）"
    },
    {
      "route_id": "config_llm_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取完整 LLM 配置（providers/models 脱敏 + key 状态——原 GET /ext/channel_api/config/llm 语义）"
    },
    {
      "route_id": "config_llm_providers_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm/providers",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取提供商列表（原 GET /ext/channel_api/config/llm/providers 语义）"
    },
    {
      "route_id": "config_llm_providers_create",
      "method": "POST",
      "path": "/ext/llm_service/config/llm/providers",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "添加提供商（body: provider_id/config，明文 api_key 落 .env——原 POST /ext/channel_api/config/llm/providers 语义）"
    },
    {
      "route_id": "config_llm_providers_update",
      "method": "PUT",
      "path": "/ext/llm_service/config/llm/providers/{provider_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新提供商配置（body: config——原 PUT /ext/channel_api/config/llm/providers/{provider_id} 语义）"
    },
    {
      "route_id": "config_llm_providers_delete",
      "method": "DELETE",
      "path": "/ext/llm_service/config/llm/providers/{provider_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "删除提供商（原 DELETE /ext/channel_api/config/llm/providers/{provider_id} 语义）"
    },
    {
      "route_id": "config_llm_provider_types_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm/provider-types",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取 litellm 支持的提供者类型清单（原 GET /ext/channel_api/config/llm/provider-types 语义）"
    },
    {
      "route_id": "config_llm_providers_remote_models_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm/providers/{provider_id}/remote-models",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 15000,
      "max_concurrency": 4,
      "description": "从提供商 API 实时拉取可用模型（原 GET /ext/channel_api/config/llm/providers/{provider_id}/remote-models 语义）"
    },
    {
      "route_id": "config_llm_models_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm/models",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取模型列表（api_key 脱敏——原 GET /ext/channel_api/config/llm/models 语义）"
    },
    {
      "route_id": "config_llm_models_create",
      "method": "POST",
      "path": "/ext/llm_service/config/llm/models",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "添加模型（body: models 字典——原 POST /ext/channel_api/config/llm/models 语义）"
    },
    {
      "route_id": "config_llm_models_update",
      "method": "PUT",
      "path": "/ext/llm_service/config/llm/models/{model_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新模型配置（body: config——原 PUT /ext/channel_api/config/llm/models/{model_id} 语义）"
    },
    {
      "route_id": "config_llm_models_delete",
      "method": "DELETE",
      "path": "/ext/llm_service/config/llm/models/{model_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "删除模型（原 DELETE /ext/channel_api/config/llm/models/{model_id} 语义）"
    },
    {
      "route_id": "config_llm_defaults_get",
      "method": "GET",
      "path": "/ext/llm_service/config/llm/defaults",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取默认模型配置（原 GET /ext/channel_api/config/llm/defaults 语义）"
    },
    {
      "route_id": "config_llm_defaults_update",
      "method": "PUT",
      "path": "/ext/llm_service/config/llm/defaults",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新默认模型配置（body: chat/embedding/tiers 可空部分更新——原 PUT /ext/channel_api/config/llm/defaults 语义）"
    }
  ]
}
