{
  "id": "acp_quota_pool",
  "name": "ACP Quota Pool",
  "description": "ACP 额度池——外部编码 agent 统一派发（技能包载荷形态）：载荷 = SKILL.md 路由口径（任务分级 S0/S1/S2、性能基础线、选型优先序）+ providers.toml 注册表 + scripts/acp_pool.py 派发与记账 CLI（双后端：acp=官方 agent-client-protocol SDK 原生握手，现役 opencode；oneshot=一次性 CLI spawn 如 zcode -p，无会话）。on_load 把载荷镜像到 <USER_ROOT>/skills/acp-quota-pool/（播种机制只认仓根/mode_* 包/用户根三类源，插件载荷经此入链）。额度账本 v0 落用户空间 JSON（被动记账：派发计数/最近会话/撞墙归类）。on_load 同刀探活 CPA 网关（2026-11-21 拉起面单点化：拉起职责移交 llm_provider_gateway provider 插件——捆绑网关自包含拉起 + via=plugin 出口，本插件仅探活与控制台页）；插件页 acp_gateway_console = webview 直嵌网关管理页（网关不在时显示移交提示，登录由用户在页内完成，管理密钥不入仓不入前端）。网关参数单源 config_files[gateway]。",
  "version": "0.2.3",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "config_files": [
    {
      "id": "gateway",
      "path": "config/plugins/acp_quota_pool/gateway.yaml",
      "label": "ACP 网关配置",
      "fields": [
        {
          "name": "base_url",
          "type": "string",
          "label": "网关 base_url"
        },
        {
          "name": "health_timeout_secs",
          "type": "number",
          "label": "探活超时（秒）"
        }
      ]
    }
  ],
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load"
    ]
  },
  "http_endpoints": [
    {
      "route_id": "acp_gateway_status",
      "method": "GET",
      "path": "/ext/acp_quota_pool/gateway/status",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "网关健康状态（GET 管理页探活；返回 running/base_url/management_url/detail，密钥不参与）"
    },
    {
      "route_id": "acp_gateway_start",
      "method": "POST",
      "path": "/ext/acp_quota_pool/gateway/start",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 15000,
      "max_concurrency": 2,
      "description": "网关探活（原拉起语义 2026-11-21 移交 llm_provider_gateway：命中返回 running，不在返回 handoff 并指向新拉起面）"
    },
    {
      "route_id": "acp_console_page",
      "method": "GET",
      "path": "/ext/acp_quota_pool/page/console",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Webview HTML 页：网关控制台（状态检查→运行态显式卡片+新窗口打开管理页/未运行移交提示，零数据渲染，不自导航嵌页）"
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "acp_gateway_console",
        "title": "额度网关",
        "icon": "🏦",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/acp_gateway_console",
        "widget": "webview",
        "order": 63,
        "props": {
          "pluginId": "acp_quota_pool",
          "htmlPath": "/page/console",
          "widgetId": "acp_gateway_console"
        },
        "description": "CPA 网关管理控制台（webview 卡片；网关运行时新窗口打开管理页，未运行时显示移交提示——拉起由 llm_provider_gateway 承接，不自导航嵌页）"
      }
    ]
  },
  "permissions": {
    "filesystem": {
      "read_paths": [
        "*"
      ],
      "write_paths": [
        "*"
      ]
    },
    "network": {
      "allowed_hosts": [
        "127.0.0.1",
        "localhost"
      ]
    },
    "env_vars": [
      "PATH",
      "APPDATA",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "AGENTOS_USER_ROOT",
      "AGENTOS_DATA_DIR",
      "ACP_GATEWAY_BASE_URL"
    ],
    "system_calls": [
      "opencode",
      "node",
      "cmd"
    ]
  },
  "priority": 50
}
