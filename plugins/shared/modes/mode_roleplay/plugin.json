{
  "id": "mode_roleplay",
  "name": "Mode Roleplay",
  "version": "1.2.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "description": "角色扮演模式出厂种子：模式元数据服务面（mode.describe / mode.get_profile）+ 工作区面板数据面（角色卡/世界书/开演记录；宿主融合——对话回归对话框、卡 theme/avatar 经 theme.apply 随卡切主题、面板主题跟宿主 token）+ 写动作（开演/重新生成经 task_submit 真派发、session_id 送入会话线程），profile 与示例卡/世界书随包内打包",
  "permissions": {},
  "priority": 45,
  "host_group": "light",
  "capabilities": {
    "tools": [],
    "services": [
      {
        "name": "mode.describe",
        "description": "返回角色扮演模式元数据（chain/权重/预算/profile 路径/panel_page_id）",
        "input_schema": {
          "type": "object",
          "properties": {}
        },
        "output_schema": {
          "type": "object",
          "required": [
            "mode",
            "name",
            "chain",
            "weights",
            "budget",
            "profile_path",
            "panel_page_id"
          ],
          "properties": {
            "mode": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "chain": {
              "type": "object"
            },
            "weights": {
              "type": "object"
            },
            "budget": {
              "type": "object"
            },
            "profile_path": {
              "type": "string"
            },
            "panel_page_id": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "mode.get_profile",
        "description": "返回角色扮演模式包内 profile.yaml 解析后的内容",
        "input_schema": {
          "type": "object",
          "properties": {}
        },
        "output_schema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string"
            }
          }
        }
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load"
    ]
  },
  "http_endpoints": [
    {
      "route_id": "mode_roleplay_panel_page",
      "method": "GET",
      "path": "/ext/mode_roleplay/page/roleplay-panel",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Webview HTML page: 角色扮演面板（插件自带 webview 页）"
    },
    {
      "route_id": "mode_roleplay_data_bootstrap",
      "method": "GET",
      "path": "/ext/mode_roleplay/data/bootstrap",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "面板头元数据（模式名/链/panel_page_id）"
    },
    {
      "route_id": "mode_roleplay_data_sessions",
      "method": "GET",
      "path": "/ext/mode_roleplay/data/sessions",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "本模式会话列表（pipeline-state mode 键过滤归一）"
    },
    {
      "route_id": "mode_roleplay_data_messages",
      "method": "GET",
      "path": "/ext/mode_roleplay/data/messages",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "会话对话流（messages.list 按 pipeline_id，query 必带 pipeline_id）"
    },
    {
      "route_id": "mode_roleplay_data_cards",
      "method": "GET",
      "path": "/ext/mode_roleplay/data/cards",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "角色卡画廊（包内 agents/card_*.yaml，ST V2 字段子集 + theme/avatar 宿主融合字段）"
    },
    {
      "route_id": "mode_roleplay_data_lorebooks",
      "method": "GET",
      "path": "/ext/mode_roleplay/data/lorebooks",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "世界书条目表（包内 lorebooks/*.yaml，ST World Info 子集）"
    },
    {
      "route_id": "mode_roleplay_action_play",
      "method": "POST",
      "path": "/ext/mode_roleplay/data/actions/play",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 20000,
      "max_concurrency": 4,
      "description": "写动作：以此角色开演（task_submit 派发，target=卡 agent 键）"
    },
    {
      "route_id": "mode_roleplay_action_regenerate",
      "method": "POST",
      "path": "/ext/mode_roleplay/data/actions/regenerate",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 20000,
      "max_concurrency": 4,
      "description": "写动作：重新生成末条回复变体（swipe 一期裁定，task_submit 派发）"
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "roleplay_studio",
        "title": "角色扮演",
        "icon": "🎭",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/roleplay_studio",
        "widget": "webview",
        "props": {
          "pluginId": "mode_roleplay",
          "htmlPath": "/page/roleplay-panel",
          "widgetId": "roleplay_studio"
        },
        "order": 30,
        "description": "角色扮演模式面板：角色卡/世界书/开演记录（对话在聊天区）",
        "mode": "roleplay",
        "detachable": {
          "popout": true,
          "childWindow": true,
          "defaultSize": {
            "w": 1080,
            "h": 680
          },
          "minSize": {
            "w": 720,
            "h": 480
          }
        }
      }
    ]
  },
  "ui_schema": {
    "widgets": [
      {
        "id": "mode_opt_roleplay",
        "type": "select-option",
        "space": "chat-input",
        "order": 10,
        "props": {
          "target": "task_mode",
          "value": "roleplay",
          "label": "角色扮演",
          "icon": "🎭"
        }
      }
    ]
  }
}
