{
  "id": "resource_search_tool",
  "requires_services": [
    "packaging",
    "agent.list",
    "agent.get",
    "skill.list",
    "skill.get",
    "tool-executor"
  ],
  "name": "Resource Search & Dynamic Tool",
  "description": "搜索系统内 Agent、工具、Skill 资源，并转发调用搜索引入的动态工具",
  "version": "1.2.1",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "metrics_class": "tool",
    "tools": [
      {
        "name": "resource_search",
        "description": "搜索系统内 Agent、工具、Skill 资源。工具两步法：mode='detailed' 检索拿 tool_defs 定义（含真实 input_schema）→ 经 call_tool(tool=<目标工具名>, arguments={...}) 转发执行——动态工具不进原生工具列表，每次调用按目标工具名判定权限；查无此工具则反馈调度方",
        "render": {
          "card": "table"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "resource_type": {
              "type": "string",
              "enum": [
                "agent",
                "tool",
                "skill",
                "all"
              ],
              "description": "资源类型：agent/tool/skill/all"
            },
            "query": {
              "type": "string",
              "description": "搜索关键词（支持子串匹配；为空或通配符 *,all,所有 时返回全部）"
            },
            "mode": {
              "type": "string",
              "enum": [
                "simple",
                "detailed"
              ],
              "default": "simple",
              "description": "simple=列出匹配资源；detailed=返回完整描述（skill 返回 SKILL.md 内容，agent 返回 recommended_metrics；tool 返回含真实 input_schema 的 tool_defs 可执行定义）。注意：搜到的工具不会自动加载进工具面，须用 detailed 拿到 tool_defs 后经 call_tool 调用。"
            },
            "filters": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "description": "按分类过滤（仅 tool 类型生效，匹配 plugin.json 的 plugin_type）"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "all"
                  ],
                  "description": "按级别过滤（仅 agent 类型生效；system≈L1，user≈L2/L3）"
                },
                "language": {
                  "type": "string",
                  "description": "按语言过滤 Skill 脚本：python/nodejs/bash/powershell"
                }
              },
              "description": "可选过滤条件"
            },
            "limit": {
              "type": "integer",
              "default": 20,
              "maximum": 20,
              "description": "返回数量，默认20"
            }
          },
          "required": [
            "resource_type"
          ]
        },
        "output_schema": {
          "type": "object",
          "description": "三类资源（agent/tool/skill）表格式结果 + 工具结构化定义族（tool_defs/tool_defs_count/tool_defs_errors）；全部键条件出现（无命中即缺席）",
          "properties": {
            "agent_h": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "agent 表头"
            },
            "agent_d": {
              "type": "array",
              "items": {
                "type": "array"
              },
              "description": "agent 行"
            },
            "agent_c": {
              "type": "integer"
            },
            "tool_h": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tool_d": {
              "type": "array",
              "items": {
                "type": "array"
              }
            },
            "tool_c": {
              "type": "integer"
            },
            "tool_defs": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "工具可执行定义项数组：name/description/input_schema（type=object）/plugin_id/source（code=插件声明工具，mcp=external MCP 目标），可选 output_schema/render；据以经 call_tool 调用"
            },
            "tool_defs_count": {
              "type": "integer",
              "description": "与 tool_c 对称的定义项计数"
            },
            "tool_defs_errors": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "被 fail-closed 拒收的定义条目 + 原因（name/reason）；缺 input_schema 或非 object 一律拒收，不补空对象"
            },
            "skill_h": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skill_d": {
              "type": "array",
              "items": {
                "type": "array"
              }
            },
            "skill_c": {
              "type": "integer"
            }
          }
        }
      },
      {
        "name": "call_tool",
        "description": "调用资源搜索引入的动态工具：先用 resource_search(mode='detailed') 拿 tool_defs 定义，再按该定义传工具名与参数（参数直接透传，合法性由目标工具终审）。动态工具不进原生工具列表，每次调用按目标工具走权限判定。定义长期有效：引入一次即可反复调用（跨轮与跨 run 持久），无需重复搜索。",
        "render": {
          "card": "generic"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "description": "目标工具名，须是已由 resource_search(mode='detailed') 引入过的动态工具之一（引入一次长期有效，跨轮与跨 run 持久，不必重搜）"
            },
            "arguments": {
              "type": "object",
              "description": "目标工具参数对象，结构遵循该工具 tool_defs 里的 input_schema"
            }
          },
          "required": [
            "tool",
            "arguments"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "description": "目标工具执行结果（成功透传其输出并补 tool_name）；失败为 {success: false, error, error_code} 显式失败信封",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "error_code": {
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            }
          }
        },
        "tags": [
          "tool",
          "dynamic",
          "system"
        ]
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 30,
  "config_files": [
    {
      "id": "builtin_tools_config",
      "path": "config/tools/builtin_tools_config.yaml",
      "label": "内置工具配置"
    },
    {
      "id": "resource_search",
      "path": "config/plugins/search/resource_search.yaml",
      "label": "资源搜索配置"
    }
  ],
  "host_group": "light"
}
