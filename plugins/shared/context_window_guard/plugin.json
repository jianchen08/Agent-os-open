{
  "capabilities": {
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "route_signals": [],
    "tools": [],
    "call_timeout_seconds": 1800
  },
  "config_files": [
    {
      "description": "配置真值内联于本 manifest 的 fields.default（单一真值裁定 2026-09-02：不引用磁盘文件，保存经 PUT 直接写回本 manifest）",
      "fields": [
        {
          "default": 0.5,
          "description": "上下文占用超过该比例触发压缩",
          "label": "压缩触发比例",
          "max": 1,
          "min": 0,
          "name": "compress_trigger_ratio",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.18,
          "description": "最近原文段保留预算（占窗口比例）",
          "label": "预算·最近原文",
          "max": 1,
          "min": 0,
          "name": "budgets.recent",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.08,
          "description": "L1 过程摘要块预算（占窗口比例）",
          "label": "预算·L1 过程块",
          "max": 1,
          "min": 0,
          "name": "budgets.l1",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.05,
          "description": "L2 三元组块预算（占窗口比例）",
          "label": "预算·L2 过程块",
          "max": 1,
          "min": 0,
          "name": "budgets.l2",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": true,
          "label": "启用上下文压缩",
          "name": "compression.enabled",
          "type": "toggle"
        },
        {
          "default": "",
          "description": "压缩摘要模型：留空=跟随管道当前模型（fork 前缀同模型命中供应商前缀缓存，2026-10-24 裁定）；显式填写=固定压缩模型",
          "label": "压缩模型",
          "name": "compression.model",
          "type": "string"
        }
      ],
      "id": "context_window",
      "label": "上下文窗口配置"
    }
  ],
  "contributes": {
    "chatMessages": [
      {
        "description": "压缩段消息卡（渲染本体）：折叠态一行细条「已压缩 N 条消息」，展开态平铺过程摘要与状态快照（同段块内容由宿主合并下行，卡内解析 <compressed>/<current_state> 标签）；被压原文由宿主按 compression_ref.segment_id 段取数后在卡下方还原为只读聊天行",
        "id": "compression_card",
        "props": {
          "htmlPath": "/assets/cards/compression.html",
          "pluginId": "pipeline_context_window_guard"
        },
        "title": "压缩卡"
      }
    ]
  },
  "entry": "python server.py",
  "host_group": "light",
  "host_type": "sidecar",
  "id": "pipeline_context_window_guard",
  "invoke_entry": "context_window_guard.execute",
  "language": "python",
  "name": "Context Window Guard",
  "permissions": {},
  "plugin_type": "pipeline",
  "priority": 50,
  "requires_services": [
    "packaging"
  ],
  "export_fields": [
    "context.compression"
  ],
  "state": {
    "reads": [
      "messages",
      "system_message",
      "context_window",
      "context_guard.trigger_ratio",
      "llm_usage",
      "llm_model",
      "llm_model_id",
      "track.llm_usage",
      "_tracked_msg_count",
      "user_id",
      "context.session_id"
    ]
  },
  "version": "1.1.5"
}
