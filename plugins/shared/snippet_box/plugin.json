{
  "id": "snippet_box",
  "name": "SnippetBox",
  "description": "片段速查库：LLM 片段增删查工具 + 页面看板",
  "version": "0.1.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "snippet_box",
        "description": "片段速查库：增删查代码/命令片段（add/search/list/delete），数据持久化在插件目录",
        "category": "system",
        "render": {
          "card": "form",
          "title": "SnippetBox"
        },
        "input_schema": {
          "type": "object",
          "required": ["action"],
          "properties": {
            "action": {
              "type": "string",
              "enum": ["add", "search", "list", "delete"],
              "description": "操作：add 新增 / search 检索 / list 全列 / delete 删除"
            },
            "title": {
              "type": "string",
              "description": "片段标题；search 时作为查询词（对 title/tags/content 做子串匹配）"
            },
            "tags": {
              "description": "标签：字符串数组或逗号分隔字符串（内部统一为数组）",
              "type": ["array", "string"],
              "items": {"type": "string"}
            },
            "content": {
              "type": "string",
              "description": "片段正文（add 时必填）"
            },
            "snippet_id": {
              "type": "string",
              "description": "片段 ID（delete 时必填，取 add 返回的 id）"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["ok", "snippets", "message"],
          "properties": {
            "ok": {
              "type": "boolean",
              "description": "本次操作是否成功"
            },
            "snippets": {
              "type": "array",
              "description": "受影响/匹配的片段列表",
              "items": {
                "type": "object",
                "required": ["id", "title", "tags", "content", "created_at"],
                "properties": {
                  "id": {"type": "string"},
                  "title": {"type": "string"},
                  "tags": {"type": "array", "items": {"type": "string"}},
                  "content": {"type": "string"},
                  "created_at": {
                    "type": "number",
                    "description": "unix 时间戳（秒）"
                  }
                }
              }
            },
            "message": {
              "type": "string",
              "description": "结果说明（失败时含原因）"
            }
          }
        }
      }
    ]
  },
  "http_endpoints": [
    {
      "route_id": "snippet_box_page",
      "method": "GET",
      "path": "/ext/snippet_box/page/snippet_box",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Webview HTML page: 片段速查库看板"
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "snippet_box",
        "title": "SnippetBox",
        "icon": "🧩",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/snippet_box",
        "widget": "webview",
        "props": {
          "pluginId": "snippet_box",
          "htmlPath": "/page/snippet_box",
          "widgetId": "snippet_box"
        },
        "order": 200,
        "description": "片段速查库看板"
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "host_group": "light"
}
