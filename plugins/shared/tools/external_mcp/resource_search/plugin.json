{
  "id": "external_resource_search",
  "name": "External Resource Search",
  "description": "外部资源聚合搜索 MCP 工具（MCP Registry + Smithery）\n\n[工具契约注] 「mcp_marketplace_search」的 output_schema 由远端 MCP 供给（MCP tools/list 运行时返回；output 形状由上游服务定义），plugin.json 不静态声明，仅保留 LLM 调用所需的 input_schema。",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "mcp:external",
  "mcp": {
    "transport": "streamable_http",
    "endpoint": {
      "url": "https://registry.modelcontextprotocol.io",
      "headers": {
        "X-Also-Search": "smithery.ai"
      },
      "auth": {
        "type": "api_key",
        "header_name": "Authorization",
        "value": "${RESOURCE_SEARCH_API_KEY}"
      }
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "mcp_marketplace_search",
        "description": "Aggregate search across MCP Registry and Smithery platforms (external remote MCP)",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "搜索关键词"
            },
            "platform": {
              "type": "string",
              "description": "平台: mcp_registry/smithery/all"
            },
            "limit": {
              "type": "integer",
              "description": "最大结果数"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ]
  },
  "permissions": {},
  "priority": 30,
  "config_files": [
    {
      "id": "api_keys",
      "label": "搜索源密钥",
      "path": ".env",
      "target": "env",
      "fields": [
        {
          "name": "RESOURCE_SEARCH_API_KEY",
          "label": "Resource Search API Key",
          "type": "secret",
          "required": true,
          "description": "MCP Registry + Smithery 聚合搜索的 API Key"
        }
      ]
    }
  ]
}
