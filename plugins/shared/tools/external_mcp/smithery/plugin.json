{
  "id": "smithery_search",
  "name": "Smithery Search",
  "description": "Smithery 搜索 MCP 工具",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "external",
  "host_type": "sidecar",
  "entry": "mcp:external",
  "mcp": {
    "transport": "streamable_http",
    "endpoint": {
      "url": "https://smithery.ai/api",
      "headers": {
        "Accept": "application/json"
      },
      "auth": {
        "type": "api_key",
        "header_name": "Authorization",
        "value": "${SMITHERY_API_KEY}"
      }
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "smithery_search",
        "description": "Search Smithery for MCP tools and servers",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "搜索关键词"
            },
            "limit": {
              "type": "integer",
              "description": "最大结果数"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ]
  },
  "permissions": {},
  "priority": 30,
  "config_files": [
    {
      "id": "api_keys",
      "label": "搜索源密钥",
      "path": ".env",
      "target": "env",
      "fields": [
        {
          "name": "SMITHERY_API_KEY",
          "label": "Smithery API Key",
          "type": "secret",
          "required": true,
          "description": "https://smithery.ai 的 API Key"
        }
      ]
    }
  ]
}
