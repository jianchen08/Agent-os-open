{
  "id": "design_review_mcp",
  "name": "Design Review (MCP)",
  "description": "设计审查 MCP 工具，基于 Playwright",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "external",
  "host_type": "sidecar",
  "entry": "mcp:external",
  "mcp": {
    "transport": "stdio",
    "endpoint": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--headless"
      ],
      "env": {}
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "design_review",
        "description": "Review design using Playwright MCP",
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "output_schema": {
          "type": "object",
          "required": [
            "content"
          ],
          "description": "external MCP 代理：MCP CallToolResult 信封原样（text 非 JSON 时）",
          "properties": {
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "isError": {
              "type": "boolean"
            }
          }
        }
      }
    ]
  },
  "permissions": {},
  "priority": 30
}
