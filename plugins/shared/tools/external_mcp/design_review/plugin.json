{
  "id": "design_review_mcp",
  "name": "Design Review (MCP)",
  "description": "设计审查 MCP 工具，基于 Playwright",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "external",
  "host_type": "sidecar",
  "entry": "mcp:external",
  "mcp": {
    "transport": "stdio",
    "endpoint": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--headless"
      ],
      "env": {}
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "design_review",
        "description": "Review design using Playwright MCP"
      }
    ]
  },
  "dependencies": [],
  "permissions": {},
  "error_policy": "skip",
  "priority": 30
}