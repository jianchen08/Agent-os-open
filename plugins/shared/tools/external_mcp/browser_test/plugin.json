{
  "id": "browser_test_mcp",
  "name": "Browser Test (MCP)",
  "description": "浏览器测试 MCP 工具，基于 Playwright",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "external",
  "host_type": "sidecar",
  "entry": "mcp:external",
  "mcp": {
    "transport": "stdio",
    "endpoint": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--headless"
      ],
      "env": {}
    }
  },
  "capabilities": {
    "tools": [
      {
        "name": "browser_navigate",
        "description": "Navigate to a URL"
      },
      {
        "name": "browser_click",
        "description": "Click an element"
      },
      {
        "name": "browser_screenshot",
        "description": "Take a screenshot"
      },
      {
        "name": "browser_console",
        "description": "Get console logs"
      },
      {
        "name": "browser_performance",
        "description": "Get performance metrics"
      }
    ]
  },
  "permissions": {},
  "priority": 30
}
