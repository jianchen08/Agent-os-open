{
    "id": "bash_tool",
    "name": "Bash Execute Tool",
    "description": "Bash 命令执行 MCP 工具，支持长时间运行进程和交互式输入",
    "version": "1.0.0",
    "plugin_type": "tool",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python server.py",
    "capabilities": {
        "tools": [
            {
                "name": "bash_execute",
                "description": "执行 Shell 命令，支持长时间运行进程和交互式输入"
