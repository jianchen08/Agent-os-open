        "lifecycle_hooks": [
            "on_load",
            "on_unload"
        ]
    },
    "dependencies": [
        "agentos-plugin-sdk>=0.2.0"
    ],
    "permissions": {},
    "error_policy": "skip",
    "priority": 20
}
