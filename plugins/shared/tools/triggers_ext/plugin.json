{
  "id": "trigger_setup_tool",
  "name": "Trigger Setup Tool",
  "description": "触发器配置 MCP 工具",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [
      {
        "name": "trigger_setup",
        "description": "触发器配置工具",
        "render": {
          "card": "form",
          "title": "触发器"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "setup",
                "cancel",
                "update"
              ],
              "description": "操作类型: setup=设置触发器(默认), cancel=取消指定触发器, update=更新已有触发器的次数或时长"
            },
            "trigger_id": {
              "type": "string",
              "pattern": "^trigger_[a-z]+_[0-9a-f]{12}$",
              "description": "触发器 ID（action=cancel/update 时必填，格式 trigger_<类型>_<12位hex>）"
            },
            "trigger_type": {
              "type": "string",
              "enum": [
                "delay",
                "schedule",
                "interval",
                "event",
                "condition"
              ],
              "description": "触发类型: delay=延迟触发(几秒后), schedule=定时触发(指定时间), interval=周期触发(按间隔重复), event=事件触发, condition=条件触发"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "触发时注入的消息内容"
            },
            "delay_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "description": "延迟秒数（trigger_type=delay 时必填），最小 1 秒，最大 86400 秒（24小时）"
            },
            "schedule_time": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}",
              "description": "定时触发时间（trigger_type=schedule 时必填），ISO 8601 格式，如: 2026-03-15T15:00:00"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+[smhd]",
              "description": "周期间隔（trigger_type=interval 时必填），支持格式: '30s', '5m', '1h', '1d', '1h30m'。最小 10 秒，最大 30 天"
            },
            "max_count": {
              "type": "integer",
              "minimum": 0,
              "description": "最大触发次数（0 或不填表示无限），到达后触发器自动停止"
            },
            "max_time": {
              "type": "string",
              "pattern": "^[0-9]+[smhd]",
              "description": "最长运行时间（到达后触发器自动停止），支持格式: '30m', '2h', '3d', '1h30m'。不填表示无限"
            },
            "event_type": {
              "type": "string",
              "description": "监听的事件类型（trigger_type=event 时必填），如: task_completed, file_changed"
            },
            "condition": {
              "type": "string",
              "description": "条件表达式（trigger_type=condition 时必填），如: task_status == 'pending'"
            },
            "name": {
              "type": "string",
              "description": "触发器名称（可选），便于识别"
            }
          },
          "required": [
            "trigger_type",
            "message"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "success",
            "trigger_id",
            "message"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "trigger_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trigger_type": {
              "type": "string",
              "description": "setup 分支"
            },
            "action": {
              "type": "string",
              "description": "cancel/update 分支"
            },
            "interval": {
              "type": "string"
            },
            "interval_seconds": {
              "type": "number"
            },
            "max_count": {
              "type": "integer"
            },
            "max_time_seconds": {
              "type": "number"
            },
            "old_max_fires": {
              "type": "integer"
            },
            "new_max_fires": {
              "type": "integer"
            },
            "old_max_time_seconds": {
              "type": "number"
            },
            "new_max_time_seconds": {
              "type": "number"
            },
            "current_fire_count": {
              "type": "integer"
            },
            "warning": {
              "type": "string"
            }
          }
        }
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload",
      "domain_event"
    ]
  },
  "permissions": {},
  "priority": 40,
  "granted_capabilities": [
    "chat",
    "pipeline-state"
  ],
  "http_endpoints": [
    {
      "route_id": "trigger_list",
      "method": "GET",
      "path": "/ext/trigger_setup_tool/triggers",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "触发器列表（可选 status 过滤）"
    },
    {
      "route_id": "trigger_create",
      "method": "POST",
      "path": "/ext/trigger_setup_tool/triggers",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "创建触发器（与 trigger_setup 工具 setup 同语义）"
    },
    {
      "route_id": "trigger_get",
      "method": "GET",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "触发器详情"
    },
    {
      "route_id": "trigger_update",
      "method": "PUT",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "更新触发器（与工具 update 同语义）"
    },
    {
      "route_id": "trigger_delete",
      "method": "DELETE",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "取消触发器（状态置 CANCELLED）"
    },
    {
      "route_id": "trigger_enable",
      "method": "POST",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}/enable",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "激活触发器"
    },
    {
      "route_id": "trigger_disable",
      "method": "POST",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}/disable",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "停用触发器（回到 PENDING）"
    },
    {
      "route_id": "trigger_fire",
      "method": "POST",
      "path": "/ext/trigger_setup_tool/triggers/{trigger_id}/trigger",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "手动触发一次"
    },
    {
      "route_id": "trigger_stats",
      "method": "GET",
      "path": "/ext/trigger_setup_tool/triggers/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "触发器统计（类型/状态计数）"
    },
    {
      "route_id": "trigger_pipelines",
      "method": "GET",
      "path": "/ext/trigger_setup_tool/pipelines",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "description": "目标管道下拉选项（state 聚合行 → {options:[{label,value}]}，创建表单 pipeline_id 字段 datasourceUri 消费）"
    }
  ],
  "ui_schema": {
    "widgets": [
      {
        "id": "triggers_table",
        "type": "table",
        "space": "triggers",
        "order": 10,
        "props": {
          "title": "触发器列表",
          "datasourceUri": "/ext/trigger_setup_tool/triggers",
          "columns": [
            {
              "key": "name",
              "label": "名称",
              "sortable": true
            },
            {
              "key": "trigger_type",
              "label": "类型",
              "sortable": true
            },
            {
              "key": "status",
              "label": "状态",
              "sortable": true
            },
            {
              "key": "pipeline_id",
              "label": "目标管道"
            },
            {
              "key": "message",
              "label": "触发消息"
            },
            {
              "key": "fire_count",
              "label": "已触发次数"
            },
            {
              "key": "max_fires",
              "label": "次数上限"
            },
            {
              "key": "trigger_id",
              "label": "ID"
            }
          ],
          "rowActions": [
            {
              "key": "trigger",
              "label": "触发",
              "url": "/ext/trigger_setup_tool/triggers/{trigger_id}/trigger",
              "successText": "已触发"
            },
            {
              "key": "enable",
              "label": "启用",
              "url": "/ext/trigger_setup_tool/triggers/{trigger_id}/enable",
              "when": {
                "key": "status",
                "equals": "pending"
              }
            },
            {
              "key": "disable",
              "label": "禁用",
              "url": "/ext/trigger_setup_tool/triggers/{trigger_id}/disable",
              "when": {
                "key": "status",
                "equals": "active"
              }
            },
            {
              "key": "delete",
              "label": "删除",
              "variant": "destructive",
              "method": "DELETE",
              "url": "/ext/trigger_setup_tool/triggers/{trigger_id}",
              "confirm": "确认删除该触发器？"
            }
          ],
          "watch": [
            {
              "event": "trigger_setup_tool.created",
              "action": "reload"
            }
          ]
        }
      },
      {
        "id": "triggers_create",
        "type": "form",
        "space": "triggers",
        "order": 20,
        "props": {
          "title": "创建触发器",
          "eventName": "trigger_setup_tool.created",
          "successText": "触发器已创建，列表已刷新",
          "fields": [
            {
              "name": "pipeline_id",
              "type": "select",
              "label": "目标管道",
              "datasourceUri": "/ext/trigger_setup_tool/pipelines",
              "description": "触发时向该管道注入消息；留空则提交给当前激活管道"
            },
            {
              "name": "trigger_type",
              "type": "select",
              "label": "类型",
              "required": true,
              "options": [
                {
                  "label": "延迟（指定秒数后）",
                  "value": "delay"
                },
                {
                  "label": "定时（指定时间点）",
                  "value": "schedule"
                },
                {
                  "label": "周期（按间隔重复）",
                  "value": "interval"
                },
                {
                  "label": "事件（监听域事件）",
                  "value": "event"
                },
                {
                  "label": "条件（表达式为真）",
                  "value": "condition"
                }
              ]
            },
            {
              "name": "message",
              "type": "textarea",
              "label": "触发消息",
              "required": true,
              "description": "触发时注入目标管道的消息内容"
            },
            {
              "name": "name",
              "type": "input",
              "label": "名称",
              "description": "可选，便于识别"
            },
            {
              "name": "delay_seconds",
              "type": "number",
              "label": "延迟秒数",
              "min": 1,
              "max": 86400,
              "description": "类型=延迟 时必填（1-86400）"
            },
            {
              "name": "schedule_time",
              "type": "input",
              "label": "定时时间",
              "placeholder": "2026-08-27T15:00:00",
              "description": "类型=定时 时必填，ISO 8601 格式，最远 7 天"
            },
            {
              "name": "interval",
              "type": "input",
              "label": "周期间隔",
              "placeholder": "30s / 5m / 1h / 1d",
              "description": "类型=周期 时必填，最小 10 秒，最大 30 天"
            },
            {
              "name": "event_type",
              "type": "input",
              "label": "监听事件",
              "placeholder": "task_completed",
              "description": "类型=事件 时必填，如 task_completed / task_failed"
            },
            {
              "name": "condition",
              "type": "input",
              "label": "条件表达式",
              "placeholder": "task.status == 'completed'",
              "description": "类型=条件 时必填，对管道 state 聚合行求值"
            },
            {
              "name": "max_count",
              "type": "number",
              "label": "最大触发次数",
              "min": 0,
              "description": "可选，0 或不填=无限（周期/事件/条件类型生效）"
            },
            {
              "name": "max_time",
              "type": "input",
              "label": "最长运行时间",
              "placeholder": "30m / 2h / 3d",
              "description": "可选，到达后触发器自动停止"
            }
          ],
          "endpoint": "/ext/trigger_setup_tool/triggers",
          "submitLabel": "创建"
        }
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "triggers",
        "title": "触发器",
        "icon": "⚡",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 15,
        "path": "/triggers",
        "widget": "widget_stage",
        "props": {
          "space": "triggers"
        },
        "description": "触发器管理（widget 化声明页：列表+行操作+创建，channel_api 退役后随域迁入 trigger_setup_tool）"
      }
    ]
  }
}
