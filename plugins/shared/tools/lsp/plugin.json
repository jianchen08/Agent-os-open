{
  "id": "lsp_service",
  "name": "LSP Service",
  "description": "LSP 语言服务协议工具（定义跳转/引用查找/诊断/补全/文件跳转）",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "lsp.definition",
        "description": "跳转到符号定义位置",
        "input_schema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "文件路径"
            },
            "line": {
              "type": "integer",
              "description": "行号（从0开始）"
            },
            "character": {
              "type": "integer",
              "description": "列号（从0开始）",
              "default": 0
            },
            "language": {
              "type": "string",
              "description": "编程语言（不传则自动检测）"
            }
          },
          "required": [
            "file_path",
            "line"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "locations",
            "count"
          ],
          "properties": {
            "locations": {
              "type": "array",
              "description": "定义位置列表（client 缺失时为空数组）",
              "items": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string"
                  },
                  "range": {
                    "type": "object",
                    "description": "LSP Range（start/end 行列）"
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            }
          }
        }
      },
      {
        "name": "lsp.references",
        "description": "查找符号的所有引用位置",
        "input_schema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "文件路径"
            },
            "line": {
              "type": "integer",
              "description": "行号（从0开始）"
            },
            "character": {
              "type": "integer",
              "description": "列号（从0开始）",
              "default": 0
            },
            "language": {
              "type": "string",
              "description": "编程语言（不传则自动检测）"
            }
          },
          "required": [
            "file_path",
            "line"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "references",
            "count"
          ],
          "properties": {
            "references": {
              "type": "array",
              "description": "引用位置列表（client 缺失时为空数组）",
              "items": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string"
                  },
                  "range": {
                    "type": "object",
                    "description": "LSP Range（start/end 行列）"
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            }
          }
        }
      },
      {
        "name": "lsp.diagnostics",
        "description": "获取文件的诊断信息（错误和警告）",
        "input_schema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "文件路径"
            },
            "language": {
              "type": "string",
              "description": "编程语言（不传则自动检测）"
            }
          },
          "required": [
            "file_path"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "diagnostics",
            "count"
          ],
          "properties": {
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "range": {
                    "type": "object"
                  },
                  "severity": {
                    "type": "integer"
                  },
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            }
          }
        }
      },
      {
        "name": "lsp.jump_to_file",
        "description": "在 IDE 中打开文件并跳转到指定位置",
        "input_schema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "文件路径"
            },
            "line": {
              "type": "integer",
              "description": "行号（从0开始）",
              "default": 0
            },
            "character": {
              "type": "integer",
              "description": "列号（从0开始）",
              "default": 0
            }
          },
          "required": [
            "file_path"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "success",
            "file_path",
            "line",
            "character"
          ],
          "properties": {
            "success": {
              "type": "boolean",
              "description": "跳转是否成立（失败也走同形状）"
            },
            "file_path": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "character": {
              "type": "integer"
            }
          }
        }
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 30,
  "requires_content": 3
}
