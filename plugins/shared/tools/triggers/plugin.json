{
  "id": "trigger_service",
  "name": "Trigger Service",
  "version": "1.0.0",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [],
    "resources": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": [
      {
        "name": "trigger.register",
        "description": "Register a new trigger"
      },
      {
        "name": "trigger.cancel",
        "description": "Cancel a registered trigger"
      },
      {
        "name": "trigger.list",
        "description": "List registered triggers"
      }
    ]
  },
  "dependencies": [],
  "permissions": {},
  "error_policy": "skip",
  "priority": 40
}