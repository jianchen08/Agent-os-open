{
  "id": "download_tool",
  "name": "Download Tool",
  "description": "通用文件下载 MCP 工具，支持多连接分段下载和断点续传",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "download",
