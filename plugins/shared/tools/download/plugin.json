{
  "id": "download_tool",
  "name": "Download Tool",
  "description": "通用文件下载 MCP 工具，支持多连接分段下载和断点续传",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "download",
        "description": "通用文件下载工具，支持多连接分段下载、断点续传",
        "render": {
          "card": "file",
          "title": "下载完成"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "下载地址（http/https）"
            },
            "save_path": {
              "type": "string",
              "description": "保存目录路径"
            },
            "filename": {
              "type": "string"
            },
            "max_connections": {
              "type": "integer",
              "default": 8
            },
            "max_retries": {
              "type": "integer",
              "default": 5
            },
            "timeout": {
              "type": "integer",
              "default": 300
            },
            "max_size": {
              "type": "integer",
              "default": 1073741824
            },
            "proxy": {
              "type": "string"
            },
            "allow_domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expected_hash": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "save_path"
          ]
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "description": "下载产物落盘路径"
            },
            "size": {
              "type": "integer",
              "description": "文件字节数"
            },
            "duration": {
              "type": "number",
              "description": "下载耗时（秒）"
            },
            "avg_speed": {
              "type": "string",
              "description": "平均速度（人类可读，如 1.2 MB/s）"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "success",
            "path",
            "size"
          ]
        }
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 30,
  "host_group": "light"
}
