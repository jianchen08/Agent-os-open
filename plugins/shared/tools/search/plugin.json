{
  "id": "resource_search_tool",
  "name": "Resource Search Tool",
  "description": "搜索系统内 Agent、工具、Skill 资源的 MCP 工具",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "tools": [
      {
        "name": "resource_search",
        "description": "搜索系统内 Agent、工具、Skill 资源",
        "render": {
          "card": "table"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "resource_type": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "default": "simple"
            },
            "limit": {
              "type": "integer",
              "default": 20
            }
          },
          "required": [
            "resource_type"
          ]
        },
        "output_schema": {
          "type": "object",
          "description": "三类资源（agent/tool/skill）表格式结果；全部键条件出现（无命中即缺席）",
          "properties": {
            "agent_h": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "agent 表头"
            },
            "agent_d": {
              "type": "array",
              "items": {
                "type": "array"
              },
              "description": "agent 行"
            },
            "agent_c": {
              "type": "integer"
            },
            "tool_h": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tool_d": {
              "type": "array",
              "items": {
                "type": "array"
              }
            },
            "tool_c": {
              "type": "integer"
            },
            "skill_h": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skill_d": {
              "type": "array",
              "items": {
                "type": "array"
              }
            },
            "skill_c": {
              "type": "integer"
            }
          }
        }
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 30,
  "config_files": [
    {
      "id": "builtin_tools_config",
      "path": "config/tools/builtin_tools_config.yaml",
      "label": "内置工具配置"
    },
    {
      "id": "resource_search",
      "path": "config/tools/search/resource_search.yaml",
      "label": "资源搜索配置"
    }
  ]
}
