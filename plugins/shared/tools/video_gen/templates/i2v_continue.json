{
  "_meta": "i2v 续接模板（continue 衔接）：以 start_image（上一段末帧）编码潜空间直续。骨架说明同 t2v_scene——P0-T2 真机联调整体替换，占位符契约不变。",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "P0T2_MODEL"}
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{positive_prompt}}", "clip": ["1", 0]}
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{negative_prompt}}", "clip": ["1", 0]}
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{start_image}}"}
  },
  "5": {
    "class_type": "VAEEncode",
    "inputs": {"pixels": ["4", 0], "vae": ["1", 2]}
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.85,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "8": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {"images": ["7", 0], "filename_prefix": "agentos_i2v", "fps": "{{fps}}", "lossless": false}
  }
}
