{
  "id": "user_admin",
  "name": "User Admin HTTP Face",
  "description": "用户管理 HTTP 面（channel_api 退役批次2 users 域并入）：/ext/user_admin/** 经内核 dispatcher 进本插件 http.handle。既有 user-admin capability 面（PATCH 改角色/改租户，内核自保护）+ users 域六组端点（列表/统计/角色 PUT/激活/删除/设置）经 db-admin capability 查/写内核 users 表。鉴权凭证（Authorization 头）原样透传 _authorization、内核侧真角色校验；插件不做鉴权决策。",
  "version": "1.0.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "activation": "eager",
  "capabilities": {
    "tools": [
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/user_admin/**（user-admin capability 的 HTTP 面转发层）"
      },
      {
        "name": "user_admin.status",
        "description": "插件状态（capability 句柄是否已注入）"
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": []
  },
  "permissions": {},
  "priority": 50,
  "granted_capabilities": [
    "user-admin",
    "db-admin"
  ],
  "contributes": {
    "pages": [
      {
        "id": "admin",
        "title": "用户管理",
        "icon": "👥",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 15,
        "path": "/admin",
        "widget": "widget_stage",
        "when": "user.role == 'admin'",
        "props": {
          "space": "admin"
        },
        "description": "用户管理（widget 化：统计卡+用户表声明组台，数据源 user_admin http_endpoints）"
      }
    ]
  },
  "ui_schema": {
    "widgets": [
      {
        "id": "user_stats_card",
        "type": "status_card",
        "space": "admin",
        "order": 10,
        "props": {
          "title": "用户统计",
          "datasourceUri": "/ext/user_admin/users/stats"
        }
      },
      {
        "id": "users_table",
        "type": "table",
        "space": "admin",
        "order": 20,
        "props": {
          "title": "用户列表",
          "datasourceUri": "/ext/user_admin/users",
          "pageSize": 20,
          "columns": [
            {
              "key": "username",
              "label": "用户名"
            },
            {
              "key": "email",
              "label": "邮箱"
            },
            {
              "key": "role",
              "label": "角色"
            },
            {
              "key": "is_active",
              "label": "活跃"
            },
            {
              "key": "created_at",
              "label": "创建时间"
            },
            {
              "key": "last_login_at",
              "label": "最近登录"
            }
          ],
          "rowActions": [
            {
              "key": "disable",
              "label": "禁用",
              "method": "PUT",
              "url": "/ext/user_admin/users/{id}/active?is_active=false",
              "when": {
                "key": "is_active",
                "equals": true
              },
              "confirm": "确认禁用该用户？",
              "variant": "destructive",
              "successText": "已禁用"
            },
            {
              "key": "enable",
              "label": "启用",
              "method": "PUT",
              "url": "/ext/user_admin/users/{id}/active?is_active=true",
              "when": {
                "key": "is_active",
                "equals": false
              },
              "successText": "已启用"
            }
          ]
        }
      }
    ]
  },
  "http_endpoints": [
    {
      "route_id": "users",
      "method": "GET",
      "path": "/ext/user_admin/users",
      "auth": "admin",
      "handler_capability": "http.handle",
      "description": "列全部用户（不含密码；仅 admin）"
    },
    {
      "route_id": "user_role_update",
      "method": "PATCH",
      "path": "/ext/user_admin/users/{user_id}/role",
      "auth": "admin",
      "handler_capability": "http.handle",
      "description": "改用户角色（body: {role: admin|user}；内核侧校验 admin 角色 + 不能改自己）"
    },
    {
      "route_id": "user_tenant_update",
      "method": "PATCH",
      "path": "/ext/user_admin/users/{user_id}/tenant",
      "auth": "admin",
      "handler_capability": "http.handle",
      "description": "改用户归属租户（body: {tenant_id}；内核侧校验 admin 角色 + 不能改自己）"
    },
    {
      "route_id": "user_delete",
      "method": "DELETE",
      "path": "/ext/user_admin/users/{user_id}",
      "auth": "admin",
      "handler_capability": "http.handle",
      "description": "删用户（内核侧校验 admin 角色 + 不能删自己，防锁死系统）"
    },
    {
      "route_id": "users_stats",
      "method": "GET",
      "path": "/ext/user_admin/users/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "用户统计（total_users/active_users/admin_count；db-admin.table_query 凭证透传，内核 admin/viewer 读校验——原 GET /ext/channel_api/users/stats）"
    },
    {
      "route_id": "user_role_update_put",
      "method": "PUT",
      "path": "/ext/user_admin/users/{user_id}/role",
      "auth": "admin",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "改用户角色（body: {role: admin|user}；与 PATCH 同路径对齐 admin 声明，dispatcher 层 admin 强制 + db-admin.table_update_row 凭证透传内核 admin 写校验双层纵深；PATCH 同路径仍走 user-admin capability 自保护面——原 PUT /ext/channel_api/users/{user_id}/role）"
    },
    {
      "route_id": "user_active_update",
      "method": "PUT",
      "path": "/ext/user_admin/users/{user_id}/active",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新用户激活状态（users 表无 is_active 列，保持存根语义——原 PUT /ext/channel_api/users/{user_id}/active）"
    },
    {
      "route_id": "user_active_update_patch",
      "method": "PATCH",
      "path": "/ext/user_admin/users/{user_id}/active",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新用户激活状态（PATCH 形态，同 PUT 存根语义——原 PATCH /ext/channel_api/users/{user_id}/active）"
    },
    {
      "route_id": "user_settings_get",
      "method": "GET",
      "path": "/ext/user_admin/users/settings",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "获取用户设置（存根——原 GET /ext/channel_api/users/settings）"
    },
    {
      "route_id": "user_settings_put",
      "method": "PUT",
      "path": "/ext/user_admin/users/settings",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "更新用户设置（存根——原 PUT /ext/channel_api/users/settings）"
    }
  ]
}
