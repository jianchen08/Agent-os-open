{
    "id": "wasm_calc",
    "name": "WASM Sandboxed Calculator",
    "version": "1.0.0",
    "plugin_type": "tool",
    "language": "rust",
    "host_type": "wasm",
    "entry": "wasm_calc.wasm",
    "invoke_entry": "execute",
    "wasm": {
        "artifact": "wasm_calc.wasm",
        "granted_capabilities": []
    },
    "capabilities": {
        "tools": [
            {
                "name": "scientific_calculator",
                "description": "沙箱化科学计算器（WASM）：三角/对数/幂运算，表达式求值不用 eval，彻底隔离用户输入",
                "ui": {
                    "chat_card": {
                        "title": "计算器：{{args.expression | truncate:40}}",
                        "blocks": [
                            {
                                "type": "kv",
                                "label": "计算结果",
                                "fields": [
                                    { "key": "表达式", "source": "args.expression" },
                                    { "key": "结果", "source": "result.value" }
                                ]
                            }
                        ]
                    }
                }
            }
        ],
        "resources": [],
        "route_signals": [],
        "lifecycle_hooks": []
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50
}
