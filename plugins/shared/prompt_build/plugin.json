{
  "id": "pipeline_prompt_build",
  "requires_services": [
    "packaging"
  ],
  "name": "Prompt Build",
  "version": "1.1.3",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "prompt_build.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "steps": [
      {
        "name": "pipeline_prompt_build",
        "required_state_inputs": [
          "context.system_prompt"
        ]
      }
    ],
    "services": [
      {
        "name": "prompt.preview",
        "description": "Assemble a preview SystemMessage + dynamic-vars message from context state pieces (same code path as the pipeline step; for offline surfaces like agent config preview)",
        "input_schema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object",
              "description": "prompt_build 消费的 context.* 片段（去 context. 前缀的键名）"
            },
            "session_id": {
              "type": "string",
              "description": "可选会话 id（{{session}} 渲染用），缺省 preview"
            }
          },
          "required": [
            "context"
          ]
        }
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "execution_context",
      "context.agent_name",
      "context.agent_pack_root",
      "context.constraints_text",
      "context.dynamic_vars",
      "context.persona_text",
      "context.session_id",
      "context.static_vars",
      "context.system_prompt",
      "context_window",
      "llm_model",
      "messages",
      "model_id",
      "model_tier",
      "project_roots",
      "prompt.tool_descriptions",
      "tool_surface.unavailable",
      "user_id",
      "agent_id",
      "tool_ids"
    ]
  },
  "export_fields": [
    "track.messages_chars"
  ],
  "persistent_fields": [
    "track.messages_chars"
  ]
}
