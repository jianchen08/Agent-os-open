{
  "id": "monitoring",
  "requires_services": [
    "packaging",
    "db-read"
  ],
  "name": "Monitoring Service",
  "version": "1.0.9",
  "plugin_type": "system",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "config_files": [
    {
      "id": "plugin_health",
      "path": "config/plugins/monitoring/plugin_health.yaml",
      "label": "插件组健康告警阈值",
      "fields": [
        {
          "name": "respawn_failure_threshold",
          "label": "连续 respawn 失败阈值（次）",
          "type": "number",
          "min": 1,
          "description": "窗口内 last_crash_ts 跳变数达到该值 → high 告警（默认 3）"
        },
        {
          "name": "group_start_failure_threshold",
          "label": "宿主恢复失败告警阈值（次）",
          "type": "number",
          "min": 1,
          "description": "窗口内 last_crash_ts 跳变数达到该值 → medium 告警（默认 1，首次即告）"
        },
        {
          "name": "sidecar_eof_rate_threshold",
          "label": "EOF 速率告警阈值（次/分）",
          "type": "number",
          "min": 1,
          "description": "窗口内 sidecar stdout EOF 速率达到该值 → high 告警（默认 10 次/分，卡9）"
        },
        {
          "name": "tools_list_invalid_threshold",
          "label": "tools/list 非法告警阈值（次）",
          "type": "number",
          "min": 1,
          "description": "窗口内观测失败终态+malformed 条目合计达到该值 → high 告警（默认 1，≥1 即告，卡9）"
        },
        {
          "name": "window",
          "label": "评估窗口",
          "type": "select",
          "options": [
            "5m",
            "1h",
            "24h"
          ],
          "description": "崩溃跳变/计数器速率共用评估窗口（默认 5m）"
        },
        {
          "name": "cooldown_secs",
          "label": "告警冷却（秒）",
          "type": "number",
          "min": 1,
          "description": "同（规则, 插件）告警日志冷却期（默认 300）"
        },
        {
          "name": "poll_interval_secs",
          "label": "后台轮询间隔（秒）",
          "type": "number",
          "min": 1,
          "description": "插件组健康后台自动轮询间隔（默认 60，插件语境系统读无需用户凭证，卡9）"
        }
      ]
    }
  ],
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "services": []
  },
  "permissions": {},
  "priority": 40,
  "requires_content": 3,
  "http_endpoints": [
    {
      "route_id": "mon_system_metrics",
      "method": "GET",
      "path": "/ext/monitoring/system/metrics",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get system performance metrics (CPU/memory/disk, psutil real data)"
    },
    {
      "route_id": "mon_task_statistics",
      "method": "GET",
      "path": "/ext/monitoring/tasks/statistics",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get task execution statistics"
    },
    {
      "route_id": "mon_tasks",
      "method": "GET",
      "path": "/ext/monitoring/tasks",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get task list (supports ?page=&page_size=&status=)"
    },
    {
      "route_id": "mon_token_usage",
      "method": "GET",
      "path": "/ext/monitoring/token-usage",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get token usage statistics"
    },
    {
      "route_id": "mon_token_usage_by_time",
      "method": "GET",
      "path": "/ext/monitoring/token-usage/by-time",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get token usage statistics grouped by day (UTC)"
    },
    {
      "route_id": "mon_cache_stats",
      "method": "GET",
      "path": "/ext/monitoring/cache-stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "Get cache hit/miss statistics"
    },
    {
      "route_id": "mon_payload_diag_list",
      "method": "GET",
      "path": "/ext/monitoring/payload-diag",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "List LLM payload diagnostic snapshots (from logs/payload_diag/)"
    },
    {
      "route_id": "mon_payload_diag_get",
      "method": "GET",
      "path": "/ext/monitoring/payload-diag/file",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Get one payload snapshot file content (?name=filename.json)"
    },
    {
      "route_id": "mon_diagnostics_settings_get",
      "method": "GET",
      "path": "/ext/monitoring/diagnostics-settings",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Get diagnostics switches (user-space settings.yaml diagnostics section)"
    },
    {
      "route_id": "mon_diagnostics_settings_put",
      "method": "PUT",
      "path": "/ext/monitoring/diagnostics-settings",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Update diagnostics switches (merge-write settings.yaml diagnostics section; hot-effective on next LLM call)"
    },
    {
      "route_id": "mon_tool_calls",
      "method": "GET",
      "path": "/ext/monitoring/tool-calls",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 8000,
      "max_concurrency": 4,
      "description": "Query tool call records from traces table (?tool_name=&status=&min_duration=&limit=)"
    },
    {
      "route_id": "mon_tool_calls_stats",
      "method": "GET",
      "path": "/ext/monitoring/tool-calls/stats",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 8000,
      "max_concurrency": 4,
      "description": "Per-tool aggregate stats over recent tool-carrying traces (calls/success/error/avg duration; window=limit)"
    },
    {
      "route_id": "mon_tool_calls_page",
      "method": "GET",
      "path": "/ext/monitoring/page/tool-calls",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 4,
      "description": "Webview HTML page: tool call records viewer"
    },
    {
      "route_id": "mon_execution_records_list",
      "method": "GET",
      "path": "/ext/monitoring/execution/records",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 8,
      "description": "execution 域（channel_api 批次2 随迁）：执行记录列表（query: session_id/parent_record_id/limit/offset，内核能力桥组装）"
    },
    {
      "route_id": "mon_execution_records_sessions",
      "method": "GET",
      "path": "/ext/monitoring/execution/records/sessions",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 8,
      "description": "execution 域：有记录的会话列表（pipeline-runs + pipeline-state 聚合）"
    },
    {
      "route_id": "mon_execution_records_group_summary",
      "method": "GET",
      "path": "/ext/monitoring/execution/records/group-summary",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 8,
      "description": "execution 域：记录分组概要（query: session_id）"
    },
    {
      "route_id": "mon_execution_records_tree",
      "method": "GET",
      "path": "/ext/monitoring/execution/records/tree/{session_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 8,
      "description": "execution 域：执行记录树（query: max_depth）"
    },
    {
      "route_id": "mon_execution_record_children",
      "method": "GET",
      "path": "/ext/monitoring/execution/records/{record_id}/children",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "execution 域：子执行记录（无层级，返回 []）"
    },
    {
      "route_id": "mon_execution_record_get",
      "method": "GET",
      "path": "/ext/monitoring/execution/records/{record_id}",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "execution 域：获取单条执行记录"
    },
    {
      "route_id": "mon_execution_records_clear_all",
      "method": "POST",
      "path": "/ext/monitoring/execution/records/clear-all",
      "auth": "admin",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 2,
      "description": "execution 域：清空全部执行记录与轨迹（内核 9 表+registry+payload_diag 快照，users 保留；运行中管道 409；实际 admin 鉴权在 db-admin.clear_execution_data 内核侧执行）"
    },
    {
      "route_id": "mon_sessions_total_token_usage",
      "method": "GET",
      "path": "/ext/monitoring/sessions/{session_id}/total-token-usage",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "sessions 域（批次2 随迁接真）：会话总 Token 用量（pipeline-state 累计 + run 请求数）"
    },
    {
      "route_id": "mon_sessions_context_token_usage",
      "method": "GET",
      "path": "/ext/monitoring/sessions/{session_id}/context-token-usage",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "sessions 域：上下文 Token 用量（估算，query: parent_execution_record_id）"
    },
    {
      "route_id": "mon_search_global",
      "method": "GET",
      "path": "/ext/monitoring/search",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "search 域（批次3 接真）：统一搜索会话与消息（query: q/type/limit，响应形态对齐前端 search.ts）"
    },
    {
      "route_id": "mon_plugins_runtime",
      "method": "GET",
      "path": "/ext/monitoring/plugins",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "插件运行态（metrics-admin 读面桥）：每插件进程 gauge（alive/pid/RSS/uptime/上次崩溃）+ lifecycle 加载/报错计数（留存窗口累计）"
    },
    {
      "route_id": "mon_plugin_health",
      "method": "GET",
      "path": "/ext/monitoring/plugin-health",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 10000,
      "max_concurrency": 4,
      "description": "插件组健康告警评估（卡5/卡9 四条规则：respawn 恢复失败/组启动失败/EOF 速率/tools-list 非法；命中告警冷却闸后返回全量）"
    },
    {
      "route_id": "mon_traces_by_pipeline",
      "method": "GET",
      "path": "/ext/monitoring/traces",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "管道诊断域：step 级执行轨迹时间线（query: pipeline_id 必填/limit，summary+llm_usage+error 轻量投影，patch_data 原样随行）"
    },
    {
      "route_id": "mon_pipeline_state_full",
      "method": "GET",
      "path": "/ext/monitoring/pipeline-state",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "管道诊断域：单管道 state 全字段（query: pipeline_id 必填，pipeline_state 表全键 + runs 列表 + 摘要行）"
    },
    {
      "route_id": "mon_orphan_runs",
      "method": "GET",
      "path": "/ext/monitoring/orphans",
      "auth": "user",
      "handler_capability": "http.handle",
      "timeout_ms": 5000,
      "max_concurrency": 8,
      "description": "孤儿管道观测：running 且时长超阈值（min_minutes，默认10）的候选清单按时长倒序（人工 cancel 决策用，不自动终止）"
    }
  ],
  "ui_schema": {
    "widgets": [
      {
        "id": "resource_cpu",
        "type": "status_card",
        "space": "monitoring",
        "order": 10,
        "props": {
          "title": "系统资源",
          "label": "CPU",
          "datasourceUri": "/ext/monitoring/system/metrics",
          "valueKey": "metrics.cpu_usage",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 30
          },
          "variant": "metric",
          "icon": "🖥️",
          "description": "CPU 使用率（psutil 实时）"
        },
        "group": "资源"
      },
      {
        "id": "resource_mem",
        "type": "status_card",
        "space": "monitoring",
        "order": 20,
        "props": {
          "label": "内存",
          "datasourceUri": "/ext/monitoring/system/metrics",
          "valueKey": "metrics.memory.usage_percent",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 30
          },
          "variant": "metric",
          "icon": "🧠",
          "description": "内存占用（psutil 实时）"
        },
        "group": "资源"
      },
      {
        "id": "resource_disk",
        "type": "status_card",
        "space": "monitoring",
        "order": 30,
        "props": {
          "label": "磁盘",
          "datasourceUri": "/ext/monitoring/system/metrics",
          "valueKey": "metrics.disk.usage_percent",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 30
          },
          "variant": "metric",
          "icon": "💾",
          "description": "磁盘占用（psutil 实时）"
        },
        "group": "资源"
      },
      {
        "id": "token_card",
        "type": "status_card",
        "space": "monitoring",
        "order": 40,
        "props": {
          "title": "Token 用量",
          "label": "累计 Tokens",
          "datasourceUri": "/ext/monitoring/token-usage",
          "valueKey": "total_tokens",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          },
          "variant": "metric",
          "icon": "🔤",
          "description": "跨运行累计 LLM Tokens（traces 账本）"
        },
        "group": "用量与成本"
      },
      {
        "id": "token_cache_card",
        "type": "status_card",
        "space": "monitoring",
        "order": 41,
        "props": {
          "title": "缓存命中",
          "label": "命中率 (%)",
          "datasourceUri": "/ext/monitoring/token-usage",
          "valueKey": "cache_hit_pct",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          },
          "variant": "metric",
          "icon": "⚡",
          "description": "累计 LLM 输入中缓存命中占比 = cached/input（早期轨迹无缓存字段按 0 计）"
        },
        "group": "用量与成本"
      },
      {
        "id": "token_by_model_chart",
        "type": "chart",
        "space": "monitoring",
        "group": "用量与成本",
        "order": 42,
        "props": {
          "title": "Token 按模型",
          "chartType": "bar",
          "showDataLabels": true,
          "datasourceUri": "/ext/monitoring/token-usage",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          }
        }
      },
      {
        "id": "token_by_model_table",
        "type": "table",
        "space": "monitoring",
        "order": 47,
        "props": {
          "title": "Token 按模型统计",
          "datasourceUri": "/ext/monitoring/token-usage",
          "columns": [
            {
              "key": "icon",
              "label": "图标"
            },
            {
              "key": "model",
              "label": "模型"
            },
            {
              "key": "requests",
              "label": "调用次数"
            },
            {
              "key": "input_tokens",
              "label": "输入 Tokens"
            },
            {
              "key": "output_tokens",
              "label": "输出 Tokens"
            },
            {
              "key": "total_tokens",
              "label": "合计 Tokens"
            },
            {
              "key": "cached_tokens",
              "label": "缓存命中 Tokens"
            },
            {
              "key": "cache_hit_pct",
              "label": "命中率 (%)"
            }
          ],
          "pageSize": 10,
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          },
          "description": "跨运行 LLM Tokens 按模型细分（traces 账本，图标按 provider 映射；早期无模型归属的轨迹归入「未记录模型」）。缓存命中 = 累计 cached tokens，命中率 = cached/input（早期轨迹无缓存字段按 0 计）"
        },
        "group": "用量与成本"
      },
      {
        "id": "token_by_time_chart",
        "type": "chart",
        "space": "monitoring",
        "group": "用量与成本",
        "order": 45,
        "props": {
          "title": "Token 按日趋势",
          "chartType": "line",
          "showDataLabels": true,
          "datasourceUri": "/ext/monitoring/token-usage/by-time",
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          }
        }
      },
      {
        "id": "token_by_time_table",
        "type": "table",
        "space": "monitoring",
        "order": 48,
        "props": {
          "title": "Token 按时间统计",
          "datasourceUri": "/ext/monitoring/token-usage/by-time",
          "columns": [
            {
              "key": "date",
              "label": "日期 (UTC)"
            },
            {
              "key": "requests",
              "label": "调用次数"
            },
            {
              "key": "input_tokens",
              "label": "输入 Tokens"
            },
            {
              "key": "output_tokens",
              "label": "输出 Tokens"
            },
            {
              "key": "total_tokens",
              "label": "合计 Tokens"
            },
            {
              "key": "cached_tokens",
              "label": "缓存命中 Tokens"
            },
            {
              "key": "cache_hit_pct",
              "label": "命中率 (%)"
            }
          ],
          "pageSize": 10,
          "refresh": {
            "type": "poll",
            "intervalSeconds": 60
          },
          "description": "跨运行 LLM Tokens 按日（UTC）细分（traces 账本）。缓存命中 = 当日 cached tokens 之和，命中率 = cached/input（早期轨迹无缓存字段按 0 计）"
        },
        "group": "用量与成本"
      },
      {
        "id": "tasks_table",
        "type": "table",
        "space": "monitoring",
        "order": 50,
        "props": {
          "title": "最近任务",
          "datasourceUri": "/ext/monitoring/tasks",
          "pageSize": 10,
          "refresh": {
            "type": "poll",
            "intervalSeconds": 30
          }
        },
        "group": "任务"
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "monitoring",
        "title": "监控",
        "icon": "📊",
        "space": "workspace",
        "slot": "activity-bar",
        "order": 20,
        "path": "/monitoring",
        "widget": "widget_stage",
        "props": {
          "space": "monitoring"
        },
        "description": "系统监控（widget 化：资源卡+任务表声明组合，替代硬编码 MonitoringPage）"
      },
      {
        "id": "tool_call_records",
        "title": "工具调用记录",
        "space": "workspace",
        "slot": "tab",
        "path": "/p/tool_call_records",
        "icon": "🕓",
        "order": 62,
        "widget": "webview",
        "props": {
          "pluginId": "monitoring",
          "htmlPath": "/page/tool-calls",
          "widgetId": "tool_call_records"
        }
      }
    ]
  },
  "host_group": "light_stable"
}
