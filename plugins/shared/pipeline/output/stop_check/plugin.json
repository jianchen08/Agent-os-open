{
  "id": "pipeline_stop_check",
  "name": "Stop Check",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "stop_check.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "host_group": "light",
  "export_fields": [
    "router.stop_reason"
  ],
  "granted_capabilities": [
    "pipeline-state"
  ],
  "persistent_fields": [
    "task.status"
  ],
  "state": {
    "reads": [
      "ended",
      "iteration",
      "max_iterations",
      "messages_tail:20",
      "pipeline_id",
      "raw_tool_calls",
      "run_id",
      "should_stop",
      "task.id",
      "timeout_seconds",
      "tool_results"
    ]
  }
}
