{
  "id": "pipeline_task_reminder",
  "name": "Task Reminder",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "task_reminder.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "persistent_fields": [
    "task.status",
    "evaluate_reminder_count",
    "evaluate_reminder_run",
    "eval_tool_only_count",
    "reminder_seen_result_fp",
    "evaluation.detected_result"
  ],
  "permissions": {},
  "priority": 50,
  "host_group": "light",
  "export_fields": [
    "evaluation.detected_result",
    "task.status",
    "task.ended_at"
  ],
  "state": {
    "reads": [
      "_plugin_errors",
      "acceptance_criteria",
      "agent_level",
      "conversation_mode",
      "core_type",
      "eval_tool_only_count",
      "evaluate_reminder_count",
      "evaluation.detected_result",
      "iteration",
      "llm_empty_exhausted",
      "max_reminders",
      "messages_tail:50",
      "plugin_configs",
      "raw_result",
      "raw_tool_calls",
      "reject_count",
      "reject_reason",
      "run_started_at",
      "submitted_task_ids",
      "task.id",
      "task.status"
    ]
  }
}
