{
  "id": "pipeline_task_reminder",
  "name": "Task Reminder",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "task_reminder.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "persistent_fields": [
    "task.status",
    "evaluate_reminder_count",
    "eval_tool_only_count",
    "evaluation.detected_result"
  ],
  "permissions": {},
  "priority": 50,
  "host_group": "light",
  "export_fields": [
    "evaluation.detected_result",
    "task.status",
    "task.ended_at"
  ]
}
