{
  "id": "pipeline_tool_cache_writer",
  "requires_services": [
    "packaging"
  ],
  "name": "Tool Cache Writer",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "tool_cache_writer.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 25,
  "config_files": [
    {
      "id": "tool_cache_writer",
      "label": "工具缓存写入配置",
      "fields": [
        {
          "name": "per_pipeline_max",
          "label": "每管道全文留存条数",
          "type": "number",
          "default": 1
        }
      ]
    }
  ],
  "state": {
    "reads": [
      "_executed_tool_calls",
      "_full_tool_results",
      "pipeline_id",
      "user_id",
      "session_id"
    ]
  }
}
