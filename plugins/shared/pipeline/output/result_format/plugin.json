{
  "id": "pipeline_result_format",
  "requires_services": [
    "packaging"
  ],
  "name": "Result Format",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "result_format.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "context_window",
      "core_type",
      "messages_tail:50",
      "tool_results"
    ]
  }
}
