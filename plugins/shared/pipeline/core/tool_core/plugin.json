{
  "id": "pipeline_tool_core",
  "name": "Tool Core",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "pipeline_role": "core",
  "language": "rust",
  "host_type": "in_process",
  "entry": "pipeline_tool_core_native.dll",
  "invoke_entry": "plugin_execute",
  "native": {
    "artifact": "pipeline_tool_core_native"
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [],
    "streaming": {
      "conduit": true
    },
    "steps": [
      {
        "name": "pipeline_tool_core",
        "required_state_inputs": []
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "raw_tool_calls",
      "messages",
      "raw_thinking",
      "tool_output_contracts",
      "tool_output_validation",
      "security.level_decision",
      "security.decision",
      "execution_contexts",
      "submitted_task_ids",
      "output_truncated",
      "llm_supports_vision"
    ]
  },
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "config_files": [
    {
      "id": "tool_output",
      "path": "config/system/tool_core_config.yaml",
      "label": "tool_core 工具输出截断配置"
    }
  ]
}