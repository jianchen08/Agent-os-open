{
  "id": "pipeline_tool_core",
  "name": "Tool Core",
  "version": "2.0.0",
  "plugin_type": "pipeline",
  "pipeline_role": "core",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "tool_core.execute",
  "mcp": {
    "transport": "stdio",
    "request_timeout_secs": 900
  },
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "streaming": {
      "conduit": true
    },
    "steps": [
      {
        "name": "pipeline_tool_core",
        "required_state_inputs": [
          "current_call"
        ]
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "current_call",
      "pre_decided_results",
      "messages",
      "raw_thinking",
      "tool_output_contracts",
      "tool_output_validation",
      "submitted_task_ids",
      "task_id",
      "workspace",
      "output_truncated",
      "llm_supports_vision",
      "session_id",
      "thread_id",
      "pipeline_id",
      "message_id"
    ]
  },
  "granted_capabilities": [
    "tool-executor",
    "event-bus"
  ],
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "config_files": [
    {
      "id": "tool_output",
      "path": "config/system/tool_core_config.yaml",
      "label": "tool_core 工具输出截断配置",
      "fields": [
        {
          "name": "tool_output.max_chars",
          "type": "number",
          "label": "单条工具结果最大字符数（超出触发头尾截断）"
        },
        {
          "name": "tool_output.head_chars",
          "type": "number",
          "label": "截断保留头部字符数"
        },
        {
          "name": "tool_output.tail_chars",
          "type": "number",
          "label": "截断保留尾部字符数"
        },
        {
          "name": "tool_output.invoke_timeout_s",
          "type": "number",
          "label": "tool-executor invoke 超时秒数（缺省 600）"
        }
      ]
    }
  ]
}
