{
  "id": "pipeline_llm_core",
  "name": "LLM Core",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "llm_core.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "granted_capabilities": [
    "tool-executor"
  ],
  "config_files": [
    {
      "id": "llm",
      "path": "config/models/llm.yaml",
      "label": "LLM 模型配置",
      "fields": [
        {
          "name": "defaults.chat",
          "type": "string",
          "label": "默认对话模型",
          "description": "模型 id（须已在 models 段注册）",
          "required": true
        },
        {
          "name": "defaults.tiers.large",
          "type": "string",
          "label": "大模型档位",
          "description": "复杂任务默认模型 id"
        },
        {
          "name": "defaults.tiers.medium",
          "type": "string",
          "label": "中模型档位",
          "description": "常规任务默认模型 id"
        },
        {
          "name": "defaults.tiers.small",
          "type": "string",
          "label": "小模型档位",
          "description": "轻量任务默认模型 id"
        },
        {
          "name": "defaults.embedding",
          "type": "string",
          "label": "默认向量模型",
          "description": "embedding 任务默认模型 id"
        },
        {
          "name": "concurrency.chat",
          "type": "number",
          "label": "对话并发",
          "min": 1,
          "max": 64,
          "default": 8,
          "description": "chat completions 并发上限"
        },
        {
          "name": "concurrency.embedding",
          "type": "number",
          "label": "向量并发",
          "min": 1,
          "max": 64,
          "default": 4,
          "description": "embedding 并发上限"
        }
      ]
    },
    {
      "id": "embedding",
      "path": "config/models/embedding.yaml",
      "label": "向量模型配置",
      "fields": [
        {
          "name": "embedding.enabled",
          "type": "toggle",
          "label": "启用向量模型",
          "default": false
        },
        {
          "name": "embedding.default_provider",
          "type": "string",
          "label": "默认提供商"
        },
        {
          "name": "embedding.default_model",
          "type": "string",
          "label": "默认模型"
        }
      ]
    }
  ],
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "ui_schema": {
    "widgets": [
      {
        "id": "thinking_strength",
        "type": "form",
        "space": "chat-input",
        "props": {
          "title": "思考强度",
          "icon": "brain",
          "fields": [
            {
              "name": "strength",
              "type": "select",
              "label": "思考强度",
              "default": "medium",
              "options": [
                {
                  "label": "关闭",
                  "value": "off",
                  "description": "普通模式，不启用思考"
                },
                {
                  "label": "低",
                  "value": "low",
                  "description": "轻量思考，响应更快"
                },
                {
                  "label": "中",
                  "value": "medium",
                  "description": "标准思考（默认）"
                },
                {
                  "label": "高",
                  "value": "high",
                  "description": "深度思考，耗时更长"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
