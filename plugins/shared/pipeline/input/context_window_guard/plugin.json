{
  "capabilities": {
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "route_signals": [],
    "tools": []
  },
  "config_files": [
    {
      "description": "配置真值内联于本 manifest 的 fields.default（单一真值裁定 2026-09-02：不引用磁盘文件，保存经 PUT 直接写回本 manifest）",
      "fields": [
        {
          "default": 0.6,
          "description": "上下文占用超过该比例触发压缩",
          "label": "压缩触发比例",
          "max": 1,
          "min": 0,
          "name": "compress_trigger_ratio",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.18,
          "description": "最近原文段保留预算（占窗口比例）",
          "label": "预算·最近原文",
          "max": 1,
          "min": 0,
          "name": "budgets.recent",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.08,
          "description": "L1 过程摘要块预算（占窗口比例）",
          "label": "预算·L1 过程块",
          "max": 1,
          "min": 0,
          "name": "budgets.l1",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": 0.05,
          "description": "L2 三元组块预算（占窗口比例）",
          "label": "预算·L2 过程块",
          "max": 1,
          "min": 0,
          "name": "budgets.l2",
          "step": 0.01,
          "type": "slider"
        },
        {
          "default": true,
          "label": "启用上下文压缩",
          "name": "compression.enabled",
          "type": "toggle"
        },
        {
          "default": "minimax-m3",
          "description": "压缩摘要生成所用模型 id（manifest 单一真值；留空则压缩停用）",
          "label": "压缩模型",
          "name": "compression.model",
          "type": "string"
        }
      ],
      "id": "context_window",
      "label": "上下文窗口配置"
    }
  ],
  "entry": "python server.py",
  "host_group": "light",
  "host_type": "sidecar",
  "id": "pipeline_context_window_guard",
  "invoke_entry": "context_window_guard.execute",
  "language": "python",
  "name": "Context Window Guard",
  "permissions": {},
  "plugin_type": "pipeline",
  "priority": 50,
  "version": "1.0.0"
}
