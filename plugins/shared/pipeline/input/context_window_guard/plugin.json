{
    "id": "pipeline_context_window_guard",
    "name": "Context Window Guard",
    "version": "1.0.0",
    "plugin_type": "pipeline",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python server.py",
    "invoke_entry": "context_window_guard.execute",
    "capabilities": {
        "tools": [],
        "resources": [],
        "route_signals": [],
        "lifecycle_hooks": [
            "on_load",
            "on_unload"
        ]
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50,
    "config_files": [
        {
            "id": "models",
            "path": "config/models/llm.yaml",
            "label": "LLM 模型配置（压缩用 chat completions）"
        }
    ]
}
