{
  "id": "pipeline_host_context",
  "requires_services": [
    "packaging"
  ],
  "name": "Host Context",
  "description": "通用宿主连接桥：外部宿主（Godot/VSCode 等）选中引用推送、转发前端、引用与用户消息合并；连接者身份由配置指定",
  "version": "2.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "host_context.execute",
  "lifecycle": {
    "idle_timeout_secs": 0
  },
  "config_files": [
    {
      "id": "settings",
      "label": "宿主连接配置",
      "fields": [
        {
          "name": "source",
          "label": "连接者标识（source）",
          "type": "string",
          "default": "godot",
          "description": "写入引用块 <reference source=...> 与前端 chip kind 的来源标识，如 godot / vscode / blender"
        },
        {
          "name": "display_name",
          "label": "连接者显示名",
          "type": "string",
          "default": "Godot",
          "description": "前端引用镜像行标签（「{显示名} 引用」）；留空回退 source"
        },
        {
          "name": "preview_endpoint",
          "label": "选中预览代理端点",
          "type": "string",
          "default": "http://127.0.0.1:9600",
          "description": "宿主自身 HTTP 服务的 /selection/preview 地址（经本插件代理）；留空关闭预览"
        }
      ]
    }
  ],
  "http_endpoints": [
    {
      "route_id": "selection_push",
      "method": "POST",
      "path": "/ext/pipeline_host_context/selection",
      "auth": "none",
      "handler_capability": "http.handle",
      "description": "宿主插件选中推送端点（selection/heartbeat/offline）"
    },
    {
      "route_id": "selection_snapshot",
      "method": "GET",
      "path": "/ext/pipeline_host_context/selection",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "当前选中快照（前端初始化）"
    },
    {
      "route_id": "selection_clear",
      "method": "DELETE",
      "path": "/ext/pipeline_host_context/selection",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "清除当前引用（点击清理；清空 items 并抑制同签名心跳，改选/重新点选恢复）"
    },
    {
      "route_id": "selection_subscribe",
      "method": "POST",
      "path": "/ext/pipeline_host_context/subscribe",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "前端订阅选中变化推送（body: {thread_id}）"
    },
    {
      "route_id": "selection_preview",
      "method": "GET",
      "path": "/ext/pipeline_host_context/preview",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "选中对象预览图（代理宿主 preview_endpoint /selection/preview）"
    }
  ],
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "host.injected_for",
      "message_id",
      "messages_tail:20"
    ]
  }
}
