{
  "id": "pipeline_isolation_guard",
  "requires_services": [
    "packaging"
  ],
  "name": "Isolation Guard",
  "version": "1.0.1",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "isolation_guard.execute",
  "persistent_fields": [
    "isolation.container_name"
  ],
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "agent_level",
      "core_type",
      "execution_context",
      "plugin_configs",
      "raw_tool_calls",
      "task.id",
      "workspace",
      "pre_decided_results"
    ]
  }
}
