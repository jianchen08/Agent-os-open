{
  "id": "pipeline_param_inject",
  "requires_services": [
    "packaging"
  ],
  "name": "Param Inject",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "param_inject.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "export_fields": [
    "raw_tool_calls"
  ],
  "state": {
    "volatile_keys": [
      "raw_tool_calls",
      "tool.params_injected"
    ],
    "reads": [
      "agent_config_id",
      "agent_level",
      "core_type",
      "isolation_level",
      "pipeline_id",
      "project_root",
      "raw_tool_calls",
      "session_id",
      "task.id",
      "user_id",
      "workspace",
      "ws_meta"
    ]
  },
  "permissions": {},
  "priority": 50
}
