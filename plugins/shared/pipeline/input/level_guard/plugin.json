{
  "id": "pipeline_level_guard",
  "name": "Level Guard",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "invoke_entry": "level_guard.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "export_fields": [
    "security.level_decision"
  ],
  "state": {
    "volatile_keys": [
      "security.level_decision"
    ],
    "reads": [
      "agent_level",
      "core_type",
      "raw_tool_calls",
      "tool_ids"
    ]
  },
  "permissions": {},
  "priority": 50,
  "host_group": "light"
}
