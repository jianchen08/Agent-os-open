{
  "id": "pipeline_security_check",
  "name": "Security Check",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "mcp": {
    "transport": "stdio",
    "request_timeout_secs": 90000
  },
  "invoke_entry": "security_check.execute",
  "activation": "eager",
  "capabilities": {
    "tools": [
      {
        "name": "http.handle",
        "description": "HTTP endpoint handler for /ext/pipeline_security_check/**（权限模式切换端点）"
      }
    ],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "export_fields": [
    "security.decision"
  ],
  "state": {
    "volatile_keys": [
      "security.decision"
    ],
    "reads": [
      "core_type",
      "execution_contexts",
      "messages_tail:50",
      "pipeline_id",
      "raw_tool_calls",
      "session_id",
      "thread_id"
    ]
  },
  "permissions": {},
  "priority": 50,
  "config_files": [
    {
      "id": "security_rules",
      "path": "config/plugins/security_check/security_rules.yaml",
      "label": "安全规则"
    },
    {
      "id": "builtin_tools_config",
      "path": "config/tools/builtin_tools_config.yaml",
      "label": "内置工具 dangerous_operations 声明（_is_dangerous_tool 轨道 2 数据源）"
    }
  ],
  "http_endpoints": [
    {
      "route_id": "permission_mode_switch",
      "method": "POST",
      "path": "/ext/pipeline_security_check/permission_mode",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "切换会话权限模式（键 session_id；auto/bypass 高风险模式经 human-interaction 审批窗确认）"
    },
    {
      "route_id": "permission_mode_get",
      "method": "GET",
      "path": "/ext/pipeline_security_check/permission_mode",
      "auth": "user",
      "handler_capability": "http.handle",
      "description": "查询会话当前权限模式（键 session_id）"
    }
  ],
  "ui_schema": {
    "widgets": [
      {
        "id": "permission_mode_selector",
        "type": "form",
        "space": "chat-input",
        "title": "权限模式",
        "props": {
          "title": "权限模式",
          "submitLabel": "切换模式",
          "fields": [
            {
              "name": "mode",
              "type": "select",
              "label": "权限模式",
              "default": "default",
              "options": [
                {
                  "label": "默认（命中规则才确认）",
                  "value": "default",
                  "description": "显式选择后命中安全规则关键词（rm -rf、curl、pip install 等）的操作逐次弹窗确认（隔离/worktree 会话同样生效，覆盖免审批默认），未命中的直接执行"
                },
                {
                  "label": "接受编辑（文件自动）",
                  "value": "accept_edits",
                  "description": "文件读写工具一律自动放行；命令类等其它工具仅在命中安全规则时弹窗确认（隔离/worktree 会话同样生效）"
                },
                {
                  "label": "自动（block 不打扰）",
                  "value": "auto",
                  "description": "命中 block 级规则自动拒绝、不再询问；needs_approval 级才弹窗；未命中规则的操作直接执行（隔离/worktree 会话同样生效）"
                },
                {
                  "label": "旁路（跳过审批）",
                  "value": "bypass",
                  "description": "不做规则匹配、不弹审批，危险命令可能直接执行；仅保留路径遍历、敏感目录、nul 重定向三条内置底线"
                }
              ]
            }
          ],
          "endpoint": "/ext/pipeline_security_check/permission_mode",
          "readbackUri": "/ext/pipeline_security_check/permission_mode",
          "description": "切换当前会话的权限模式（对该会话后续所有管道生效，管道/子代理轮换不影响）。隔离/worktree 会话未显式选择时默认完全免审批（选择器显示「免审批」）；显式选择任一档后以所选档为准，黑名单规则命中（rm -rf 等）照常按档处置。非隔离会话按所选档/默认档走。auto/bypass 属高风险档，切换需在审批窗二次确认"
        }
      }
    ]
  }
}
