{
    "id": "pipeline_security_check",
    "name": "Security Check",
    "version": "1.0.0",
    "plugin_type": "pipeline",
    "language": "python",
    "host_type": "sidecar",
    "entry": "python server.py",
    "invoke_entry": "security_check.execute",
    "capabilities": {
        "tools": [],
        "resources": [],
        "route_signals": [],
        "lifecycle_hooks": [
            "on_load",
            "on_unload"
        ]
    },
    "dependencies": [],
    "permissions": {},
    "error_policy": "skip",
    "priority": 50,
    "config_files": [
        {
            "id": "security_rules",
            "path": "config/isolation/security_rules.yaml",
            "label": "安全规则"
        },
        {
            "id": "builtin_tools_config",
            "path": "config/tools/builtin_tools_config.yaml",
            "label": "内置工具 dangerous_operations 声明（_is_dangerous_tool 轨道 2 数据源）"
        }
    ]
}
