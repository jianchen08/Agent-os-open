{
  "id": "pipeline_prompt_build",
  "name": "Prompt Build",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "prompt_build.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "context.agent_name",
      "context.constraints_text",
      "context.dynamic_vars",
      "context.session_id",
      "context.static_vars",
      "context.system_prompt",
      "context_window",
      "llm_model",
      "prompt.tool_descriptions",
      "user_id"
    ]
  }
}
