{
  "id": "pipeline_tool_cache",
  "requires_services": [
    "packaging"
  ],
  "name": "Tool Cache",
  "version": "1.0.0",
  "plugin_type": "pipeline",
  "language": "python",
  "host_type": "sidecar",
  "host_group": "light",
  "entry": "python server.py",
  "invoke_entry": "tool_cache.execute",
  "capabilities": {
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "export_fields": [
    "tool_results"
  ],
  "state": {
    "volatile_keys": [
      "cache_hit",
      "raw_tool_calls",
      "tool_results"
    ],
    "reads": [
      "raw_tool_calls",
      "pipeline_id",
      "user_id",
      "session_id"
    ]
  },
  "permissions": {},
  "priority": 50,
  "config_files": [
    {
      "id": "tool_cache",
      "label": "工具缓存配置",
      "fields": [
        {
          "name": "per_pipeline_max",
          "label": "每管道全文留存条数",
          "type": "number",
          "default": 1
        }
      ]
    }
  ]
}
