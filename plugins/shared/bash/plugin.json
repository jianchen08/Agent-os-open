{
  "id": "bash_tool",
  "requires_services": [
    "packaging"
  ],
  "name": "Bash Tool",
  "description": "Shell 命令执行四工具面（bash/log/input/kill）：进程状态由 sidecar 内单例 ProcessManager 跨调用维护，handle（不透明串，内含 pid+owner+校验和）取代裸 pid 定位，越权校验两段式（handle 内 owner vs 调用方注入 owner、vs 活进程/磁盘日志头 owner）。",
  "version": "1.2.0",
  "plugin_type": "tool",
  "language": "python",
  "host_type": "sidecar",
  "entry": "python server.py",
  "capabilities": {
    "metrics_class": "tool",
    "tools": [
      {
        "name": "bash",
        "isolation_capable": true,
        "timeout_ms": 660000,
        "description": "执行 Shell 命令。前台阻塞到完成或等待上限；超时/后台返回 running+handle，进程不死，凭 handle 用 log 读输出、input 发交互输入、kill 终止。不要手动 nohup/setsid/disown/行尾&（本工具自带 background=true，手动后台化会使进程脱离管理）。危险命令（rm -rf /、format、dd if= 等）会被拦截。",
        "input_schema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "要执行的 Shell 命令"
            },
            "timeout": {
              "type": "integer",
              "description": "前台等待上限秒数（默认 30，最大 600）。超时不杀进程：返回 running+handle 并附带全部已捕获输出，进程继续运行，可凭 handle 用 log/input/kill 管理。",
              "default": 30,
              "maximum": 600
            },
            "background": {
              "type": "boolean",
              "description": "true=立即返回 handle 不等待（长任务用）；false=前台阻塞到完成或等待上限（默认 false）。",
              "default": false
            },
            "working_dir": {
              "type": "string",
              "description": "命令执行的工作目录，默认为当前目录"
            }
          },
          "required": [
            "command"
          ]
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "running",
                "terminated"
              ]
            },
            "handle": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "exit_code": {
              "type": "integer"
            },
            "elapsed": {
              "type": "number"
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "message": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "handle"
          ]
        },
        "category": "system",
        "render": {
          "card": "terminal"
        }
      },
      {
        "name": "log",
        "description": "凭 handle 读 bash 进程日志。block=false 立即返回当前状态与完整输出（进程已结束也能读）；block=true 等到完成或等待上限。",
        "input_schema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "进程句柄（bash 工具的返回值）"
            },
            "block": {
              "type": "boolean",
              "description": "true=等到完成或等待上限（默认 30 秒）后返回；false=立即返回当前状态与完整日志（默认 false）。进程已结束后任何时候都能读（含 sidecar 重启后跨会话定位）。",
              "default": false
            }
          },
          "required": [
            "handle"
          ]
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "running",
                "terminated",
                "error"
              ]
            },
            "handle": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "exit_code": {
              "type": "integer"
            },
            "elapsed": {
              "type": "number"
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "terminated_by": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "handle"
          ]
        },
        "category": "system",
        "render": {
          "card": "terminal",
          "bindings": {
            "command": "result.command"
          }
        }
      },
      {
        "name": "input",
        "description": "凭 handle 向等待输入的 bash 进程发送文本（交互式命令的 yes/no、密码、菜单选项等）。",
        "input_schema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "进程句柄（bash 工具的返回值）"
            },
            "text": {
              "type": "string",
              "description": "要发送的输入文本，如 yes/no、密码、菜单选项编号。"
            }
          },
          "required": [
            "handle",
            "text"
          ]
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "running"
              ]
            },
            "handle": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "handle"
          ]
        },
        "category": "system",
        "render": {
          "card": "generic"
        }
      },
      {
        "name": "kill",
        "description": "凭 handle 终止 bash 进程（整树杀，日志保留——kill 后 log 仍可读完整输出）。",
        "input_schema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "进程句柄（bash 工具的返回值）"
            }
          },
          "required": [
            "handle"
          ]
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "terminated"
              ]
            },
            "handle": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "handle"
          ]
        },
        "category": "system",
        "render": {
          "card": "generic"
        }
      }
    ],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ]
  },
  "permissions": {
    "filesystem": {
      "read_paths": [
        "*"
      ],
      "write_paths": [
        "*"
      ]
    },
    "network": {
      "allowed_hosts": [
        "*"
      ]
    },
    "env_vars": [
      "*"
    ],
    "system_calls": [
      "bash",
      "sh",
      "cmd",
      "wsl",
      "docker",
      "powershell",
      "python",
      "*"
    ]
  },
  "priority": 20
}
