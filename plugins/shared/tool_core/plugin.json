{
  "id": "pipeline_tool_core",
  "name": "Tool Core",
  "version": "3.1.1",
  "plugin_type": "pipeline",
  "language": "rust",
  "host_type": "in_process",
  "host_group": "light",
  "entry": "pipeline_tool_core_native.dll",
  "invoke_entry": "plugin_execute",
  "native": {
    "artifact": "pipeline_tool_core_native",
    "pre_dispatch": {
      "capability": "tool-executor",
      "method": "invoke"
    }
  },
  "capabilities": {
    "metrics_class": "tool",
    "tools": [],
    "route_signals": [],
    "lifecycle_hooks": [
      "on_load",
      "on_unload"
    ],
    "streaming": {
      "conduit": true
    },
    "steps": [
      {
        "name": "pipeline_tool_core",
        "required_state_inputs": [
          "current_call"
        ]
      }
    ]
  },
  "permissions": {},
  "priority": 50,
  "state": {
    "reads": [
      "current_call",
      "pre_decided_results",
      "messages",
      "raw_thinking",
      "tool_output_contracts",
      "tool_output_validation",
      "submitted_task_ids",
      "task_id",
      "workspace",
      "output_truncated",
      "llm_supports_vision",
      "session_id",
      "thread_id",
      "pipeline_id",
      "message_id",
      "_message_seq"
    ]
  },
  "config_files": [
    {
      "id": "tool_output",
      "path": "config/system/tool_core_config.yaml",
      "label": "tool_core 工具输出截断配置",
      "fields": [
        {
          "name": "tool_output.max_chars",
          "type": "number",
          "label": "单条工具结果最大字符数（超出触发头尾截断）"
        },
        {
          "name": "tool_output.head_chars",
          "type": "number",
          "label": "截断保留头部字符数"
        },
        {
          "name": "tool_output.tail_chars",
          "type": "number",
          "label": "截断保留尾部字符数"
        }
      ]
    }
  ]
}
