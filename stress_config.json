{
  "app": {
    "name": "stress-test-app",
    "version": "1.0.0",
    "description": "压力测试项目配置"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "database": {
    "host": "localhost",
    "port": 3306,
    "name": "stress_test_db",
    "username": "root",
    "password": "",
    "max_connections": 100,
    "connection_timeout": 30
  },
  "log": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "file_path": "logs/app.log",
    "max_file_size_mb": 100,
    "max_backup_files": 5
  },
  "stress_test": {
    "concurrent_users": 1000,
    "duration_seconds": 60,
    "ramp_up_seconds": 10,
    "target_rps": 500
  }
}
