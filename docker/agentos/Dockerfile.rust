# syntax=docker/dockerfile:1
# =============================================================================
# AgentOS — Rust 工具链增量安装层
# 基于 agentos:latest，增量添加 Rust ≥1.85 + rustfmt + clippy + pkg-config
# 构建后覆盖 agentos:latest tag，使容器执行环境直接可用 cargo 命令
# =============================================================================

FROM agentos:latest

LABEL maintainer="Agent OS Team" \
      description="agentos:latest + Rust 1.85 工具链增量" \
      increment="rust-toolchain"

# ── 补齐 pkg-config（agentos:latest 缺失）+ protobuf-compiler ──
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# ── 安装 Rust 1.85.0（jsonschema-rs MSRV 要求 ≥1.85）──
# rustup 官方安装方式，精确锁定版本
ENV RUST_VERSION=1.85.0
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:${PATH}

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && rustup component add rustfmt clippy \
    && rustc --version \
    && cargo --version \
    && rustup component list --installed

# 验证完成后清理 rustup 临时下载
RUN rm -rf /tmp/rustup* /root/.cargo/registry/cache/*

WORKDIR /workspace
CMD ["python"]
