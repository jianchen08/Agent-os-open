# =============================================================================
# AgentOS — sccache 增量层
# 基于现有 agentos:latest（已含 Rust 工具链），增量添加 sccache 编译缓存。
# sccache：内容寻址的编译缓存。跨容器实例、跨 git worktree 复用产物；
# 配合 docker_provider 挂载的 agentos-cargo-cache named volume，容器销毁/重建
# 不丢缓存。
#
# 二进制来源：Mozilla sccache v0.17.0 官方 GitHub Release 的
# x86_64-unknown-linux-musl 预编译版（musl 静态链接，不依赖 glibc 版本）。
# 本机到 github.com 直连不稳，故走 ghfast.top 反代（经实测稳定可用）。
# 网络恢复后可改 ARG SCCACHE_MIRROR="https://github.com"。
# =============================================================================

FROM agentos:latest

LABEL maintainer="Agent OS Team" \
      description="agentos:latest + sccache 编译缓存层" \
      increment="sccache"

ARG SCCACHE_VERSION=0.17.0
# 下载镜像：ghfast.top 是 GitHub release-assets 反代，直连不稳时使用。
ARG SCCACHE_MIRROR="https://ghfast.top/https://github.com"

RUN set -eux; \
    arch=x86_64-unknown-linux-musl; \
    url="${SCCACHE_MIRROR}/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-${arch}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 3 -o /tmp/sccache.tar.gz "$url"; \
    tar -xzf /tmp/sccache.tar.gz -C /tmp; \
    mv "/tmp/sccache-v${SCCACHE_VERSION}-${arch}/sccache" /usr/local/bin/sccache; \
    chmod +x /usr/local/bin/sccache; \
    rm -rf /tmp/sccache*; \
    sccache --version

# RUSTC_WRAPPER 让 cargo/rustc 调用走 sccache 包装。
# SCCACHE_DIR 指向 volume 挂载点，缓存落 named volume 而非容器可写层。
# CARGO_INCREMENTAL=0：incremental 编译产物含时间戳/路径相关状态，
# sccache 无法稳定哈希 → 判为 non-cacheable。必须关闭才能让 Rust crate 命中。
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/cargo-cache/sccache
ENV CARGO_INCREMENTAL=0

WORKDIR /workspace
CMD ["python"]
